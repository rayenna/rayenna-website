---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import SolarNewsTicker from '../components/SolarNewsTicker.astro';
import { OG } from '../i18n/og-images';
import {
  getNavLinks,
  useTranslations,
  getAlternateUrls,
  localizedPath,
  getLangFromPath,
  stripLocale,
  type Lang,
} from '../i18n/ui';

const {
  title = 'Rayenna Energy — Solar Solutions in Kochi',
  description = 'Rayenna Energy is a leading provider of innovative solar energy solutions in Kochi, Kerala. Switch to solar and save on energy costs while reducing your carbon footprint.',
  ogImage = OG.default,
  lang: langProp,
  canonical: canonicalProp,
  noindex = false,
  schema = [],
} = Astro.props;

const lang: Lang = langProp ?? getLangFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const navLinks = getNavLinks(lang);
const alternates = getAlternateUrls(Astro.url.pathname);

const siteUrl = 'https://rayennaenergy.com';
const siteName = 'Rayenna Energy';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(canonicalProp ?? Astro.url.pathname, siteUrl);
const isBlogPost =
  (Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog/') ||
  (Astro.url.pathname.startsWith('/ml/blog/') && Astro.url.pathname !== '/ml/blog/');
const ogType = isBlogPost ? 'article' : 'website';
const ogLocale = lang === 'ml' ? 'ml_IN' : 'en_IN';
const pageLanguage = lang === 'ml' ? 'ml-IN' : 'en-IN';
const neutralPath = stripLocale(canonicalURL.pathname);
const extraSchemaNodes = (Array.isArray(schema) ? schema : [schema]).filter(Boolean);
const faviconSvgHref = `${base}/favicon.svg`;
const favicon192Href = `${base}/favicon-192.png`;
const favicon512Href = `${base}/favicon-512.png`;
const appleTouchIconHref = `${base}/apple-touch-icon.png`;
const manifestHref = `${base}/site.webmanifest`;
const robotsContent = `${noindex ? 'noindex' : 'index'},follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1`;

function navIsActive(href: string): boolean {
  const norm = (p: string) => p.replace(/\/$/, '') || '/';
  const cur = norm(Astro.url.pathname);
  const target = norm(href);
  if (target === '/' || target === '/ml') return cur === '/' || cur === '/ml';
  return cur === target || cur.startsWith(`${target}/`);
}

function cleanSchemaTitle(rawTitle: string): string {
  return rawTitle
    .replace(/\s+\|\s+Rayenna Energy$/u, '')
    .replace(/\s+—\s+Rayenna Energy Blog$/u, '')
    .replace(/\s+\|\s+റയെന്ന എനർജി$/u, '')
    .replace(/\s+—\s+റയെന്ന എനർജി ബ്ലോഗ്$/u, '')
    .trim();
}

const schemaPageName = cleanSchemaTitle(title);
const breadcrumbs = [{ name: t.nav.home, item: new URL(localizedPath('/', lang), siteUrl).href }];

if (isBlogPost) {
  breadcrumbs.push({
    name: t.nav.blog,
    item: new URL(localizedPath('/blog', lang), siteUrl).href,
  });
}

if (neutralPath !== '/') {
  breadcrumbs.push({ name: schemaPageName, item: canonicalURL.href });
}

const localBusinessLD = {
  "@type": ["LocalBusiness", "ElectricalContractor"],
  "name": "Rayenna Energy Private Limited",
  "logo": `${siteUrl}/favicon-512.png`,
  "image": "https://rayennaenergy.com/media/solar-panel-installation.jpg",
  "@id": "https://rayennaenergy.com/#business",
  "url": siteUrl,
  "telephone": "+917907369304",
  "email": "sales@rayenna.energy",
  "description": "MNRE-approved solar panel installer in Kochi, Kerala. Domestic & commercial solar systems, PM Surya Ghar subsidy up to ₹78,000, free site survey.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "No. 3329/52, Ray Bhavan, NH Bypass, Thykoodam",
    "addressLocality": "Vyttila",
    "addressRegion": "Kerala",
    "postalCode": "682019",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 9.9582784,
    "longitude": 76.3156774
  },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:30", "closes": "17:30" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:30", "closes": "13:00" }
  ],
  "sameAs": [
    "https://www.facebook.com/profile.php?id=61565224468823",
    "https://www.instagram.com/rayenna_energy/",
    "https://www.linkedin.com/company/rayenna-energy/"
  ],
  "priceRange": "₹₹",
  "areaServed": [
    { "@type": "City", "name": "Kochi" },
    { "@type": "City", "name": "Ernakulam" },
    { "@type": "City", "name": "Thrissur" },
    { "@type": "City", "name": "Thiruvananthapuram" },
    { "@type": "City", "name": "Kollam" },
    { "@type": "AdministrativeArea", "name": "Kerala" }
  ]
};
const websiteLD = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": siteName,
  "inLanguage": ["en-IN", "ml-IN"],
  "publisher": {
    "@id": "https://rayennaenergy.com/#business",
  },
};
const breadcrumbLD = neutralPath === '/'
  ? null
  : {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL.href}#breadcrumb`,
      "itemListElement": breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": crumb.name,
        "item": crumb.item,
      })),
    };
const webPageLD = {
  "@type": "WebPage",
  "@id": `${canonicalURL.href}#webpage`,
  "url": canonicalURL.href,
  "name": schemaPageName,
  "description": description,
  "inLanguage": pageLanguage,
  "isPartOf": {
    "@id": `${siteUrl}/#website`,
  },
  "about": {
    "@id": "https://rayennaenergy.com/#business",
  },
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": ogImage,
  },
  ...(breadcrumbLD
    ? {
        "breadcrumb": {
          "@id": `${canonicalURL.href}#breadcrumb`,
        },
      }
    : {}),
};
const blogPostingLD = !isBlogPost
  ? null
  : {
      "@type": "BlogPosting",
      "@id": `${canonicalURL.href}#article`,
      "headline": schemaPageName,
      "description": description,
      "url": canonicalURL.href,
      "mainEntityOfPage": {
        "@id": `${canonicalURL.href}#webpage`,
      },
      "image": [ogImage],
      "inLanguage": pageLanguage,
      "author": {
        "@type": "Organization",
        "name": lang === 'ml' ? 'റയെന്ന എനർജി ടീം' : 'Rayenna Energy Team',
        "url": siteUrl,
      },
      "publisher": {
        "@id": "https://rayennaenergy.com/#business",
      },
      "isPartOf": {
        "@id": `${siteUrl}/#website`,
      },
      "articleSection": lang === 'ml' ? 'സോളാർ ബ്ലോഗ്' : 'Solar Blog',
    };
const structuredDataLD = {
  "@context": "https://schema.org",
  "@graph": [websiteLD, webPageLD, breadcrumbLD, blogPostingLD, localBusinessLD, ...extraSchemaNodes].filter(Boolean),
};
const homeHref = localizedPath('/', lang);
const privacyHref = lang === 'ml' ? '/ml/privacy/' : '/privacy/';
const MOBILE_BAR_HIDDEN = new Set(['/contact', '/solar-calculator']);
const showMobileBar = !MOBILE_BAR_HIDDEN.has(normalizePath(stripLocale(canonicalURL.pathname)));

function normalizePath(path: string): string {
  const p = path.replace(/\/$/, '') || '/';
  return p;
}
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="robots" content={robotsContent} />
  <meta name="theme-color" content="#1e3a5f" />
  <meta name="application-name" content={siteName} />
  <meta name="apple-mobile-web-app-title" content={siteName} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL.href} />
  <link rel="alternate" hreflang="en" href={alternates.en} />
  <link rel="alternate" hreflang="ml" href={alternates.ml} />
  <link rel="alternate" hreflang="x-default" href={alternates.en} />
  <link rel="icon" href={faviconSvgHref} type="image/svg+xml" sizes="any" />
  <link rel="icon" href={favicon192Href} type="image/png" sizes="192x192" />
  <link rel="icon" href={favicon512Href} type="image/png" sizes="512x512" />
  <link rel="apple-touch-icon" href={appleTouchIconHref} sizes="180x180" />
  <link rel="manifest" href={manifestHref} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:site_name" content="Rayenna Energy" />
  <meta property="og:locale" content={ogLocale} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Shared JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredDataLD)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />
  {lang === 'ml' && (
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Malayalam:wght@400;500;600;700&display=swap" rel="stylesheet" />
  )}
</head>
<body class:list={[lang === 'ml' ? 'lang-ml' : 'lang-en', showMobileBar && 'has-mobile-action-bar']}>

  <!-- ===== NAVBAR ===== -->
  <header class={`navbar${navIsActive(homeHref) ? ' navbar--hero' : ''}`} id="navbar">
    <div class="navbar__inner">
      <a href={homeHref} class="navbar__logo" aria-label="Rayenna Energy Home">
        <img src={`${base}/media/rayenna-logo-nav.png`} alt={t.images.logoAlt} class="logo-img" />
      </a>

      <nav class="navbar__nav" id="main-nav" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`nav-link ${link.special ? 'nav-calculator-link' : ''} ${navIsActive(link.href) ? 'active' : ''}`}
          >{link.special ? '☀️ ' : ''}{link.label}</a>
        ))}
      </nav>

      <div class="lang-switcher" role="group" aria-label={t.langSwitcherAria}>
        <a href={alternates.en} class:list={['lang-switcher__btn', { 'lang-switcher__btn--active': lang === 'en' }]}>EN</a>
        <a href={alternates.ml} class:list={['lang-switcher__btn', { 'lang-switcher__btn--active': lang === 'ml' }]}>ML</a>
      </div>

      <button class="navbar__burger" id="burger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

    <!-- Mobile menu -->
    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <div class="mobile-lang-switcher" role="group" aria-label={t.langSwitcherAria}>
        <a href={alternates.en} class:list={['mobile-lang-btn', { 'mobile-lang-btn--active': lang === 'en' }]}>English</a>
        <a href={alternates.ml} class:list={['mobile-lang-btn', { 'mobile-lang-btn--active': lang === 'ml' }]}>മലയാളം</a>
      </div>
      {navLinks.map(link => (
        link.special
          ? <a href={link.href} class="mobile-link mobile-nav-calculator">☀️ {t.nav.calcMobile}</a>
          : <a href={link.href} class="mobile-link">{link.label}</a>
      ))}
    </div>
    <button type="button" class="nav-backdrop" id="nav-backdrop" aria-hidden="true" tabindex="-1"></button>
  </header>

  <!-- ===== SOLAR NEWS TICKER ===== -->
  <SolarNewsTicker />

  <!-- ===== MAIN ===== -->
  <main>
    <slot />
  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="container footer__grid">

      <!-- Col 1: Logo -->
      <div class="footer__col footer__col--logo">
        <img src={`${base}/media/Logo-white.webp`} alt={t.images.logoAlt} class="footer-logo-img" />
      </div>

      <!-- Col 2: MNRE Badge -->
      <div class="footer__col footer__col--badge">
        <img src={`${base}/media/Artboard-2-copymnre.webp`} alt={t.images.mnreBadgeAlt} class="footer-badge-img" />
      </div>

      <!-- Col 3: About Us + Area Links -->
      <div class="footer__col footer__col--about">
        <h4 class="footer__heading">{t.footer.aboutHeading}</h4>
        <p class="footer__text">{t.footer.aboutText}</p>
        <div class="footer__area-links">
          <h4 class="footer__heading" style="margin-top:20px">{t.footer.areasHeading}</h4>
          <div class="footer__area-grid">
            <a href={localizedPath('/solar-panels-kochi', lang)} class="footer__area-link">{t.footer.kochi}</a>
            <a href={localizedPath('/solar-panels-thrissur', lang)} class="footer__area-link">{t.footer.thrissur}</a>
            <a href={localizedPath('/solar-panels-trivandrum', lang)} class="footer__area-link">{t.footer.trivandrum}</a>
          </div>
        </div>
      </div>

      <!-- Col 4: Contact -->
      <div class="footer__col footer__col--contact">
        <h4 class="footer__heading">{t.footer.contactHeading}</h4>
        <p class="footer__text">No. 3329/52, Ray Bhavan, Nh Bypass,<br />Thykoodam, Vyttila,<br />Ernakulam, Kerala, India, 682019</p>
        <p class="footer__text" style="margin-top:8px;">
          <a href="tel:+917907369304" class="footer__link">+91 7907 369 304</a><br />
          <a href="mailto:sales@rayenna.energy" class="footer__link">sales@rayenna.energy</a><br />
          <a href="https://rayennaenergy.com" class="footer__link">rayennaenergy.com</a>
        </p>
        <div class="footer__social">
          <a href="https://www.facebook.com/profile.php?id=61565224468823" target="_blank" rel="noopener" aria-label="Facebook" class="social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://www.instagram.com/rayenna_energy/" target="_blank" rel="noopener" aria-label="Instagram" class="social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/rayenna-energy/" target="_blank" rel="noopener" aria-label="LinkedIn" class="social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
      </div>

    </div>

    <div class="footer__bottom">
      <div class="container footer__bottom-inner">
        <p>{t.footer.copyright}</p>
        <div class="footer__legal">
          <a href={privacyHref} class="footer__legal-link">{t.footer.privacy}</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Ray AI Chat Widget -->
  <ChatWidget lang={lang} />

  {showMobileBar && <MobileActionBar lang={lang} />}

  <!-- WhatsApp Floating Button -->
  <a
    href="https://api.whatsapp.com/send?phone=917907369304&text=Hi%20Rayenna%20Energy!%20I%27m%20interested%20in%20solar%20installation."
    target="_blank"
    rel="noopener noreferrer"
    class="wa-float"
    aria-label="Chat with us on WhatsApp"
  >
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"
         fill="white" width="26" height="26" aria-hidden="true">
      <path d="M16 .5C7.439.5.5 7.439.5 16c0 2.75.703 5.389 2.043 7.719L.5 31.5l8-2
               c2.219 1.188 4.719 1.813 7.5 1.813C24.561 31.313 31.5 24.374 31.5
               15.813 31.5 7.439 24.561.5 16 .5zm0 28.625c-2.5 0-4.938-.656-7.063-1.906
               l-.5-.313-5.25 1.313 1.375-5.063-.344-.531C2.844 20.5 2.125 18.281
               2.125 16 2.125 8.344 8.344 2.125 16 2.125S29.875 8.344 29.875 16
               23.656 29.125 16 29.125zm7.813-9.969c-.438-.219-2.563-1.25-2.969-1.406
               s-.688-.219-.969.219-1.125 1.406-1.375 1.688-.5.313-.938.094
               c-.438-.219-1.844-.688-3.5-2.188-1.313-1.156-2.188-2.594-2.438-3.031
               s-.031-.688.188-.906c.188-.188.438-.5.656-.75s.281-.438.438-.719
               .156-.531.063-.75-1-2.375-1.375-3.25c-.375-.875-.75-.75-1-.75
               s-.531 0-.813 0-1.063.281-1.625.875S7.5 10.719 7.5 12.5c0 1.781
               1.313 3.531 1.5 3.781s2.594 3.969 6.281 5.563c.875.375 1.563.594
               2.094.781.875.281 1.688.25 2.313.156.719-.094 2.219-.906 2.531-1.781
               s.313-1.625.219-1.781-.344-.281-.781-.5z"/>
    </svg>
    <span class="wa-tooltip" aria-hidden="true">{t.waTooltip}</span>
  </a>

  <style>
    /* Mobile action bar — reserve space & avoid duplicate WhatsApp on small screens */
    @media (max-width: 767px) {
      body.has-mobile-action-bar {
        --mobile-action-bar-h: calc(52px + env(safe-area-inset-bottom, 0px));
      }

      body.has-mobile-action-bar main {
        padding-bottom: var(--mobile-action-bar-h);
      }

      body.has-mobile-action-bar .wa-float {
        display: none;
      }

      body.has-mobile-action-bar.mobile-bar-active #ray-chat-btn {
        bottom: calc(var(--mobile-action-bar-h) + 12px);
      }
    }

    /* ── MOBILE FIRST (base styles) ── */
    .wa-float {
      position: fixed;
      bottom: 24px;
      right: 20px;
      width: 52px;
      height: 52px;
      min-width: 48px;
      min-height: 48px;
      background-color: #25D366;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 3px 10px rgba(37, 211, 102, 0.45);
      z-index: 9999;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
      animation: wa-pulse-mobile 2.5s infinite;
      transition: transform 0.2s ease;
    }

    .wa-tooltip {
      display: none;
    }

    @keyframes wa-pulse-mobile {
      0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.45); }
      70%  { box-shadow: 0 0 0 10px rgba(37, 211, 102, 0); }
      100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
    }

    /* ── TABLET & DESKTOP (min-width: 768px) ── */
    @media (min-width: 768px) {
      .wa-float {
        bottom: 30px;
        right: 30px;
        width: 58px;
        height: 58px;
        animation: wa-pulse-desktop 2s infinite;
      }

      .wa-float:hover {
        transform: scale(1.1);
        animation: none;
        box-shadow: 0 6px 20px rgba(37, 211, 102, 0.6);
      }

      .wa-tooltip {
        display: block;
        position: absolute;
        right: 68px;
        background: #1a1a1a;
        color: #fff;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-family: sans-serif;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
      }

      .wa-tooltip::after {
        content: '';
        position: absolute;
        left: 100%;
        top: 50%;
        transform: translateY(-50%);
        border: 6px solid transparent;
        border-left-color: #1a1a1a;
      }

      .wa-float:hover .wa-tooltip {
        opacity: 1;
      }

      @keyframes wa-pulse-desktop {
        0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
        70%  { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); }
        100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
      }
    }
  </style>
  <!-- End WhatsApp Floating Button -->

</body>
</html>

<style>
/* ===== NAVBAR ===== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: var(--color-white);
  box-shadow: var(--shadow-sm);
  transition: background 0.4s ease, box-shadow 0.4s ease;
}
/* Homepage only: start transparent */
.navbar--hero {
  background: transparent;
  box-shadow: none;
}
.navbar--hero.navbar--scrolled,
.navbar--scrolled {
  background: rgba(255,255,255,0.97);
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.navbar__inner {
  display: flex;
  align-items: center;
  gap: 32px;
  height: 72px;
  width: 100%;
  padding: 0 32px 0 24px;
}
.navbar__logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 4px 0;
}
.logo-img {
  height: 34px;
  width: auto;
  display: block;
}
.navbar__nav {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: auto;
}
.lang-switcher {
  display: none;
  align-items: center;
  gap: 2px;
  padding: 3px;
  border-radius: 999px;
  background: rgba(39, 50, 79, 0.08);
  flex-shrink: 0;
}
.lang-switcher__btn {
  font-family: var(--font-heading);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  padding: 5px 10px;
  border-radius: 999px;
  color: var(--color-navy);
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
}
