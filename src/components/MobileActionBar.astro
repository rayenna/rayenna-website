---
import { localizedPath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const bar = t.mobileBar;
const calcHref = localizedPath('/solar-calculator', lang);
const waText =
  lang === 'ml'
    ? 'ഹായ് റയെന്ന എനർജി! സോളാർ ഇൻസ്റ്റാളേഷനിൽ താൽപ്പര്യമുണ്ട്.'
    : "Hi Rayenna Energy! I'm interested in solar installation.";
const waHref = `https://api.whatsapp.com/send?phone=917907369304&text=${encodeURIComponent(waText)}`;
---

<nav class="mobile-action-bar" id="mobile-action-bar" aria-label={bar.ariaLabel} data-analytics-location="mobile_bar" hidden>
  <a href="tel:+917907369304" class="mobile-action-bar__btn mobile-action-bar__btn--call">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.69 3.18 2 2 0 0 1 3.68 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.69A16 16 0 0 0 16 16.61l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span>{bar.call}</span>
  </a>
  <a href={waHref} class="mobile-action-bar__btn mobile-action-bar__btn--wa" target="_blank" rel="noopener noreferrer" aria-label={bar.whatsappAria}>
    <svg width="20" height="20" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
      <path d="M16 .5C7.439.5.5 7.439.5 16c0 2.75.703 5.389 2.043 7.719L.5 31.5l8-2c2.219 1.188 4.719 1.813 7.5 1.813C24.561 31.313 31.5 24.374 31.5 15.813 31.5 7.439 24.561.5 16 .5zm0 28.625c-2.5 0-4.938-.656-7.063-1.906l-.5-.313-5.25 1.313 1.375-5.063-.344-.531C2.844 20.5 2.125 18.281 2.125 16 2.125 8.344 8.344 2.125 16 2.125S29.875 8.344 29.875 16 23.656 29.125 16 29.125zm7.813-9.969c-.438-.219-2.563-1.25-2.969-1.406s-.688-.219-.969.219-1.125 1.406-1.375 1.688-.5.313-.938.094c-.438-.219-1.844-.688-3.5-2.188-1.313-1.156-2.188-2.594-2.438-3.031s-.031-.688.188-.906c.188-.188.438-.5.656-.75s.281-.438.438-.719.156-.531.063-.75-1-2.375-1.375-3.25c-.375-.875-.75-.75-1-.75s-.531 0-.813 0-1.063.281-1.625.875S7.5 10.719 7.5 12.5c0 1.781 1.313 3.531 1.5 3.781s2.594 3.969 6.281 5.563c.875.375 1.563.594 2.094.781.875.281 1.688.25 2.313.156.719-.094 2.219-.906 2.531-1.781s.313-1.625.219-1.781-.344-.281-.781-.5z"/>
    </svg>
    <span>{bar.whatsapp}</span>
  </a>
  <a href={calcHref} class="mobile-action-bar__btn mobile-action-bar__btn--calc" aria-label={bar.calculateAria}>
    <span class="mobile-action-bar__sun" aria-hidden="true">☀️</span>
    <span>{bar.calculate}</span>
  </a>
</nav>

<style>
  .mobile-action-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9990;
    display: grid;
    grid-template-columns: 1fr 1fr 1.15fr;
    gap: 0;
    background: var(--color-navy);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0 env(safe-area-inset-right, 0) env(safe-area-inset-bottom, 0) env(safe-area-inset-left, 0);
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.18);
    transform: translateY(100%);
    transition: transform 0.28s ease;
  }

  .mobile-action-bar.is-visible {
    transform: translateY(0);
  }

  .mobile-action-bar[hidden] {
    display: none;
  }

  .mobile-action-bar__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    min-height: 52px;
    padding: 8px 6px;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    -webkit-tap-highlight-color: transparent;
    transition: background 0.2s ease;
  }

  .mobile-action-bar__btn:last-child {
    border-right: none;
  }

  .mobile-action-bar__btn:active {
    background: rgba(255, 255, 255, 0.08);
  }

  .mobile-action-bar__btn--call svg {
    color: #fff;
  }

  .mobile-action-bar__btn--wa {
    color: #fff;
  }

  .mobile-action-bar__btn--wa svg {
    color: #25d366;
  }

  .mobile-action-bar__btn--calc {
    background: var(--color-primary);
    color: #fff;
    font-weight: 600;
  }

  .mobile-action-bar__btn--calc:active {
    background: var(--color-primary-dark);
  }

  .mobile-action-bar__sun {
    font-size: 1rem;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .mobile-action-bar {
      display: none !important;
    }
  }
</style>

<script>
  const bar = document.getElementById('mobile-action-bar');
  if (bar) {
    const threshold = 280;
    let visible = false;

    const update = () => {
      const show = window.scrollY > threshold;
      if (show === visible) return;
      visible = show;
      bar.hidden = false;
      bar.classList.toggle('is-visible', show);
      document.body.classList.toggle('mobile-bar-active', show);
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
