---
import { blogUiForLang } from '../i18n/blog-ui';
import type { Lang } from '../i18n/ui';

interface Props {
  date: string;
  lang?: Lang;
}

const { date, lang = 'en' } = Astro.props;
const ui = blogUiForLang(lang);
const displayDate = date.replace(/^Updated\s+/i, '').trim();
---

<p class="post-updated-note">
  <strong>{date.startsWith('Updated') || date.includes('അപ്ഡേറ്റ്') ? date : `Updated ${displayDate}`}:</strong>{' '}
  {ui.updatedNoteSuffix}
</p>

<style is:global>
  .post-updated-note {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    background: var(--color-light);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 14px 16px;
    margin: 0 0 24px;
    line-height: 1.65;
  }
  .post-updated-note strong {
    color: var(--color-secondary);
  }
</style>
