---
import { blogUiForLang } from '../i18n/blog-ui';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  calcSub?: string;
}

const { lang = 'en', calcSub } = Astro.props;
const ui = blogUiForLang(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const calcHref = lang === 'ml' ? `${base}/ml/solar-calculator/` : `${base}/solar-calculator/`;
const contactHref = lang === 'ml' ? `${base}/ml/contact/` : `${base}/contact/`;
---

<section class="blog-end-cta" aria-label="Solar calculator call to action">
  <div class="container">
    <div class="calc-cta-card">
      <p class="calc-cta-card__heading">{ui.endCalcHeading}</p>
      <p class="calc-cta-card__sub">{calcSub ?? ui.endCalcSub}</p>
      <div class="calc-cta-card__actions">
        <a href={calcHref} class="calc-cta-card__btn">{ui.endCalcBtn}</a>
        <a href={contactHref} class="calc-cta-card__btn calc-cta-card__btn--outline">
          {lang === 'ml' ? 'സൗജന്യ സൈറ്റ് സർവേ ബുക്ക് ചെയ്യുക' : 'Book a Free Site Survey'}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .blog-end-cta {
    padding: 0 0 56px;
    background: var(--color-light);
  }
  .calc-cta-card {
    background: linear-gradient(135deg, var(--color-navy) 0%, #3a4a6b 100%);
    border-radius: var(--radius-md);
    padding: clamp(24px, 5vw, 36px);
    text-align: center;
    box-shadow: var(--shadow-md);
  }
  .calc-cta-card__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 600;
    color: #fff;
    margin: 0 0 10px;
  }
  .calc-cta-card__sub {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 52ch;
    margin: 0 auto 20px;
  }
  .calc-cta-card__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    max-width: 360px;
    margin: 0 auto;
  }
  .calc-cta-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    background: var(--color-primary);
    color: #fff;
    transition: transform var(--transition), background var(--transition);
  }
  .calc-cta-card__btn:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }
  .calc-cta-card__btn--outline {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.75);
    color: #fff;
  }
  .calc-cta-card__btn--outline:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }
  @media (min-width: 520px) {
    .calc-cta-card__actions {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }
    .calc-cta-card__btn {
      min-width: 200px;
    }
  }
</style>

<style is:global>
  .post-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    max-width: 320px;
    margin: 0 auto;
  }
  .btn-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 20px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.75);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background var(--transition);
  }
  .btn-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  @media (min-width: 520px) {
    .post-cta__actions {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }
  }
</style>
