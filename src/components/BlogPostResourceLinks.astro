---
import { blogUiForLang } from '../i18n/blog-ui';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const ui = blogUiForLang(lang);
---

<nav class="post-resource-links" aria-label={ui.resourceHeading}>
  <p class="post-resource-links__heading">{ui.resourceHeading}</p>
  <ul>
    {ui.resources.map((item) => (
      <li>
        <a href={item.href}>{item.label} →</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .post-resource-links {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .post-resource-links__heading {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: 12px;
  }
  .post-resource-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }
  .post-resource-links a {
    display: inline-flex;
    align-items: center;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--color-primary-light);
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }
  .post-resource-links a:hover {
    background: var(--color-primary);
    color: #fff;
  }
</style>
