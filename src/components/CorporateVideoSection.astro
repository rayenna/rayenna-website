---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  aboutHref: string;
}

const { lang, aboutHref } = Astro.props;
const t = useTranslations(lang);
const v = t.corporateVideo;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const videoSrc = `${base}/media/rayenna-videos/corporate.mp4`;
const thumbBg = `${base}/media/solar-panel-installation.jpg`;
const logoSrc = `${base}/media/Logo-white.webp`;
---

<section class="corporate-video" id="our-story" aria-labelledby="corporate-video-title">
  <div class="corporate-video__glow" aria-hidden="true"></div>
  <div class="container corporate-video__inner">
    <div class="corporate-video__copy">
      <span class="corporate-video__tag">{v.eyebrow}</span>
      <h2 class="corporate-video__title" id="corporate-video-title">{v.title}</h2>
      <p class="corporate-video__sub">{v.sub}</p>
      <a href={aboutHref} class="corporate-video__link">{v.aboutLink}</a>
    </div>

    <div class="corporate-video__media">
      <div class="corporate-video__frame" data-corporate-video>
        <div class="corporate-video__thumb" data-corp-thumb aria-hidden="false">
          <div
            class="corporate-video__thumb-bg"
            style={`background-image: url('${thumbBg}')`}
            role="img"
            aria-label=""
          ></div>
          <div class="corporate-video__thumb-scrim" aria-hidden="true"></div>
          <div class="corporate-video__thumb-content">
            <img
              src={logoSrc}
              alt={t.images.logoAlt}
              class="corporate-video__thumb-logo"
              width="220"
              height="80"
              loading="eager"
              decoding="async"
            />
            <span class="corporate-video__thumb-label">{v.thumbLabel}</span>
          </div>
        </div>

        <video
          class="corporate-video__el"
          preload="none"
          playsinline
          aria-label={v.playLabel}
        >
          <source src={videoSrc} type="video/mp4" />
        </video>

        <button
          type="button"
          class="corporate-video__play"
          data-play-btn
          aria-label={v.playLabel}
        >
          <span class="corporate-video__play-ring" aria-hidden="true"></span>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon points="8 5 19 12 8 19 8 5" />
          </svg>
        </button>
        <span class="corporate-video__duration" data-duration-badge>{v.duration}</span>
      </div>
    </div>
  </div>
</section>

<style>
.corporate-video {
  position: relative;
  padding: 56px 0;
  background: linear-gradient(165deg, var(--color-navy) 0%, var(--color-navy-dark) 55%, #141c2e 100%);
  overflow: hidden;
}

.corporate-video__glow {
  position: absolute;
  top: 20%;
  right: -10%;
  width: min(520px, 70vw);
  height: min(520px, 70vw);
  background: radial-gradient(circle, rgba(168, 56, 56, 0.22) 0%, transparent 68%);
  pointer-events: none;
}

.corporate-video__inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  align-items: center;
}

.corporate-video__tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.85);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 50px;
  margin-bottom: 14px;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.corporate-video__title {
  font-family: var(--font-heading);
  font-size: clamp(1.65rem, 4.5vw, 2.35rem);
  font-weight: 500;
  color: #fff;
  line-height: 1.25;
  margin-bottom: 14px;
}

.corporate-video__sub {
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.75;
  font-size: 0.95rem;
  max-width: 36ch;
  margin-bottom: 20px;
}

.corporate-video__link {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-heading);
  font-weight: 500;
  font-size: 0.92rem;
  color: #f0c4c4;
  transition: color var(--transition);
}
.corporate-video__link:hover {
  color: #fff;
}

.corporate-video__frame {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-navy-dark);
  box-shadow:
    0 24px 60px rgba(0, 0, 0, 0.45),
    0 0 0 1px rgba(255, 255, 255, 0.08);
  aspect-ratio: 16 / 9;
}

/* Branded thumbnail (before play) */
.corporate-video__thumb {
  position: absolute;
  inset: 0;
  z-index: 0;
  transition: opacity 0.45s ease, visibility 0.45s ease;
}

.corporate-video__thumb-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transform: scale(1.02);
  filter: saturate(0.85) brightness(0.55);
}

.corporate-video__thumb-scrim {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(160deg, rgba(39, 50, 79, 0.88) 0%, rgba(29, 37, 58, 0.72) 45%, rgba(20, 28, 46, 0.92) 100%),
    radial-gradient(ellipse 80% 60% at 50% 40%, rgba(168, 56, 56, 0.12) 0%, transparent 70%);
}

.corporate-video__thumb-content {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 28px 24px 36px;
  text-align: center;
}

.corporate-video__thumb-logo {
  width: min(200px, 52vw);
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 4px 24px rgba(0, 0, 0, 0.35));
}

.corporate-video__thumb-label {
  font-family: var(--font-heading);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.55);
}

.corporate-video__el {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  background: #0a0f18;
  opacity: 0;
  z-index: 1;
  transition: opacity 0.45s ease;
}

.corporate-video__frame.is-playing .corporate-video__el {
  opacity: 1;
}

.corporate-video__frame.is-playing .corporate-video__thumb {
  opacity: 0;
  visibility: hidden;
}

.corporate-video__play {
  position: absolute;
  inset: 0;
  margin: auto;
  width: 72px;
  height: 72px;
  border: none;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  transition: transform var(--transition), background var(--transition), box-shadow var(--transition), opacity 0.35s ease;
  -webkit-tap-highlight-color: transparent;
  box-shadow: 0 8px 32px rgba(168, 56, 56, 0.5);
}
.corporate-video__play svg {
  margin-left: 4px;
}
.corporate-video__play-ring {
  position: absolute;
  inset: -10px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.4);
  animation: corp-play-pulse 2.4s ease-out infinite;
}
.corporate-video__play:hover {
  transform: scale(1.06);
  background: var(--color-primary-dark);
}
.corporate-video__play:focus-visible {
  outline: 3px solid #fff;
  outline-offset: 4px;
}

.corporate-video__duration {
  position: absolute;
  bottom: 14px;
  right: 14px;
  z-index: 3;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  padding: 6px 11px;
  border-radius: 6px;
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: opacity 0.35s ease;
}

.corporate-video__frame.is-playing .corporate-video__play,
.corporate-video__frame.is-playing .corporate-video__duration {
  opacity: 0;
  pointer-events: none;
}

@keyframes corp-play-pulse {
  0% { transform: scale(0.92); opacity: 0.7; }
  70% { transform: scale(1.12); opacity: 0; }
  100% { transform: scale(1.12); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .corporate-video__play-ring {
    animation: none;
  }
  .corporate-video__thumb,
  .corporate-video__el {
    transition: none;
  }
}

@media (min-width: 768px) {
  .corporate-video {
    padding: 72px 0;
  }
  .corporate-video__inner {
    grid-template-columns: 0.95fr 1.15fr;
    gap: 48px;
  }
  .corporate-video__play {
    width: 80px;
    height: 80px;
  }
  .corporate-video__thumb-logo {
    width: min(220px, 42%);
  }
}

@media (min-width: 1024px) {
  .corporate-video__inner {
    gap: 64px;
  }
}
</style>

<script>
  document.querySelectorAll('[data-corporate-video]').forEach((frame) => {
    const video = frame.querySelector('video');
    const btn = frame.querySelector('[data-play-btn]');
    const thumb = frame.querySelector('[data-corp-thumb]');
    if (!video || !btn) return;

    const play = async () => {
      frame.classList.add('is-playing');
      if (thumb) thumb.setAttribute('aria-hidden', 'true');
      video.setAttribute('controls', '');
      try {
        await video.play();
      } catch {
        frame.classList.remove('is-playing');
        if (thumb) thumb.setAttribute('aria-hidden', 'false');
        video.removeAttribute('controls');
      }
    };

    btn.addEventListener('click', play);

    video.addEventListener('ended', () => {
      frame.classList.remove('is-playing');
      if (thumb) thumb.setAttribute('aria-hidden', 'false');
      video.removeAttribute('controls');
      video.load();
    });
  });
</script>
