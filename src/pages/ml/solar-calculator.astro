  text-align: center;
  transition: all var(--transition);
  background: #fff;
}
.ht-card:hover { border-color: var(--calc-blue); background: var(--calc-blue-light); }
.ht-card.selected { border-color: var(--calc-blue); background: var(--calc-blue-light); }
.ht-icon { font-size: 1.8rem; display: block; margin-bottom: 6px; }
.ht-card strong { font-size: 0.88rem; color: var(--color-navy); display: block; margin-bottom: 2px; }
.ht-card small  { font-size: 0.75rem; color: var(--color-text-muted); }

/* ── STEPPERS ── */
.steppers-group { display: flex; flex-direction: column; gap: 0; }
.stepper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 0;
  border-bottom: 1px solid var(--color-border);
}
.stepper-row:last-child { border-bottom: none; }
.stepper-row > label,
.stepper-row > div > label {
  font-size: 0.92rem;
  color: var(--color-text);
  font-family: var(--font-body);
}
.stepper-label-group { flex: 1; }
.stepper-label-group label { display: block; font-size: 0.92rem; color: var(--color-text); }
.stepper-label-group small { font-size: 0.76rem; color: var(--color-text-muted); }
.stepper {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
.stp-btn {
  width: 30px; height: 30px;
  border-radius: 50%;
  border: 1.5px solid var(--calc-border);
  background: #fff;
  color: var(--calc-blue);
  font-size: 1.1rem;
  font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: all var(--transition);
  line-height: 1;
  flex-shrink: 0;
}
.stp-btn:hover { background: var(--calc-blue); color: #fff; border-color: var(--calc-blue); }
.stp-val {
  min-width: 28px;
  text-align: center;
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--color-navy);
}

/* ── TOGGLE SWITCHES ── */
.toggles-group { display: flex; flex-direction: column; }
.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 0;
  border-bottom: 1px solid var(--color-border);
}
.toggle-row label:not(.toggle-switch) { font-size: 0.92rem; color: var(--color-text); }
.toggle-switch {
  position: relative;
  width: 44px; height: 24px;
  flex-shrink: 0;
  cursor: pointer;
}
.toggle-switch input { opacity: 0; width: 0; height: 0; }
.toggle-pill {
  position: absolute;
  inset: 0;
  background: #ccc;
  border-radius: 24px;
  transition: background 0.25s ease;
}
.toggle-pill::after {
  content: '';
  position: absolute;
  width: 18px; height: 18px;
  border-radius: 50%;
  background: #fff;
  top: 3px; left: 3px;
  transition: transform 0.25s ease;
  box-shadow: 0 1px 4px rgba(0,0,0,0.2);
}
.toggle-switch input:checked + .toggle-pill { background: var(--calc-blue); }
.toggle-switch input:checked + .toggle-pill::after { transform: translateX(20px); }

/* ── EV SECTION ── */
.ev-section {
  margin-top: 24px;
  border: 1.5px solid var(--calc-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.ev-toggle-row {
  padding: 14px 16px !important;
  background: var(--calc-blue-light);
  border-bottom: none !important;
  margin: 0 !important;
}
.ev-main-label {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.92rem;
  color: var(--color-navy);
}
.ev-panel {
  padding: 20px 16px;
  background: #fafcff;
  border-top: 1px solid var(--calc-border);
}
.ev-panel.hidden { display: none; }

/* ── CHARGER GRID ── */
.charger-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 20px;
}
.charger-card {
  border: 2px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 12px;
  cursor: pointer;
  text-align: center;
  transition: all var(--transition);
  background: #fff;
}
.charger-card:hover { border-color: var(--calc-blue); background: var(--calc-blue-light); }
.charger-card.selected { border-color: var(--calc-blue); background: var(--calc-blue-light); }
.charger-card strong { display: block; font-size: 1.05rem; color: var(--color-navy); margin-bottom: 2px; }
.charger-card span  { display: block; font-size: 0.82rem; color: var(--color-text); }
.charger-card small { display: block; font-size: 0.73rem; color: var(--color-text-muted); }

/* ── SLIDERS ── */
.sliders-group { display: flex; flex-direction: column; gap: 20px; }
.slider-row { display: flex; flex-direction: column; gap: 10px; }
.slider-row label { font-size: 0.92rem; color: var(--color-text); }
.slider-row label strong { color: var(--color-navy); }
.calc-slider {
  width: 100%;
  height: 6px;
  -webkit-appearance: none;
  appearance: none;
  border-radius: 6px;
  background: linear-gradient(to right, var(--calc-blue) 0%, var(--calc-blue) 50%, #dce5ef 50%, #dce5ef 100%);
  cursor: pointer;
  outline: none;
}
.calc-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 20px; height: 20px;
  border-radius: 50%;
  background: var(--calc-blue);
  border: 3px solid #fff;
  box-shadow: 0 1px 6px rgba(24,95,165,0.4);
  cursor: pointer;
}
.calc-slider::-moz-range-thumb {
  width: 20px; height: 20px;
  border-radius: 50%;
  background: var(--calc-blue);
  border: 3px solid #fff;
  cursor: pointer;
}
.slider-range-labels {
  display: flex;
  justify-content: space-between;
  font-size: 0.73rem;
  color: var(--color-text-muted);
}

/* ── EV IMPACT PANEL ── */
.ev-impact-panel {
  background: var(--calc-blue-light);
  border: 1px solid var(--calc-border);
  border-radius: var(--radius-md);
  padding: 16px 18px;
  margin-top: 16px;
}
.ev-impact-row {
  display: flex;
  gap: 24px;
  margin-bottom: 10px;
}
.ev-impact-row > div { flex: 1; }
.ev-impact-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--calc-blue); font-weight: 600; margin-bottom: 4px; }
.ev-impact-val { font-size: 1.15rem; font-weight: 700; color: var(--color-navy); font-family: 'Oswald', var(--font-heading); }
.ev-impact-note { font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.6; }

/* ── OCCUPANCY CARDS ── */
.occupancy-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 8px;
}
.occ-card {
  border: 2px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 16px 14px;
  cursor: pointer;
  text-align: center;
  transition: all var(--transition);
  background: #fff;
}
.occ-card:hover { border-color: var(--calc-blue); background: var(--calc-blue-light); }
.occ-card.selected { border-color: var(--calc-blue); background: var(--calc-blue-light); }
.occ-card strong { display: block; font-size: 0.92rem; color: var(--color-navy); margin-bottom: 4px; }
.occ-card small  { font-size: 0.78rem; color: var(--color-text-muted); }

/* ── NAV BUTTONS ── */
.calc-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 32px;
  gap: 12px;
}
.btn-calc-next {
  background: var(--calc-blue);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 13px 32px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all var(--transition);
  flex: 1;
  max-width: 240px;
}
.btn-calc-next:hover { background: #1450a0; transform: translateY(-1px); }
.btn-calc-next.btn-calc-primary { background: var(--color-primary); }
.btn-calc-next.btn-calc-primary:hover { background: var(--color-primary-dark); }
.btn-calc-back {
  background: transparent;
  color: var(--color-text-muted);
  border: 1.5px solid var(--color-border);
  border-radius: 8px;
  padding: 13px 24px;
  font-family: var(--font-body);
  font-weight: 500;
  font-size: 0.92rem;
  cursor: pointer;
  transition: all var(--transition);
}
.btn-calc-back:hover { border-color: var(--color-text-muted); color: var(--color-text); }

/* ── RESULT HERO CARD ── */
.calc-results-intro {
  font-size: 0.92rem;
  line-height: 1.75;
  color: var(--color-text-muted);
  margin-bottom: 18px;
}
.result-hero {
  background: linear-gradient(135deg, #f7fbff 0%, #eef5fc 100%);
  border: 1.5px solid var(--calc-border);
  border-radius: var(--radius-md);
  padding: 24px 20px;
  margin-bottom: 24px;
}
.result-hero__top {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.result-hero-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--calc-blue);
  font-weight: 600;
  margin-bottom: 8px;
}
.result-hero-kw {
  font-family: 'Oswald', var(--font-heading);
  font-size: 3.2rem;
  font-weight: 700;
  color: var(--color-navy);
  line-height: 1;
  margin-bottom: 8px;
}
.result-hero-units { font-size: 0.92rem; color: var(--calc-blue); font-weight: 500; }
.result-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.result-pill {
  display: inline-flex;
  align-items: center;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.3px;
  color: var(--color-text-muted);
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(255,255,255,0.85);
  border: 1px solid #d9e3ef;
}
.result-hero-summary {
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid #d9e3ef;
  color: var(--color-text);
  line-height: 1.75;
  font-size: 0.95rem;
}
.result-highlights {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 18px;
}
.result-highlight {
  background: #fff;
  border: 1px solid #d9e3ef;
  border-radius: 12px;
  padding: 14px 14px 12px;
}
.rh-label {
  display: block;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--color-text-muted);
  margin-bottom: 6px;
  font-weight: 600;
}
.rh-value {
  font-family: 'Oswald', var(--font-heading);
  font-size: 1.45rem;
  line-height: 1;
  color: var(--color-navy);
}

.result-guidance-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
  margin-bottom: 28px;
}
.result-guide-card {
  border: 1px solid #dce4ef;
  border-radius: var(--radius-md);
  background: #fff;
  padding: 18px 18px 16px;
}
.result-guide-card--accent {
  background: linear-gradient(180deg, #fbfdff 0%, #f1f7fd 100%);
}
.guide-card__label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  color: var(--calc-blue);
  font-weight: 700;
  margin-bottom: 8px;
}
.result-guide-card h4 {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--color-navy);
  margin-bottom: 8px;
}
.result-guide-card p {
  margin: 0;
  font-size: 0.92rem;
  color: var(--color-text-muted);
  line-height: 1.75;
}

/* ── 4 STAT CARDS ── */
.result-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 28px;
}
.result-stat {
  background: var(--color-light);
  border-radius: var(--radius-md);
  padding: 18px 16px;
  border: 1px solid var(--color-border);
}
.rs-label { font-size: 0.73rem; text-transform: uppercase; letter-spacing: 1px; color: var(--color-text-muted); margin-bottom: 6px; font-weight: 600; }
.rs-val { font-family: 'Oswald', var(--font-heading); font-size: 1.4rem; font-weight: 600; color: var(--color-navy); }

/* ── PANEL OPTIONS ── */
.panel-options-section { margin-bottom: 28px; }
.panel-options-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 14px;
}
.panel-select-hint {
  font-size: 0.75rem;
  color: var(--calc-blue);
  font-style: italic;
}
.panel-option {
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 16px;
  margin-bottom: 10px;
  background: #fff;
  cursor: pointer;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  position: relative;
}
.panel-option:hover { border-color: #a0b8d4; box-shadow: var(--shadow-md); }
.panel-option.selected {
  border-color: var(--calc-blue);
  background: #f6faff;
  box-shadow: 0 0 0 3px rgba(24,95,165,0.1);
}
.panel-option.selected::after {
  content: '✓ തിരഞ്ഞെടുത്തു';
  position: absolute;
  top: 12px;
  right: 12px;
  background: var(--calc-blue);
  color: #fff;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 3px 9px;
  border-radius: 50px;
  font-family: var(--font-heading);
}
.panel-option__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  margin-bottom: 12px;
  gap: 8px;
}
.panel-option__header h4 {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-navy);
  margin-top: 4px;
}
.panel-badge {
  display: inline-block;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: 50px;
  margin-bottom: 4px;
}
.panel-badge.blue   { background: var(--calc-blue-light); color: var(--calc-blue); }
.panel-badge.purple { background: #f0eaff; color: #6b21a8; }
.panel-badge.green  { background: #e8f5e9; color: #2e7d32; }
.panel-badge.teal   { background: #e0f7f4; color: #00796b; }
.panel-badge.grey   { background: #f5f5f5; color: #666; }
.panel-expand {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 0.78rem;
  color: var(--color-text-muted);
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all var(--transition);
}
.panel-expand:hover { border-color: var(--calc-blue); color: var(--calc-blue); }
.panel-option__stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.panel-option__stats span {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  background: var(--color-light);
  border-radius: 4px;
  padding: 3px 10px;
  white-space: nowrap;
}
.panel-option__detail {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--color-border);
}
.panel-option__detail p { font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.7; margin: 0; }
.panel-option__detail.hidden { display: none; }

/* ── FINANCIAL SNAPSHOT ── */
.fin-snapshot { margin-bottom: 28px; }
.fin-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  padding: 12px 0;
  border-bottom: 1px solid var(--color-border);
  font-size: 0.88rem;
  color: var(--color-text);
  gap: 4px 12px;
}
.fin-row span:first-child { color: var(--color-text-muted); }
.fin-row span:last-child { font-weight: 600; color: var(--color-navy); }
.fin-row.fin-highlight span:last-child {
  font-family: 'Oswald', var(--font-heading);
  font-size: 1.2rem;
  color: var(--calc-blue);
}
.fin-row.fin-total { border-top: 2px solid var(--color-border); margin-top: 4px; padding-top: 14px; }
.fin-row.fin-total span { font-weight: 700; color: var(--color-navy) !important; }
.fin-row.fin-subsidy span:last-child { color: #2e7d32 !important; font-weight: 600; }
.fin-row.fin-subsidy span:first-child::before { content: ''; }

/* ── RESULT CTAs ── */
.result-ctas {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 8px;
}
.result-ctas .btn { justify-content: center; }
.result-share-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}
.result-share-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.result-action-status {
  min-height: 1.25rem;
  margin: -2px 4px 0;
  font-size: 0.82rem;
  color: var(--calc-blue);
}
.btn-calc-outline {
  background: transparent;
  color: var(--calc-blue);
  border: 2px solid var(--calc-blue);
  border-radius: 50px;
  padding: 12px 32px;
  font-family: var(--font-body);
  font-weight: 500;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all var(--transition);
  text-align: center;
}
.btn-calc-outline:hover { background: var(--calc-blue); color: #fff; }

/* ── ASSUMPTIONS ── */
.calc-assumptions {
  margin-top: 24px;
  border: 1px solid #dce4ef;
  border-radius: var(--radius-md);
  background: #fbfcfe;
  padding: 18px 20px;
}
.calc-assumptions summary {
  list-style: none;
  cursor: pointer;
  font-family: var(--font-heading);
  font-size: 0.98rem;
  font-weight: 600;
  color: var(--color-navy);
}
.calc-assumptions summary::-webkit-details-marker { display: none; }
.calc-assumptions summary::after {
  content: '+';
  float: right;
  font-size: 1.1rem;
  color: var(--calc-blue);
}
.calc-assumptions[open] summary::after { content: '−'; }
.calc-assumptions__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  margin-top: 16px;
}
.assumption-card {
  background: #fff;
  border: 1px solid #e3eaf3;
  border-radius: 12px;
  padding: 14px 14px 12px;
}
.assumption-card strong {
  display: block;
  font-size: 0.82rem;
  color: var(--color-navy);
  margin-bottom: 6px;
}
.assumption-card p {
  margin: 0;
  font-size: 0.86rem;
  line-height: 1.7;
  color: var(--color-text-muted);
}
.calc-assumptions__updated {
  margin-top: 14px;
  font-size: 0.78rem;
  color: var(--color-text-muted);
}

/* ── FOOTNOTE / T&C ── */
.calc-footnote {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  background: #f8f9fb;
  border: 1px solid #dce4ef;
  border-left: 4px solid var(--calc-blue);
  border-radius: var(--radius-md);
  padding: 24px 28px 24px 22px;
  margin-top: 32px;
}
.calc-footnote__icon { font-size: 1.15rem; flex-shrink: 0; margin-top: 2px; }
.calc-footnote__body { flex: 1; }
.calc-footnote__heading {
  font-family: var(--font-heading);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--calc-blue);
  margin-bottom: 12px;
}
.calc-footnote__list {
  list-style: none;
  counter-reset: fn;
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 0;
  margin: 0;
}
.calc-footnote__list li {
  counter-increment: fn;
  display: flex;
  gap: 14px;
  align-items: flex-start;
}
.calc-footnote__list li::before {
  content: counter(fn);
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 22px;
  height: 22px;
  background: var(--calc-blue);
  color: #fff;
  border-radius: 50%;
  font-size: 0.72rem;
  font-weight: 700;
  font-family: var(--font-heading);
  flex-shrink: 0;
  margin-top: 1px;
}
.fn-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}
.fn-item strong {
  font-family: var(--font-heading);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--color-navy);
  line-height: 1.3;
}
.fn-item p {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  line-height: 1.75;
  margin: 0;
}

/* ── REASSURANCE STRIP ── */
.reassurance-section { padding: var(--section-padding); background: #fff; }
.reassurance__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
.reassurance-card {
  background: var(--color-light);
  border-radius: var(--radius-md);
  padding: 28px 24px;
  border: 1px solid var(--color-border);
  transition: box-shadow var(--transition);
}
.reassurance-card:hover { box-shadow: var(--shadow-md); }
.reassurance-icon { font-size: 2rem; display: block; margin-bottom: 12px; }
.reassurance-card h3 {
  font-family: var(--font-heading);
