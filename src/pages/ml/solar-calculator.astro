---
import Layout from '../../layouts/Layout.astro';
import { calcMl } from '../../i18n/calculator-ml.ts';
import { OG } from '../../i18n/og-images';
import '../../styles/solar-calculator.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mlPrefix = '/ml';
---
<Layout lang="ml"
  title="സൗജന്യ സോളാർ കാൽക്കുലേറ്റർ കേരളം | റയെന്ന എനർജി"
  description="നിങ്ങളുടെ വീട്ടിന് അനുയോജ്യമായ സിസ്റ്റം വലുപ്പവും ചെലവും കണക്കാക്കുക. സബ്സിഡി, പേയ്ബാക്ക് കാലയളവ്."
  ogImage={OG.calculator}
>

  <!-- ===== HERO ===== -->
  <section class="page-hero calc-page-hero">
    <img src={`${base}/media/services-hero-opt3.jpg`} alt="സൂര്യാശയങ്ങളുള്ള മേൽക്കൂര" class="page-hero__bg" />
    <div class="page-hero__overlay"></div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow page-hero__eyebrow--pill">☀️ സ്മാർട്ട് സോളാർ ടൂൾ</p>
      <h1 class="page-hero__title">നിങ്ങളുടെ വീട്ടിന് അനുയോജ്യമായ<br /><span class="hero-title-grad">സോളാർ സിസ്റ്റം</span><br />കണ്ടെത്തുക</h1>
      <p class="page-hero__sub">നിങ്ങളുടെ വീടിനെക്കുറിച്ച് പറയുക. മിനിറ്റുകൾക്കുള്ളിൽ വ്യക്തിഗത സോളാർ എസ്റ്റിമേറ്റ് നേടുക.</p>
      <div class="hero-stat-pills" aria-hidden="true">
        <span class="hero-stat-pill"><strong>5 മിനിറ്റ്</strong> പൂർത്തിയാക്കാൻ</span>
        <span class="hero-stat-pill"><strong>100%</strong> വ്യക്തിഗതം</span>
        <span class="hero-stat-pill"><strong>സൗജന്യം</strong> · ബാധ്യതയില്ല</span>
      </div>
      <p class="page-hero__note page-hero__note--callout">🏠 ഈ കാൽക്കുലേറ്റർ കേരളത്തിലെ വീട്ടുപയോഗ മേൽക്കൂര സോളാറിനാണ്. കമർഷ്യൽ സോളാറിന്, <a href="https://api.whatsapp.com/send?phone=917907369304&text=Hi%20Rayenna%20Energy!%20I%27m%20interested%20in%20commercial%20solar%20installation." target="_blank" rel="noopener noreferrer">WhatsApp-ൽ ഞങ്ങളോട് ചാറ്റ് ചെയ്യുക</a>.</p>
      <div class="hero-btns">
        <a href="#calculator" class="btn btn-primary hero-scroll-btn">കാൽക്കുലേറ്റർ ആരംഭിക്കുക ↓</a>
        <a href={`${mlPrefix}/contact/`} class="btn btn-outline-white">സൗജന്യ കൺസൾട്ടേഷൻ</a>
      </div>
    </div>
  </section>

  <!-- ===== TRUST STRIP ===== -->
  <section class="trust-strip">
    <div class="container trust-inner">
      {[
        { val: '5 മിനിറ്റ്',  label: 'പൂർത്തിയാക്കാൻ സമയം' },
        { val: '100%',   label: 'വ്യക്തിഗത ഫലങ്ങൾ' },
        { val: 'സൗജന്യം',   label: 'ചെലവില്ല, ബാധ്യതയില്ല' },
        { val: 'MNRE',   label: 'അംഗീകൃത ഇൻസ്റ്റാളർ' },
      ].map(m => (
        <div class="trust-metric">
          <strong>{m.val}</strong>
          <span>{m.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="calc-intro">
    <div class="container calc-intro__inner">
      <div class="calc-intro__image">
        <img src={`${base}/media/solar-calculator-intro.jpg`} alt="മേൽക്കൂരയിലെ ഉയർന്ന കാര്യക്ഷമതയുള്ള സോളാർ പാനലുകൾ" />
      </div>
      <div class="calc-intro__content">
        <span class="section-tag">എങ്ങനെ പ്രവർത്തിക്കുന്നു</span>
        <h2 class="section-title">നിങ്ങളുടെ വീട് പ്രത്യേകമാണ്. സോളാർ സിസ്റ്റവും അങ്ങനെ തന്നെ.</h2>
        <p>മിക്ക സോളാർ ക്വോട്ടുകളും നിങ്ങളുടെ വീടിന്റെ യാഥാർത്ഥ്യത്തിനുപകരം പൊതുവായ ശരാശരികളിൽ നിന്നാണ് തുടങ്ങുന്നത്. റയെന്നയുടെ സോളാർ കാൽക്കുലേറ്റർ അതിനേക്കാൾ നല്ല ഒരു പ്ലാനിംഗ് എസ്റ്റിമേറ്റ് നൽകുന്നു. വീടിന്റെ തരം, മുറികൾ, ഉപകരണങ്ങൾ, EV ഉപയോഗം എന്നിവ പറയുക, പിന്നെ നിലവിലെ കേരള റൂഫ്‌ടോപ്പ് സോളാർ ധാരണകളെ അടിസ്ഥാനമാക്കി സിസ്റ്റം വലുപ്പം, പാനൽ എണ്ണം, റൂഫ് സ്ഥലം, സബ്സിഡി, ലാഭം എന്നിവ ഞങ്ങൾ കണക്കാക്കും. ഇത് സൗജന്യ സൈറ്റ് സർവേയ്ക്ക് മുമ്പുള്ള ബുദ്ധിപരമായ ഒരു തുടക്കമാണ്.</p>
        <div class="how-cards">
          <div class="how-card">
            <span class="how-card__icon">⚡</span>
            <div>
              <h3>വിശദാംശങ്ങൾ നൽകുക</h3>
              <p>വീടിന്റെ തരം, മുറികൾ, ഉപകരണങ്ങൾ</p>
            </div>
          </div>
          <div class="how-card">
            <span class="how-card__icon">☀️</span>
            <div>
              <h3>ശുപാർശ നേടുക</h3>
              <p>സിസ്റ്റം വലുപ്പം, പാനലുകൾ, റൂഫ് സ്ഥലം</p>
            </div>
          </div>
          <div class="how-card">
            <span class="how-card__icon">💰</span>
            <div>
              <h3>സമ്പാദ്യം കാണുക</h3>
              <p>പേയ്ബാക്ക് കാലയളവും ആജീവനാന്ത സമ്പാദ്യവും</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CALCULATOR MODULE ===== -->
  <section class="calculator-section" id="calculator">
    <div class="container">
      <div class="calc-card">

        <!-- Progress bar -->
        <div class="calc-progress">
          <div class="calc-progress-head">
            <div class="calc-progress-track" aria-hidden="true">
              <div class="calc-progress-fill" id="calc-progress-fill" style="width: 0%"></div>
            </div>
            <div class="calc-progress-steps" role="list">
              {calcMl.progressStepNames.map((name, i) => (
                <div class:list={['cpb-step', { active: i === 0 }]} data-step={i + 1} role="listitem">
                  <div class="cpb-dot">
                    {i === 3 ? <span class="cpb-sun" aria-hidden="true">☀</span> : <span>{i + 1}</span>}
                  </div>
                  <span class="cpb-step-name">{name}</span>
                </div>
              ))}
            </div>
          </div>
          <p class="calc-step-label" id="step-label">{calcMl.stepLabels[1]}</p>
        </div>

        <!-- ── STEP 1: HOME ── -->
        <div class="calc-step" id="step-1">
          <h3 class="calc-step-title">നിങ്ങളുടെ വീടിനെക്കുറിച്ച്</h3>
          <p class="calc-step-sub">{calcMl.stepSubtitles[1]}</p>
          <p class="calc-field-label">വീടിന്റെ തരം</p>
          <div class="home-type-grid" id="home-type-grid">
            <div class="ht-card selected" data-type="house">
              <span class="ht-icon">🏠</span>
              <strong>സ്വതന്ത്ര വീട്</strong>
              <small>സ്റ്റാൻഡ്ടോൺ വീട്</small>
            </div>
            <div class="ht-card" data-type="apartment">
              <span class="ht-icon">🏢</span>
              <strong>അപ്പാർട്ട്‌മെന്റ്</strong>
              <small>ഫ്ലാറ്റ് / ബിൽഡിംഗിലെ യൂണിറ്റ്</small>
            </div>
            <div class="ht-card" data-type="villa">
              <span class="ht-icon">🏡</span>
              <strong>വില്ല</strong>
              <small>പ്രത്യേക / ഗേറ്റഡ് വില്ല</small>
            </div>
            <div class="ht-card" data-type="rowhouse">
              <span class="ht-icon">🏘</span>
              <strong>റോ ഹൗസ്</strong>
              <small>ടെറസ് / ബന്ധിപ്പിച്ച വീട്</small>
            </div>
          </div>

          <div class="steppers-group">
            <div class="stepper-row">
              <label>കിടപ്പുമുറികൾ</label>
              <div class="stepper" data-id="bedrooms" data-min="1" data-max="10" data-val="3">
                <button class="stp-btn stp-minus" type="button" aria-label="കുറയ്ക്കുക">−</button>
                <span class="stp-val">3</span>
                <button class="stp-btn stp-plus" type="button" aria-label="കൂട്ടുക">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <label>കുളിമുറികൾ</label>
              <div class="stepper" data-id="bathrooms" data-min="1" data-max="10" data-val="2">
                <button class="stp-btn stp-minus" type="button" aria-label="കുറയ്ക്കുക">−</button>
                <span class="stp-val">2</span>
                <button class="stp-btn stp-plus" type="button" aria-label="കൂട്ടുക">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <label>നിലകൾ</label>
              <div class="stepper" data-id="floors" data-min="1" data-max="4" data-val="1">
                <button class="stp-btn stp-minus" type="button" aria-label="കുറയ്ക്കുക">−</button>
                <span class="stp-val">1</span>
                <button class="stp-btn stp-plus" type="button" aria-label="കൂട്ടുക">+</button>
              </div>
            </div>
          </div>

          <div class="calc-nav">
            <div></div>
            <button class="btn-calc-next" type="button" data-next="2">{calcMl.nextToAppliances}</button>
          </div>
        </div>

        <!-- ── STEP 2: APPLIANCES ── -->
        <div class="calc-step hidden" id="step-2">
          <h3 class="calc-step-title">നിങ്ങളുടെ ഉപകരണങ്ങൾ</h3>
          <p class="calc-step-sub">{calcMl.stepSubtitles[2]}</p>

          <p class="calc-category-label">❄️ തണുപ്പിക്കൽ</p>
          <div class="steppers-group">
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>എയർ കണ്ടീഷനറുകൾ</label>
                <small>1.5 ടൺ സ്പ്ലിറ്റ് AC, ഓരോന്നും 1500W</small>
              </div>
              <div class="stepper" data-id="ac" data-min="0" data-max="15" data-val="2">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">2</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>സീലിംഗ് ഫാൻസ്</label>
                <small>ഓരോന്നും 75W</small>
              </div>
              <div class="stepper" data-id="fans" data-min="0" data-max="30" data-val="4">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">4</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
          </div>

          <p class="calc-category-label">📺 വിനോദം</p>
          <div class="steppers-group">
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>ടെലിവിഷനുകൾ</label>
                <small>LED, ഓരോന്നും 120W</small>
              </div>
              <div class="stepper" data-id="tvs" data-min="0" data-max="15" data-val="2">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">2</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
          </div>

          <p class="calc-category-label">🍳 അടുക്കള</p>
          <div class="steppers-group">
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>റഫ്രിജറേറ്റർ</label>
                <small>200W, സമയത്തിന്റെ 30% പ്രവർത്തനം</small>
              </div>
              <div class="stepper" data-id="fridge" data-min="0" data-max="5" data-val="1">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">1</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>മൈക്രോവേവ് / OTG</label>
                <small>1200W, ~1 മണി/ദിവസം</small>
              </div>
              <div class="stepper" data-id="microwave" data-min="0" data-max="5" data-val="1">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">1</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>വാഷിംഗ് മെഷീൻ</label>
                <small>500W, ~1 മണി/ദിവസം</small>
              </div>
              <div class="stepper" data-id="washing" data-min="0" data-max="4" data-val="1">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">1</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
          </div>

          <p class="calc-category-label">🔌 മറ്റുള്ളവ</p>
          <div class="toggles-group">
            <div class="toggle-row">
              <div class="stepper-label-group">
                <label>വാട്ടർ ഹീറ്റർ / ഗീസർ</label>
                <small>2000W, ~1 മണി/ദിവസം</small>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggle-geyser" checked />
                <span class="toggle-pill"></span>
              </label>
            </div>
            <div class="toggle-row">
              <div class="stepper-label-group">
                <label>വാട്ടർ പമ്പ് / മോട്ടോർ</label>
                <small>750W, ~2 മണി/ദിവസം</small>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggle-pump" />
                <span class="toggle-pill"></span>
              </label>
            </div>
          </div>

          <!-- EV Section -->
          <div class="ev-section">
            <div class="toggle-row ev-toggle-row">
              <label class="ev-main-label">⚡ എനിക്ക് ഇലക്ട്രിക് വാഹനമുണ്ട്</label>
              <label class="toggle-switch">
                <input type="checkbox" id="toggle-ev" />
                <span class="toggle-pill"></span>
              </label>
            </div>

            <div class="ev-panel hidden" id="ev-panel">
              <div class="steppers-group">
                <div class="stepper-row">
                  <label>EV എണ്ണം</label>
                  <div class="stepper" data-id="ev-count" data-min="1" data-max="4" data-val="1">
                    <button class="stp-btn stp-minus" type="button">−</button>
                    <span class="stp-val">1</span>
                    <button class="stp-btn stp-plus" type="button">+</button>
                  </div>
                </div>
              </div>

              <p class="calc-field-label" style="margin-top:20px;">ചാർജർ തരം</p>
              <div class="charger-grid" id="charger-grid">
                <div class="charger-card" data-kw="2.3">
                  <strong>2.3 kW</strong>
                  <span>സാധാരണ 5A സോക്കറ്റ്</span>
                  <small>രാത്രി സ്റ്റാൻഡേർഡ് പ്ലഗ്</small>
                </div>
                <div class="charger-card selected" data-kw="3.3">
                  <strong>3.3 kW</strong>
                  <span>സ്ലോ വാൾ ബോക്സ്</span>
                  <small>സാധാരണ ഹോം ചാർജർ</small>
                </div>
                <div class="charger-card" data-kw="7.4">
                  <strong>7.4 kW</strong>
                  <span>ഫാസ്റ്റ് വാൾ ബോക്സ്</span>
                  <small>സമർപ്പിത AC ചാർജർ</small>
                </div>
                <div class="charger-card" data-kw="11">
                  <strong>11 kW</strong>
                  <span>റാപിഡ് AC ചാർജർ</span>
                  <small>3-ഫേസ്, പ്രീമിയം സെറ്റപ്പ്</small>
                </div>
              </div>

              <div class="sliders-group">
                <div class="slider-row">
                  <label>ദൈനംദിന ചാർജ് സമയം: <strong id="ev-hours-val">4</strong> മണി</label>
                  <input type="range" id="ev-hours" min="1" max="12" value="4" step="1" class="calc-slider" />
                  <div class="slider-range-labels"><span>1 മണി</span><span>12 മണി</span></div>
                </div>
                <div class="slider-row">
                  <label>ആഴ്ചയിൽ ചാർജ് ചെയ്യുന്ന ദിവസങ്ങൾ: <strong id="ev-days-val">5</strong> ദിവസം</label>
                  <input type="range" id="ev-days" min="1" max="7" value="5" step="1" class="calc-slider" />
