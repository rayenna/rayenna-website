---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mlPrefix = '/ml';
---
<Layout lang="ml"
  title="തൃശ്ശൂരിൽ സോളാർ ഇൻസ്റ്റാളേഷൻ | റയെന്ന എനർജി"
  description="തൃശ്ശൂരിൽ സോളാർ ഇൻസ്റ്റാളേഷൻ — MNRE അംഗീകൃത. PM സൂര്യ ഘർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ സൈറ്റ് സർവേ."
>

  <section class="area-hero">
    <img src={`${base}/media/hero (1).webp`} alt="തൃശ്ശൂരിലെ മേൽക്കൂര സോളാർ പാനൽ ഇൻസ്റ്റാളേഷൻ" class="area-hero__bg" />
    <div class="area-hero__overlay"></div>
    <div class="container area-hero__inner">
      <p class="area-hero__eyebrow">തൃശ്ശൂർ ജില്ല</p>
      <h1 class="area-hero__title">തൃശ്ശൂരിൽ<br />സോളാർ ഇൻസ്റ്റാളേഷൻ</h1>
      <p class="area-hero__sub">MNRE അംഗീകൃത ഇൻസ്റ്റാളർ. സർക്കാർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ റൂഫ് അസസ്മെന്റ്. 25 വർഷ വാറന്റി.</p>
      <div class="area-hero__ctas">
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-primary">☀️ സമ്പാദ്യം കണക്കാക്കുക</a>
        <a href={`${mlPrefix}/contact/`} class="btn btn-outline-light">സൗജന്യ സർവേ ബുക്ക് →</a>
      </div>
    </div>
  </section>

  <!-- ===== WHY THRISSUR ===== -->
  <section class="area-why">
    <div class="container area-why__inner">
      <div class="area-why__content">
        <span class="section-tag">തൃശ്ശൂരിന്റെ സോളാർ സാധ്യത</span>
        <h2 class="section-title">തൃശ്ശൂരിൽ സോളാർ — അക്കങ്ങൾ പ്രവർത്തിക്കുന്നു</h2>
        <p>തൃശ്ശൂർ ജില്ലയുടെ അർദ്ധആന്തരിക സ്ഥാനം കോസ്റ്റൽ കൊച്ചിയേക്കാൾ സ്ഥിരമായ സോളാർ ഇറാഡിയൻസ് നൽകുന്നു; കുറഞ്ഞ ആർദ്രത പാനലുകളിലെ മലിനീകരണ നഷ്ടം കുറയ്ക്കുന്നു. തൃശ്ശൂരിൽ ശരിയായി സൈസ് ചെയ്ത 3–5 kW സിസ്റ്റം ശരാശരി വീട്ടുകാരന്റെ KSEB ബില്ലിന്റെ 80–90% ഓഫ്സെറ്റ് ചെയ്യാം; സബ്സിഡിക്ക് ശേഷം പേയ്ബാക്ക് സാധാരണയായി 3–4 വർഷം.</p>
        <p>വലിയ സ്വതന്ത്ര വീടുകൾ, വാണിജ്യ സ്ഥാപനങ്ങൾ, കാർഷിക ഭൂമി എന്നിവയുടെ മിശ്രണം തൃശ്ശൂരിനെ വീട്ടുപയോഗ, കമർഷ്യൽ സോളാർ സ്വീകരണത്തിന് അനുയോജ്യമായ പ്രദേശമാക്കുന്നു. സൈറ്റ് സർവേകളും ഇൻസ്റ്റാളേഷനുകളും നടത്താൻ റയെന്ന ടീം തൃശ്ശൂരിലേക്ക് നിയമിതമായി വരുന്നു — ദൂരെയുള്ള കോൺട്രാക്ടർമാരുടെ കാലതാമസമില്ലാതെ വേഗത്തിൽ പൂർത്തിയാക്കാം.</p>
        <ul class="area-facts">
          <li><span class="fact-icon">🌞</span><span><strong>ഉയർന്ന വാർഷിക ഉത്പാദനം</strong> — തൃശ്ശൂരിന്റെ ആന്തരിക സ്ഥാനം കൊച്ചിയേക്കാൾ കുറഞ്ഞ തീരദേശ മേഘാവൃതി</span></li>
          <li><span class="fact-icon">🏠</span><span><strong>വലിയ മേൽക്കൂര പ്രദേശങ്ങൾ</strong> — തൃശ്ശൂരിലെ സ്വതന്ത്ര വീടുകൾ സാധാരണയായി 5–10 kW സിസ്റ്റങ്ങൾക്ക് അനുയോജ്യം</span></li>
          <li><span class="fact-icon">⚡</span><span><strong>KSEB നെറ്റ് മീറ്ററിംഗ് സജീവം</strong> — ഗ്രിഡിലേക്ക് കയറ്റിയ അധിക യൂണിറ്റുകൾ ബിൽ കൂടുതൽ കുറയ്ക്കുന്നു</span></li>
          <li><span class="fact-icon">📞</span><span><strong>നിയമിത സേവന സന്ദർശനങ്ങൾ</strong> — റയെന്ന ടീം തൃശ്ശൂർ ജില്ലയിൽ ആഴ്ചയിൽ സർവേകൾക്കും ഫോളോ-അപ്പിനും വരുന്നു</span></li>
        </ul>
      </div>
      <div class="area-why__image">
        <img src={`${base}/media/Hardshell-solar.webp`} alt="തൃശ്ശൂരിൽ റയെന്ന ഇൻസ്റ്റാൾ ചെയ്ത ഉയർന്ന നിലവാരമുള്ള സോളാർ പാനലുകൾ" />
      </div>
    </div>
  </section>

  <!-- ===== SUBSIDY ===== -->
  <section class="area-subsidy">
    <div class="container">
      <div class="area-subsidy__inner">
        <div class="subsidy-icon">🏛️</div>
        <div class="subsidy-content">
          <h2>തൃശ്ശൂർ വീട്ടുടമകൾക്കുള്ള കേന്ദ്ര സർക്കാർ സബ്സിഡി</h2>
          <p>കേരള നിവാസിയായി നിങ്ങൾക്ക് PM സൂര്യ ഘർ മുഫ്ത് ബിജ്ലി യോജന സബ്സിഡിയിൽ അർഹതയുണ്ട് — ഇൻസ്റ്റാളേഷന് ശേഷം <strong>₹78,000</strong> വരെ നേരിട്ട് ബാങ്ക് അക്കൗണ്ടിലേക്ക്. നെറ്റ് മീറ്ററിംഗ് കണക്ഷനായി KSEB തൃശ്ശൂർ ഡിവിഷനുമായി റയെന്ന ഓൺലൈൻ അപേക്ഷ മുഴുവനും ഏകോപിപ്പിക്കുന്നു — അധിക ചാർജ് ഇല്ല.</p>
          <div class="subsidy-table">
            <div class="subsidy-row"><span>2 kW വരെ</span><strong>₹30,000 – ₹60,000 സബ്സിഡി</strong></div>
            <div class="subsidy-row"><span>3 kW സിസ്റ്റം</span><strong>₹78,000 സബ്സിഡി</strong></div>
            <div class="subsidy-row"><span>3–10 kW സിസ്റ്റം</span><strong>₹78,000 + ബാലൻസ് ചെലവിന്റെ 20%</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LOCAL INSTALLATIONS ===== -->
  <section class="area-installs">
    <div class="container">
      <h2 class="section-title text-center">സമീപകാല തൃശ്ശൂർ & ഉത്തര കേരള ഇൻസ്റ്റാളേഷനുകൾ</h2>
      <div class="area-installs-grid">
        {[
          { name: 'Joby',   location: 'Chalakudy', cap: '3 kW', img: 'JOBYCHALAKUDY3KW-DEYE-INVERTER-PANELS-ADANI.jpeg' },
          { name: 'Koya',   location: 'Nilambur',  cap: '3 kW', img: 'KOYA-NILAMBUR-3KW-SOLIS-INVERTER-PANELS-RENEW.png' },
          { name: 'Rupesh', location: 'Calicut',   cap: '3 kW', img: 'RUPESHCALICUT3KW-DEYE-INVERTER-PANELS-ADANI-edited.jpeg' },
          { name: 'Jelees', location: 'Mahe',      cap: '5 kW', img: 'JELEESMAHE5KW-FESTON-INVERTER-PANELS-WAAREE.jpeg' },
        ].map(item => (
          <div class="area-install-card">
            <img src={`${base}/media/references/${item.img}`} alt={`${item.name}, ${item.location} — ${item.cap} സോളാർ ഇൻസ്റ്റാളേഷൻ`} loading="lazy" />
            <div class="area-install-label">
              <strong>{item.name}</strong>
              <span>{item.location} · {item.cap}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="installs-cta-text"><a href={`${mlPrefix}/media/`}>എല്ലാ ഇൻസ്റ്റാളേഷനുകളും കാണുക →</a></p>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="area-faq">
    <div class="container area-faq__inner">
      <h2 class="section-title">തൃശ്ശൂർ വീട്ടുടമകളുടെ ചോദ്യങ്ങൾ</h2>
      <div class="area-faq__list">
        {[
          {
            q: 'തൃശ്ശൂരിലെ ഇൻസ്റ്റാളേഷനുകൾക്ക് റയെന്ന എത്ര ദൂരം യാത്ര ചെയ്യും?',
            a: 'റയെന്നയുടെ ഇൻസ്റ്റാളേഷൻ ടീം ചാലക്കുടി, ഇരിഞ്ഞാലക്കുട, കുന്നംകുളം, ചുറ്റുമുള്ള താലൂക്കുകൾ ഉൾപ്പെടെ മുഴുവൻ തൃശ്ശൂർ ജില്ലയും കവർ ചെയ്യുന്നു. യാത്രാ ചെലവ് കുറയ്ക്കാനും പ്രതികരണ സമയം വേഗത്തിലാക്കാനും പ്രത്യേക തൃശ്ശൂർ സന്ദർശന ദിവസങ്ങൾ ഷെഡ്യൂൾ ചെയ്യുന്നു.',
          },
          {
            q: 'സാധാരണ തൃശ്ശൂർ വീട്ടിന് ഏത് സിസ്റ്റം സൈസ് അനുയോജ്യം?',
            a: 'മാസം ₹2,000–₹5,000 KSEB ബില്ലുള്ള മിക്ക തൃശ്ശൂർ കുടുംബങ്ങൾക്കും 3–5 kW സിസ്റ്റം ശരിയായ സൈസ്. സൗജന്യ സൈറ്റ് സർവേയിൽ ലോഡ് അനാലിസിസ് ഉൾപ്പെടുന്നു — സബ്സിഡിക്ക് അർഹതയുള്ള ഏറ്റവും കുറഞ്ഞതല്ല, ഒപ്റ്റിമൽ കപ്പാസിറ്റി ശുപാർശ ചെയ്യുന്നു.',
          },
          {
            q: 'തൃശ്ശൂരിലെ കാർഷിക കണക്ഷനുകൾക്ക് (LT-7) സോളാർ നെറ്റ് മീറ്ററിംഗ് ലഭിക്കുമോ?',
            a: 'കാർഷിക കണക്ഷനുകൾക്ക് സോളാർ ഇൻസ്റ്റാൾ ചെയ്യാം, എന്നാൽ നെറ്റ് മീറ്ററിംഗ് അർഹത നിങ്ങളുടെ കണക്ഷൻ തരവും KSEB സബ്-ഡിവിഷൻ നയവും ആശ്രയിച്ചിരിക്കുന്നു. സൗജന്യ സർവേയിൽ നിങ്ങളുടെ ടാരിഫ് വിഭാഗത്തിനുള്ള നിലവിലെ നിയമങ്ങൾ ഞങ്ങളുടെ ടീം വിശദീകരിക്കും.',
          },
        ].map(item => (
          <details class="area-faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <p class="area-faq__more">കൂടുതൽ ചോദ്യങ്ങളുണ്ടോ? <a href={`${mlPrefix}/faqs/`}>മുഴുവൻ FAQ നോക്കുക →</a></p>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="area-cta">
    <div class="container area-cta__inner">
      <div>
        <h2>തൃശ്ശൂരിൽ സൗജന്യ സോളാർ സർവേ നേടുക</h2>
        <p>ഞങ്ങളുടെ ടീം തൃശ്ശൂരിൽ നിയമിതമായി വരുന്നു. സൗജന്യ മേൽക്കൂര അസസ്മെന്റ് ബുക്ക് ചെയ്യുക — സൈറ്റ്-സ്പെസിഫിക് സമ്പാദ്യ കണക്ക് കൊണ്ടുവരാം, ബാധ്യതയില്ല, സമ്മർദ്ദമില്ല.</p>
      </div>
      <div class="area-cta__btns">
        <a href={`${mlPrefix}/contact/`} class="btn btn-primary">സൗജന്യ സർവേ ബുക്ക് ചെയ്യുക</a>
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-outline">☀️ ആദ്യം കണക്കാക്കുക</a>
      </div>
    </div>
  </section>

  <!-- Shared blog reading -->
  <section class="area-blog">
    <div class="container">
      <h2 class="section-title">തീരുമാനിക്കും മുമ്പ് ഉപകാരപ്രദമായ ലേഖനങ്ങൾ</h2>
      <div class="area-blog__grid">
        <a href={`${mlPrefix}/blog/pm-surya-ghar-subsidy-guide/`} class="area-blog-card">
          <span class="blog-card-tag">സർക്കാർ പദ്ധതികൾ</span>
          <strong>PM സൂര്യ ഘർ മുഫ്ത് ബിജ്ലി യോജന: പൂർണ്ണ സബ്സിഡി ഗൈഡ്</strong>
          <span class="blog-card-arrow">→</span>
        </a>
        <a href={`${mlPrefix}/blog/kseb-net-metering-rules-2026/`} class="area-blog-card">
          <span class="blog-card-tag">നെറ്റ് മീറ്ററിംഗ്</span>
          <strong>കേരളത്തിലെ നെറ്റ് മീറ്ററിംഗ് നിയമങ്ങൾ 2026-ൽ മാറുന്നു — ഓരോ സോളാർ ഉടമയും അറിയേണ്ടത്</strong>
          <span class="blog-card-arrow">→</span>
        </a>
        <a href={`${mlPrefix}/blog/how-much-does-solar-cost-in-kerala/`} class="area-blog-card">
          <span class="blog-card-tag">വിലയും ധനകാര്യവും</span>
          <strong>കേരളത്തിൽ സോളാർ പാനൽ സിസ്റ്റത്തിന് എത്ര ചെലവ് വരും?</strong>
          <span class="blog-card-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* Shared hero + section styles — same pattern as Kochi page */
.area-hero {
  position: relative; min-height: 500px; display: flex;
  align-items: flex-end; overflow: hidden; padding-bottom: 64px;
}
.area-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; z-index: 0; }
.area-hero__overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(10,25,50,0.92) 0%, rgba(10,25,50,0.55) 50%, rgba(10,25,50,0.2) 100%); }
.area-hero__inner { position: relative; z-index: 2; padding-top: 100px; }
.area-hero__eyebrow { font-size: 0.75rem; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255,255,255,0.65); margin-bottom: 10px; }
.area-hero__title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 500; color: #fff; line-height: 1.2; margin-bottom: 16px; }
.area-hero__sub { font-size: clamp(0.95rem, 2vw, 1.05rem); color: rgba(255,255,255,0.75); max-width: 540px; line-height: 1.75; margin-bottom: 32px; }
.area-hero__ctas { display: flex; flex-wrap: wrap; gap: 14px; }
.btn-outline-light { border: 2px solid rgba(255,255,255,0.7); color: #fff; padding: 13px 28px; border-radius: 50px; font-family: var(--font-heading); font-weight: 500; font-size: 0.95rem; transition: all var(--transition); }
.btn-outline-light:hover { background: rgba(255,255,255,0.15); }
.area-why { padding: var(--section-padding); background: var(--color-light); }
