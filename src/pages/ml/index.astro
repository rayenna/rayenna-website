---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mlPrefix = '/ml';
---
<Layout lang="ml"
  title="കൊച്ചിയിൽ സോളാർ പാനൽ ഇൻസ്റ്റാളേഷൻ | റയെന്ന എനർജി"
  description="റയെന്ന എനർജി — കേരളത്തിലെ MNRE അംഗീകൃത സോളാർ ഇൻസ്റ്റാളർ. PM സൂര്യ ഘർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ സൈറ്റ് സർവേ. +91 7907 369 304."
>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <img src={`${base}/media/hero (1).webp`} alt="Solar energy — child flying a kite" class="hero__photo" />
    <div class="hero__gradient"></div>
    <div class="hero__content">
      <h1 class="hero__title">നിങ്ങളുടെ KSEB ബിൽ<br />₹0 ആകാം.</h1>
      <div class="hero__mid">
        <img src={`${base}/media/Artboard-2mnre.webp`} alt="MNRE Approved Channel Partner — Govt of India" class="mnre-badge-img" />
        <p class="hero__subtitle">കേരളത്തിലെ MNRE അംഗീകൃത സോളാർ ഇൻസ്റ്റാളർ. സർക്കാർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ സൈറ്റ് സർവേ. 3–5 വർഷത്തിൽ നിക്ഷേപം തിരിച്ചെടുക്കാം — പിന്നീട് 20+ വർഷം സൗജന്യ വൈദ്യുതി.</p>
      </div>
      <div class="hero-trust-strip">
        <span>✓ MNRE അംഗീകാരം</span>
        <span>✓ ₹78,000 സബ്സിഡി</span>
        <span>✓ സൗജന്യ സൈറ്റ് സർവേ</span>
        <span>✓ 25 വർഷ വാറന്റി</span>
      </div>
      <div class="hero-cta-wrapper">
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-hero-primary hero-btn-primary">☀️ എന്റെ സമ്പാദ്യം കണക്കാക്കുക</a>
        <a href={`${mlPrefix}/contact/`} class="btn btn-hero-outline hero-btn-secondary">കോൾ ബാക്ക് നേടുക</a>
      </div>
    </div>
  </section>

  <!-- ===== SOLAR POWER INTRO ===== -->
  <section class="solar-intro">
    <div class="container solar-intro__inner">
      <div class="solar-intro__image">
        <img src={`${base}/media/solar-panel-installation.jpg`} alt="Rayenna technician carrying a solar panel for rooftop installation" />
      </div>
      <div class="solar-intro__content">
        <h2 class="section-title">ഇന്ത്യയിൽ ഏറ്റവും കൂടുതൽ സൂര്യപ്രകാശം കേരളത്തിന് ലഭിക്കുന്നു. നിങ്ങൾ ഉപയോഗിക്കുന്നുണ്ടോ?</h2>
        <p>കേരളത്തിൽ വർഷം 300-ലധികം സൂര്യദിനങ്ങൾ. റൂഫ്‌ടോപ്പ് സോളാർ സിസ്റ്റം ദിവസം 6–8 മണിക്കൂർ വൈദ്യുതി ഉത്പാദിപ്പിക്കും — ശരാശരി വീട്ടുകാരുടെ KSEB ബിൽ 70 മുതൽ 80% വരെ കുറയ്ക്കാൻ മതി. ഭൂരിപക്ഷ വീടുകളും 3–5 വർഷത്തിനുള്ളിൽ നിക്ഷേപം തിരിച്ചെടുക്കും; അതിനുശേഷം 20+ വർഷം യഥാർത്ഥത്തിൽ സൗജന്യ വൈദ്യുതി.</p>
        <ul class="solar-intro__bullets">
          <li>
            <span class="bullet-icon">☀️</span>
            <span><strong>₹78,000 വരെ സർക്കാർ സബ്സിഡി</strong> — 3 kW വരെയുള്ള സിസ്റ്റങ്ങളിൽ ചെലവിന്റെ 40% PM സൂര്യ ഘർ പദ്ധതി കവർ ചെയ്യുന്നു</span>
          </li>
          <li>
            <span class="bullet-icon">📉</span>
            <span><strong>KSEB ബിൽ 80% വരെ കുറയ്ക്കാം</strong> — നെറ്റ് മീറ്ററിംഗ് വഴി അധിക യൂണിറ്റുകൾ ഗ്രിഡിലേക്ക് കയറ്റാം</span>
          </li>
          <li>
            <span class="bullet-icon">🔋</span>
            <span><strong>25 വർഷ പാനൽ പെർഫോർമൻസ് വാറന്റി</strong> — Adani, Waaree, Solis പോലുള്ള നിലവാരമുള്ള ബ്രാൻഡുകൾ പരിശീലിത ഇഞ്ചിനീയർമാർ ഇൻസ്റ്റാൾ ചെയ്യുന്നു</span>
          </li>
        </ul>
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-primary solar-intro__cta">☀️ എന്റെ സമ്പാദ്യം കണക്കാക്കുക →</a>
      </div>
    </div>
  </section>

  <!-- ===== WHO WE ARE ===== -->
  <section class="who-we-are">
    <div class="container who-we-are__inner">
      <div class="who-we-are__content">
        <h2 class="section-title">ഞങ്ങൾ ആരാണ്</h2>
        <p>റയെന്ന എനർജി നവീന സോളാർ ഊർജ്ജ പരിഹാരങ്ങളുടെ മുൻനിര ദാതാക്കളാണ് — നിങ്ങൾ ഊർജ്ജം ഉപയോഗിക്കുന്ന രീതി മാറ്റുന്നതിലേക്ക് ഞങ്ങൾ പ്രതിജ്ഞാബദ്ധരാണ്. നേതൃസ്ഥാനത്തിന്റെ അനുഭവവും വിജ്ഞാനവും റയെന്ന എനർജിക്ക് മാത്രമല്ല, വിശ്വസനീയമായ സോളാർ സപ്ലൈയറായി നിൽക്കുന്നതിന്റെ അടിത്തറയുമാണ്. സോളാറിലേക്ക് മാറുന്നത് വൈദ്യുതി ബിൽ ലാഭിക്കൽ മാത്രമല്ല; വരും തലമുറകൾക്ക് ഭൂമിയെ മെച്ചപ്പെടുത്തലാണ്. സുസ്ഥിരത, കാര്യക്ഷമത, സാമ്പത്തികത എന്നിവയ്ക്ക് മുൻഗണന നൽകുന്ന ഉയർന്ന നിലവാരമുള്ള ഇൻസ്റ്റാളേഷനുകൾ വാഗ്ദാനം ചെയ്യുന്നു — പച്ച ഭാവിയിലേക്ക്.</p>
        <a href={`${mlPrefix}/about/`} class="read-more">കൂടുതൽ വായിക്കുക &gt;&gt;</a>
      </div>
      <div class="who-we-are__stats">
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="20">20</span>
            <span class="stat-suffix">+</span>
          </div>
          <p class="stat-label">ബ്രാൻഡുകൾ</p>
        </div>
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="80">80</span>
            <span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">കുറഞ്ഞ ബിൽ</p>
        </div>
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="100">100</span>
            <span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">ഉപഭോക്തൃ സംതൃപ്തി</p>
        </div>
        <a href={`${mlPrefix}/solar-calculator/`} class="stats-cta">☀️ എത്ര സമ്പാദിക്കാം എന്ന് കാണുക →</a>
      </div>
    </div>
  </section>

  <!-- ===== INVEST IN SOLAR ===== -->
  <section class="invest-section">
    <img src={`${base}/media/glass-BG.jpg`} alt="" class="invest-bg" />
    <div class="invest-overlay"></div>
    <div class="container invest-inner">
      <div class="invest-left">
        <h2 class="invest-title">ഇപ്പോഴാണ് സോളാർ പാനലിൽ നിക്ഷേപിക്കാനുള്ള ശരിയായ സമയം</h2>
      </div>
      <div class="invest-cards">
        <div class="invest-card">
          <h3>കൂടുതൽ സാമ്പത്തികം</h3>
          <p>കഴിഞ്ഞ ഇരുപത വർഷത്തിനിടെ സോളാർ പാനൽ വില 80%-ത്തിലധികം കുറഞ്ഞു — ഇന്ന് എളുപ്പത്തിൽ സാധ്യമാണ്.</p>
        </div>
        <div class="invest-card">
          <h3>കൂടുതൽ കാര്യക്ഷമം</h3>
          <p>ആധുനിക സോളാർ പാനലുകളുടെ കാര്യക്ഷമത 22% വരെ — ഊർജ്ജ ഉത്പാദനം പരമാവധി.</p>
        </div>
        <div class="invest-card">
          <h3>കൂടുതൽ ലഭ്യം</h3>
          <p>കേരളത്തിൽ വർഷം 300-ലധികം സൂര്യദിനങ്ങൾ — സോളാർ ഉത്പാദനം തൊടിക്കാൽ ഉയർന്ന നിലയിലാണ്.</p>
        </div>
        <div class="invest-card">
          <h3>സബ്സിഡിയും</h3>
          <p>സർക്കാർ പ്രോത്സാഹനങ്ങളും സബ്സിഡികളും ഇൻസ്റ്റാളേഷൻ ചെലവ് കുറയ്ക്കുന്നു — ഇന്ന് ഒരു ബുദ്ധിമാനായ നിക്ഷേപം.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="testimonials-section">
    <div class="container">
      <div class="testimonials-header">
        <span class="section-tag">ഉപഭോക്തൃ അനുഭവങ്ങൾ</span>
        <h2 class="section-title">കേരളത്തിലെ വീട്ടുടമസ്ഥർ പറയുന്നത്</h2>
        <p class="testimonials-intro">കേരളമെമ്പാടുള്ള യഥാർത്ഥ ഇൻസ്റ്റാളേഷനുകളുടെ ഫലങ്ങൾ. റയെന്ന ഇൻസ്റ്റാൾ ചെയ്യുന്ന ഓരോ സിസ്റ്റത്തിനും 25 വർഷ പെർഫോർമൻസ് വാറന്റിയും പൂർണ്ണ പിന്തുണയും.</p>
      </div>
      <div class="testimonials-grid">

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">ടെക്നിക്കൽ, ഇംപ്ളിമെന്റേഷൻ ടീമുകൾ വളരെ സഹായകരായിരുന്നു — അവര്‍ക്ക് നല്ല അറിവും ഉണ്ടായിരുന്നു. ഞാൻ കിച്ചൺ സ്റ്റോവുകൾ LPG-യിൽ നിന്ന് ഇൻഡക്ഷനിലേക്ക് മാറ്റി; വൈദ്യുതി ചാർജ് മാത്രമല്ല, LPG ഉപഭോഗവും കുറഞ്ഞു.</p>
          <div class="tcard__author">
            <div class="tcard__avatar">AR</div>
            <div>
              <strong>Arun</strong>
              <span>കൊല്ലം · 5 kW സിസ്റ്റം</span>
            </div>
          </div>
        </div>

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">ഇംപ്ളിമെന്റേഷൻ മുഴുവനും റയെന്ന ടീം വളരെ സഹായകരും പിന്തുണ നൽകിയിരുന്നു. വളരെ മത്സരാധിഷ്ഠിത നിരക്കിൽ പ്രോജക്റ്റ് പൂർത്തിയാക്കി — മൊത്തത്തില്‍ മികച്ച മൂല്യം.</p>
          <div class="tcard__author">
            <div class="tcard__avatar">SU</div>
            <div>
              <strong>Sudheer</strong>
              <span>എറണാകുളം · 3 kW സിസ്റ്റം</span>
            </div>
          </div>
        </div>

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">ടീമിന്റെ സമീപനവും പ്രൊഫഷണലിസവും എനിക്ക് ഇഷ്ടപ്പെട്ടു. വളരെ സഹായകരവും അറിവുള്ളവരും, വിലയിലും ഏറെ മത്സരാധിഷ്ഠിതവും. ആഫ്റ്റർ സെയിൽസ് പിന്തുണയും മികച്ചതാണ്. എന്റെ പല ബന്ധുക്കൾക്കും ഞാൻ ഇതിനകം ശുപാർശ ചെയ്തിട്ടുണ്ട്.</p>
          <div class="tcard__author">
            <div class="tcard__avatar">BJ</div>
            <div>
              <strong>Baiju</strong>
              <span>എറണാകുളം · 10 kW സിസ്റ്റം</span>
            </div>
          </div>
        </div>

      </div>
      <div class="testimonials-footer">
        <a href={`${mlPrefix}/media/`} class="btn btn-outline">ഞങ്ങളുടെ ഇൻസ്റ്റാളേഷനുകൾ കാണുക →</a>
      </div>
    </div>
  </section>

  <!-- ===== CHOOSING THE RAYENNA WAY ===== -->
  <section class="rayenna-way">
    <div class="container rayenna-way__inner">
      <div class="rayenna-way__image">
        <img src={`${base}/media/Hardshell-solar.webp`} alt="Rayenna solar quality" />
      </div>
      <div class="rayenna-way__content">
        <h2 class="section-title">റയെന്ന വഴി തിരഞ്ഞെടുക്കൽ</h2>
        <p>റയെന്നിൽ ഗുണനിലവാരമാണ് ഞങ്ങളുടെ മുൻഗണന. മികച്ച മെറ്റീരിയലുകൾ മാത്രം ഉപയോഗിച്ച് ഓരോ സോളാർ സിസ്റ്റവും വിശ്വസനീയതയ്ക്കും ദീർഘകാല പ്രകടനത്തിനും വേണ്ടി നിർമ്മിക്കുന്നു. ഡിസൈൻ മുതൽ ഇൻസ്റ്റാളേഷൻ വരെ നിങ്ങളുടെ ആവശ്യങ്ങൾക്കനുസരിച്ച് സേവനങ്ങൾ ക്രമീകരിക്കുന്നു; ഓരോ ഘട്ടത്തിലും കൃത്യതയും സമയബന്ധിതത്വവും. ഓൺലൈൻ മോണിറ്ററിംഗ് സിസ്റ്റങ്ങൾ വഴി തത്സമയ അപ്ഡേറ്റുകളും ആവശ്യമുള്ളപ്പോൾ വേഗത്തിലുള്ള പരിപാലനവും — ഇൻസ്റ്റാളേഷിന് ശേഷവും പിന്തുണ അനുഭവിക്കാം. മികച്ച മാനദണ്ഡങ്ങളിലും സുഗമമായ സേവനത്തിലും ഞങ്ങളുടെ പ്രതിബദ്ധത സോളാർ വൈദ്യുതിയെ എളുപ്പവും തടസ്സമില്ലാത്തതും സാമ്പത്തികവുമായ തിരഞ്ഞെടുപ്പാക്കുന്നു.</p>
      </div>
    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section class="process-section">
    <div class="container">
      <div class="text-center" style="margin-bottom:56px">
