---
import Layout from '../../layouts/Layout.astro';
import CorporateVideoSection from '../../components/CorporateVideoSection.astro';
import { useTranslations } from '../../i18n/ui';
import { OG } from '../../i18n/og-images';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mlPrefix = '/ml';
const t = useTranslations('ml');
---
<Layout lang="ml"
  title="കേരളത്തിൽ സോളാർ ഇൻസ്റ്റാളേഷൻ | റയെന്ന എനർജി"
  description="റയെന്ന എനർജി — കേരളമെമ്പാടും MNRE അംഗീകൃത സോളാർ ഇൻസ്റ്റാളർ. PM സൂര്യ ഘർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ സൈറ്റ് സർവേ. +91 7907 369 304."
  ogUpdatedTime="2026-06-07T10:00:00+05:30"
  ogImage={OG.home}
>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <img src={`${base}/media/hero (1).webp`} alt="സോളാർ ഊർജ്ജം — കുട്ടി പട്ടം പറക്കുന്നു" class="hero__photo" />
    <div class="hero__gradient"></div>
    <div class="hero__content">
      <h1 class="hero__title">
        <span class="hero__title-line1">നിങ്ങളുടെ KSEB ബിൽ</span>
        <span class="hero__title-line2">₹0 ആകാം.</span>
      </h1>
      <div class="hero__mid">
        <img src={`${base}/media/Artboard-2mnre.webp`} alt={t.images.mnreBadgeAlt} class="mnre-badge-img" />
        <div class="hero__mid-copy">
          <p class="hero__subtitle">കേരളത്തിലെ MNRE അംഗീകൃത സോളാർ ഇൻസ്റ്റാളർ. സർക്കാർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ സൈറ്റ് പരിശോധന. 3–5 വർഷത്തിനുള്ളിൽ നിക്ഷേപം തിരിച്ചെടുക്കാം — അതിനുശേഷം 25+ വർഷം ശുദ്ധമായ സൗജന്യ വൈദ്യുതി.</p>
          <div class="hero-trust-strip">
            <span>✓ MNRE അംഗീകാരം</span>
            <span>✓ ₹78,000 സബ്സിഡി</span>
            <span>✓ സൗജന്യ സൈറ്റ് സർവേ</span>
            <span>✓ 25 വർഷ വാറന്റി</span>
          </div>
        </div>
      </div>
      <div class="hero-cta-wrapper">
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-hero-primary hero-btn-primary">☀️ എന്റെ സമ്പാദ്യം കണക്കാക്കുക</a>
        <a href={`${mlPrefix}/contact/`} class="btn btn-hero-outline hero-btn-secondary">കോൾ ബാക്ക് നേടുക</a>
      </div>
      <p class="hero-cta-micro">{t.homeConvert.heroMicro}</p>
      <p class="hero-phone-cta">
        {t.homeConvert.heroPhone}{' '}
        <a href="tel:+917907369304" data-analytics-location="home_hero">+91 7907 369 304</a>
      </p>
    </div>
  </section>

  <!-- ===== SOLAR POWER INTRO ===== -->
  <section class="solar-intro">
    <div class="container solar-intro__inner">
      <div class="solar-intro__image">
        <img src={`${base}/media/solar-panel-installation.jpg`} alt="മേൽക്കൂര ഇൻസ്റ്റാളേഷനായി സോളാർ പാനൽ കൊണ്ടുപോകുന്ന റയെന്ന ടെക്നീഷ്യൻ" />
      </div>
      <div class="solar-intro__content">
        <h2 class="section-title">ഇന്ത്യയിൽ ഏറ്റവും കൂടുതൽ വെയിൽ കേരളത്തിനാണ്. പിന്നെ എന്തുകൊണ്ടാണ് നിങ്ങൾ ഇനിയും അത് ഉപയോഗിക്കാത്തത്?</h2>
        <p>കേരളത്തിൽ 300-ലധികം സൂര്യദിനങ്ങൾ — ആ ഊർജ്ജം നിങ്ങൾ ഇനിയും KSEB-ന് സൗജന്യമായി നൽകുകയാണോ? ഒരു മേൽക്കൂര സോളാർ സിസ്റ്റം ദിവസം 6–8 മണിക്കൂർ വൈദ്യുതി ഉത്പാദിപ്പിക്കും — KSEB ബിൽ 70 മുതൽ 80% വരെ കുറയ്ക്കാൻ അത് ധാരാളം മതി. 3–5 വർഷത്തിനുള്ളിൽ നിക്ഷേപം തിരിച്ചെടുക്കാം. അതിനുശേഷം 25+ വർഷം ശുദ്ധമായ സൗജന്യ വൈദ്യുതി.</p>
        <ul class="solar-intro__bullets">
          <li>
            <span class="bullet-icon">☀️</span>
            <span><strong>₹78,000 വരെ സർക്കാർ സബ്സിഡി</strong> — 3 kW വരെയുള്ള സിസ്റ്റങ്ങളിൽ ചെലവിന്റെ 40% PM സൂര്യ ഘർ പദ്ധതി കവർ ചെയ്യുന്നു</span>
          </li>
          <li>
            <span class="bullet-icon">📉</span>
            <span><strong>KSEB ബിൽ 80% വരെ കുറയ്ക്കാം</strong> — നെറ്റ് മീറ്ററിംഗ് വഴി അധിക യൂണിറ്റുകൾ ഗ്രിഡിലേക്ക് കയറ്റാം</span>
          </li>
          <li>
            <span class="bullet-icon">🔋</span>
            <span><strong>25 വർഷ പാനൽ പെർഫോർമൻസ് വാറന്റി</strong> — Adani, Waaree, Solis പോലുള്ള നിലവാരമുള്ള ബ്രാൻഡുകൾ പരിശീലിത ഇഞ്ചിനീയർമാർ ഇൻസ്റ്റാൾ ചെയ്യുന്നു</span>
          </li>
        </ul>
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-primary solar-intro__cta">☀️ എന്റെ സമ്പാദ്യം കണക്കാക്കുക →</a>
      </div>
    </div>
  </section>

  <!-- ===== WHO WE ARE ===== -->
  <section class="who-we-are">
    <div class="container who-we-are__inner">
      <div class="who-we-are__content">
        <h2 class="section-title">ആരാണ് ഞങ്ങൾ</h2>
        <p>ഞങ്ങൾ വെറും സോളാർ കമ്പനിയല്ല — കേരളത്തിലെ ഉപഭോക്താക്കളെ ഊർജ്ജ സ്വതന്ത്രരാക്കുന്നതിനായി പ്രതിജ്ഞാബദ്ധമായ ഒരു ടീമാണ്. സോളാറിലേക്ക് മാറുന്നത് ബിൽ കുറയ്ക്കൽ മാത്രമല്ല — അത് നിങ്ങളുടെ കുടുംബത്തിനും വരും തലമുറകൾക്കും ഒരു മുതൽക്കൂട്ടാണ്. സുസ്ഥിരത, കാര്യക്ഷമത, താങ്ങാനാവുന്ന വില — ഈ മൂന്ന് തത്ത്വങ്ങൾ ഞങ്ങളുടെ ഓരോ ഇൻസ്റ്റാളേഷന്റെയും അടിത്തറയാണ്.</p>
        <a href={`${mlPrefix}/about/`} class="read-more">കൂടുതൽ വായിക്കുക &gt;&gt;</a>
      </div>
      <div class="who-we-are__stats">
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="20">20</span>
            <span class="stat-suffix">+</span>
          </div>
          <p class="stat-label">ബ്രാൻഡുകൾ</p>
        </div>
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="80">80</span>
            <span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">കുറഞ്ഞ ബിൽ</p>
        </div>
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="100">100</span>
            <span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">ഉപഭോക്തൃ സംതൃപ്തി</p>
        </div>
        <a href={`${mlPrefix}/solar-calculator/`} class="stats-cta">☀️ എത്ര സമ്പാദിക്കാം എന്ന് കാണുക →</a>
      </div>
    </div>
  </section>

  <CorporateVideoSection lang="ml" aboutHref={`${mlPrefix}/about/`} />

  <!-- ===== INVEST IN SOLAR ===== -->
  <section class="invest-section">
    <img src={`${base}/media/glass-BG.jpg`} alt="" class="invest-bg" />
    <div class="invest-overlay"></div>
    <div class="container invest-inner">
      <div class="invest-left">
        <h2 class="invest-title">ഇന്നാണ് സോളാർ തിരഞ്ഞെടുക്കാനുള്ള ഏറ്റവും നല്ല സമയം</h2>
      </div>
      <div class="invest-cards">
        <div class="invest-card">
          <h3>ഇന്ന് ഏറ്റവും താങ്ങാനാവുന്നത്</h3>
          <p>കഴിഞ്ഞ ഇരുപത് വർഷത്തിൽ സോളാർ പാനൽ വില 80%-ലധികം കുറഞ്ഞു. ഒരിക്കൽ ആഡംബരമായിരുന്നത് ഇന്ന് ഏത് വീടിനും കൈയ്യെത്തുന്ന ദൂരത്താണ്.</p>
        </div>
        <div class="invest-card">
          <h3>ഇന്ന് ഏറ്റവും കാര്യക്ഷമം</h3>
          <p>ആധുനിക പാനലുകൾ 22% വരെ കാര്യക്ഷമത നൽകുന്നു — അതായത് ഓരോ തുള്ളി വെയിലും കൂടുതൽ വൈദ്യുതിയായി മാറുന്നു.</p>
        </div>
        <div class="invest-card">
          <h3>300 ദിവസം വെയിൽ — പൂർണ്ണമായി ഉപയോഗിക്കൂ</h3>
          <p>കേരളത്തിൽ വർഷം 300-ലധികം സൂര്യദിനങ്ങൾ. ആ ഊർജ്ജം KSEB-ന് സൗജന്യമായി നൽകുന്നത് ഇനി നിർത്താം.</p>
        </div>
        <div class="invest-card">
          <h3>സർക്കാർ സബ്സിഡി — ₹78,000 വരെ</h3>
          <p>PM സൂര്യ ഘർ പദ്ധതി വഴി ഇൻസ്റ്റാളേഷൻ ചിലവ് ഗണ്യമായി കുറയുന്നു. ഇന്ന് സോളാർ ഒരു ബുദ്ധിപൂർവ്വമായ സാമ്പത്തിക തീരുമാനം കൂടിയാണ്.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== INSTALLATIONS PREVIEW ===== -->
  <section class="installs-preview">
    <div class="container">
      <div class="installs-preview__header">
        <div>
          <span class="section-tag">യഥാർത്ഥ ഇൻസ്റ്റാളേഷനുകൾ</span>
          <h2 class="section-title">സോളാർ — മനോഹരമായി</h2>
          <p class="installs-preview__sub">ഗാലറിയിലെ ഓരോ സിസ്റ്റവും റയെന്ന ടീം ഡിസൈൻ ചെയ്ത്, ഇൻസ്റ്റാൾ ചെയ്ത്, ഏറ്റവും ഉയർന്ന നിലവാരത്തിൽ കമ്മിഷൻ ചെയ്തതാണ്. ഓരോ ചിത്രവും ഒരു കഥ പറയുന്നു.</p>
        </div>
        <a href={`${mlPrefix}/media/`} class="btn btn-outline installs-view-all">എല്ലാ ഇൻസ്റ്റാളേഷനുകളും കാണുക →</a>
      </div>
      <div class="installs-grid">
        {[
          { name: 'Byju George',   location: 'Thevara',    cap: '10 kW', img: 'BYJU-GEORGE10KWTHEVARA-SOLIS-INVERTER-PANELS-WAAREE-1.jpeg' },
          { name: 'Jelees',        location: 'Mahe',       cap: '5 kW',  img: 'JELEESMAHE5KW-FESTON-INVERTER-PANELS-WAAREE-1.jpeg' },
          { name: 'Hyder',         location: 'Edapally',   cap: '5 kW',  img: 'HYDEREDAPALLY5KW-SOLIS-INVERTER-PANELS-WAAREE.jpeg' },
          { name: 'Angelo Thomas', location: 'Edapally',   cap: '10 kW', img: 'ANGELO-THOMAS-EDAPALLY-10KW-SOLIS-INVERTER-PANELS-WAAREE.png' },
        ].map(item => (
          <div class="install-card">
            <img src={`${base}/media/references/${item.img}`} alt={`${item.name}, ${item.location} — ${item.cap} സോളാർ ഇൻസ്റ്റാളേഷൻ`} loading="lazy" />
            <div class="install-card__overlay">
              <strong>{item.name}</strong>
              <span>{item.location} · {item.cap} സിസ്റ്റം</span>
            </div>
          </div>
        ))}
      </div>
      <div class="installs-mobile-cta">
        <a href={`${mlPrefix}/media/`} class="btn btn-outline">എല്ലാ ഇൻസ്റ്റാളേഷനുകളും കാണുക →</a>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="testimonials-section">
    <div class="container">
      <div class="testimonials-header">
        <span class="section-tag">ഉപഭോക്തൃ അനുഭവങ്ങൾ</span>
        <h2 class="section-title">കേരളത്തിലെ വീട്ടുടമസ്ഥർ പറയുന്നത്</h2>
        <p class="testimonials-intro">കേരളമെമ്പാടുള്ള യഥാർത്ഥ ഇൻസ്റ്റാളേഷനുകളുടെ ഫലങ്ങൾ. റയെന്ന ഇൻസ്റ്റാൾ ചെയ്യുന്ന ഓരോ സിസ്റ്റത്തിനും 25 വർഷ പെർഫോർമൻസ് വാറന്റിയും പൂർണ്ണ പിന്തുണയും.</p>
      </div>
      <div class="testimonials-grid">

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">റയെന്ന ടീം — ഒന്നൊന്നര തന്നെ. അറിവും സഹായ മനോഭാവവും ഒരുപോലെ. സോളാർ വന്നതിനുശേഷം ഞാൻ സ്റ്റൗ ഇൻഡക്ഷനിലേക്ക് മാറ്റി — KSEB ബിൽ കുറഞ്ഞു, LPG ഉപഭോഗവും കുറഞ്ഞു. രണ്ടും ഒരുമിച്ച് ലാഭം!</p>
          <div class="tcard__author">
            <div class="tcard__avatar">AR</div>
            <div>
              <strong>Arun</strong>
              <span>കൊല്ലം · 5 kW സിസ്റ്റം</span>
            </div>
          </div>
        </div>

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">തുടക്കം മുതൽ അവസാനം വരെ റയെന്ന ടീം ഒപ്പം നിന്നു — ഒരു ടെൻഷനും ഇല്ലാതെ. വില കേട്ടപ്പോൾ ഞാൻ ആദ്യം അത്ഭുതപ്പെട്ടു — ഇത്ര നല്ല സർവീസിന് ഇത്രയും കുറഞ്ഞ നിരക്കോ? പൈസ ഈടാക്കുന്നതിലും കൂടുതൽ മൂല്യം തരുന്ന ടീം.</p>
          <div class="tcard__author">
            <div class="tcard__avatar">SU</div>
            <div>
              <strong>Sudheer</strong>
              <span>എറണാകുളം · 3 kW സിസ്റ്റം</span>
            </div>
          </div>
        </div>

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
