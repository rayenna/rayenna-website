  { img: 'MISHA-LAL-PALLURUTHY-3KW-POLYCAB-INVERTER-PANELS-ADANI.png', caption: 'Misha Lal — Palluruthy',           sub: specSub('3 kW', 'Polycab', 'Adani') },
