}
.page-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(8, 20, 45, 0.95) 0%,
    rgba(8, 20, 45, 0.55) 55%,
    rgba(8, 20, 45, 0.15) 100%
