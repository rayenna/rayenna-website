  width: 100%;
  justify-content: center;
  min-height: 52px;
}

/* ===== GALLERY SECTION ===== */
.gallery-section {
  padding: var(--section-padding);
  background: var(--color-light);
}

/* ── Filter Bar ── */
.gallery-filters {
  margin-bottom: 36px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.gf-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.gf-group--accordion {
  border: 1px solid rgba(39, 50, 79, 0.1);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  background: #fff;
}
.gf-group--accordion > summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.gf-group--accordion > summary::-webkit-details-marker {
  display: none;
}
.gf-group--accordion > summary::after {
  content: '+';
  font-size: 1.1rem;
  color: var(--color-primary);
  font-weight: 700;
}
.gf-group--accordion[open] > summary::after {
  content: '−';
}
.gf-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--color-text-muted);
}
.gf-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.gf-pill {
  border: 1.5px solid rgba(39,50,79,0.15);
  background: #fff;
  border-radius: 99px;
  padding: 6px 14px;
  font-family: var(--font-body);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--color-text-muted);
