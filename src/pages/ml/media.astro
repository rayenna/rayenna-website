</style>

<script>
  const INTERVAL = 4500;
  const slideshow = document.getElementById('slideshow');
  const slides = slideshow ? Array.from(slideshow.querySelectorAll('.slide')) : [];
  const dots = slideshow ? Array.from(slideshow.querySelectorAll('.dot')) : [];
  const progress = document.getElementById('ss-progress');
  let current = 0;
  let timer;

  function goTo(n) {
    if (!slides.length) return;
    slides[current].classList.remove('slide--active');
    if (dots[current]) dots[current].classList.remove('dot--active');
    current = (n + slides.length) % slides.length;
    slides[current].classList.add('slide--active');
    if (dots[current]) dots[current].classList.add('dot--active');
    restartProgress();
  }

  function restartProgress() {
    if (!progress) return;
    progress.style.transition = 'none';
    progress.style.width = '0%';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        progress.style.transition = `width ${INTERVAL}ms linear`;
        progress.style.width = '100%';
      });
    });
  }

  function startAuto() {
    if (!slides.length) return;
    clearInterval(timer);
    timer = setInterval(() => goTo(current + 1), INTERVAL);
  }

  document.getElementById('ss-prev')?.addEventListener('click', () => { goTo(current - 1); startAuto(); });
  document.getElementById('ss-next')?.addEventListener('click', () => { goTo(current + 1); startAuto(); });

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { goTo(i); startAuto(); });
  });

  slideshow?.addEventListener('mouseenter', () => clearInterval(timer));
  slideshow?.addEventListener('mouseleave', () => startAuto());

  let touchStartX = 0;
  slideshow?.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  slideshow?.addEventListener('touchend', (e) => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) { goTo(current + (diff > 0 ? 1 : -1)); startAuto(); }
  });

  if (slides.length) {
    restartProgress();
    startAuto();
    const firstSlideImg = slideshow.querySelector('.slide--active img');
    if (firstSlideImg) {
      if (firstSlideImg.complete) {
        slideshow.classList.add('loaded');
      } else {
        firstSlideImg.addEventListener('load', () => slideshow.classList.add('loaded'), { once: true });
      }
    }
  }

  // ── Gallery Filters ────────────────────────────────────────────────────────
  const filters = { cap: 'all', inv: 'all', pan: 'all' };
  const cards = Array.from(document.querySelectorAll('.gallery-card'));
  const countEl = document.getElementById('gf-count');
  const emptyEl = document.getElementById('gf-empty');
  const installTotal = Number(countEl?.dataset.total || cards.length);

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const match =
        (filters.cap === 'all' || card.dataset.cap === filters.cap) &&
        (filters.inv === 'all' || card.dataset.inv === filters.inv) &&
        (filters.pan === 'all' || card.dataset.pan === filters.pan);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (countEl) {
      countEl.textContent = filters.cap === 'all' && filters.inv === 'all' && filters.pan === 'all'
        ? `എല്ലാ ${installTotal} ഇൻസ്റ്റാളേഷനുകളും കാണിക്കുന്നു`
        : `${installTotal}-ൽ നിന്ന് ${visible} ഇൻസ്റ്റാളേഷനുകൾ കാണിക്കുന്നു`;
    }
    if (emptyEl) emptyEl.style.display = visible === 0 ? 'block' : 'none';
  }

  document.querySelectorAll('.gf-pill').forEach((pill) => {
    pill.addEventListener('click', () => {
      const type = pill.dataset.type;
      const val = pill.dataset.val;
      if (!type || !val) return;
      filters[type] = val;
      document.querySelectorAll(`.gf-pill[data-type="${type}"]`).forEach((p) => {
        p.classList.toggle('gf-pill--active', p.dataset.val === val);
      });
      applyFilters();
    });
  });

  document.getElementById('gf-reset')?.addEventListener('click', () => {
    filters.cap = 'all';
    filters.inv = 'all';
    filters.pan = 'all';
    document.querySelectorAll('.gf-pill').forEach((p) => {
      p.classList.toggle('gf-pill--active', p.dataset.val === 'all');
    });
    applyFilters();
  });

  // ── Video Library ──────────────────────────────────────────────────────────
  const vlPlayer = document.getElementById('vl-player');
  const vlPlayerFrame = document.getElementById('vl-player-frame');
  const vlPlaceholder = document.getElementById('vl-placeholder');
  const vlTitle = document.getElementById('vl-title');
  const vlBadge = document.getElementById('vl-badge');
  const vlCards = Array.from(document.querySelectorAll('.vl-card'));
  const vlTabs = Array.from(document.querySelectorAll('.vl-tab'));

  function revealFeaturedPlayer() {
    vlPlaceholder?.classList.add('is-hidden');
    vlPlayerFrame?.classList.add('is-playing');
    if (vlPlayer && !vlPlayer.hasAttribute('controls')) {
      vlPlayer.setAttribute('controls', '');
    }
  }

  function playFeaturedVideo(src) {
    if (!vlPlayer || !src) return;

    revealFeaturedPlayer();

    const activeSrc = vlPlayer.dataset.activeSrc || '';
    if (activeSrc !== src) {
      vlPlayer.pause();
      vlPlayer.removeAttribute('poster');
      vlPlayer.src = src;
      vlPlayer.dataset.activeSrc = src;
      vlPlayer.load();
    }

    const playPromise = vlPlayer.play();
    if (playPromise) playPromise.catch(() => {});
  }

  vlCards.forEach((card) => {
    card.addEventListener('click', () => {
      const src = card.dataset.src ?? '';
      const title = card.dataset.title ?? '';
      const badge = card.dataset.badge ?? '';
      const badgeCat = card.dataset.badgecat ?? '';
      playFeaturedVideo(src);

      vlCards.forEach((c) => c.classList.remove('vl-card--playing'));
      card.classList.add('vl-card--playing');

      if (vlTitle) vlTitle.textContent = title;
      if (vlBadge) {
        vlBadge.textContent = badge;
        vlBadge.className = `vl-badge vl-badge--${badgeCat}`;
      }

      document.getElementById('vl-featured')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  vlTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const cat = tab.dataset.cat ?? 'all';

      vlTabs.forEach((t) => {
        t.classList.remove('vl-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('vl-tab--active');
      tab.setAttribute('aria-selected', 'true');

      vlCards.forEach((card) => {
        const show = cat === 'all' || card.dataset.cat === cat;
        card.classList.toggle('vl-card--hidden', !show);
      });
    });
  });
</script>
