function videoUrl(file: string): string {
  return `${base}/media/${file.split('/').map((p) => encodeURIComponent(p)).join('/')}`;
}

function categoryLabel(cat: string): string {
  const labels: Record<string, string> = {
    customer:  'ഉപഭോക്തൃ കഥകൾ',
    promo:     'എന്തുകൊണ്ട് സോളാർ?',
    brand:     'ബ്രാൻഡ് & വീക്ഷണം',
    solutions: 'പരിഹാരങ്ങൾ',
    expert:    'വിദഗ്ധ അഭിപ്രായങ്ങൾ',
  };
  return labels[cat] ?? cat;
}

