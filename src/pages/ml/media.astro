  { img: 'SATHYA DINESHAN-ALAPPUZHA-3KW-DEYE-INVERTER-PANELS-ADANI.jpeg', caption: 'Sathya Dineshan — Alappuzha',   sub: specSub('3 kW', 'Deye', 'Adani') },
  { img: 'SUJI JOSE-PANANGAD-3KW-DEYE-INVERTER-PANELS-ADANI.jpeg',     caption: 'Suji Jose — Panangad',             sub: specSub('3 kW', 'Deye', 'Adani') },
  { img: 'NISHA NARENDRAN-VADUTHALA-3KW-EASTMAN-INVERTER-PANELS-ADANI.jpeg', caption: 'Nisha Narendran — Vaduthala', sub: specSub('3 kW', 'Eastman', 'Adani') },
  { img: 'SAJEEVAN KV-VADUTHALA-3KW-EASTMAN-INVERTER-PANELS-ADANI.jpeg', caption: 'Sajeevan KV — Vaduthala',        sub: specSub('3 kW', 'Eastman', 'Adani') },
  { img: 'SNOBY BABU-THRIKKAKKARA-5KW-DEYE-INVERTER-PANELS-ADANI.jpeg',  caption: 'Snoby Babu — Thrikkakkara',       sub: specSub('5 kW', 'Deye', 'Adani') },
  { img: 'SIBU KS-UDAYAMPEROOR-4KW-SUNWAYS-INVERTER-PANELS-WAAREE.jpeg', caption: 'Sibu KS — Udayamperoor',          sub: specSub('4 kW', 'Sunways', 'Waaree') },
  { img: 'SMITHA VINEESH-PALLURUTHY-3KW-DEYE-INVERTER-PANELS-ADANI.jpeg', caption: 'Smitha Vineesh — Palluruthy',   sub: specSub('3 kW', 'Deye', 'Adani') },
  { img: 'RAJESH-KG-CHERAI-3KW-DEYE-INVERTER-PANELS-ADANI.jpeg',         caption: 'Rajesh K.G. — Cherai',           sub: specSub('3 kW', 'Deye', 'Adani') },
  { img: 'SUDHEER-KR-NJARAKKAL-3KW-SOLIS-INVERTER-PANELS-ADANI.jpeg',    caption: 'Sudheer K.R. — Njarakkal',       sub: specSub('3 kW', 'Solis', 'Adani') },
  { img: 'DHANYA V T-THOPPUMPADY-5KW-EASTMAN-INVERTER-PANELS-ADANI.jpeg',  caption: 'Dhanya V.T. — Thoppumpady', sub: specSub('5 kW', 'Eastman', 'Adani') },
  { img: 'DINHAR V R-EROOR-4KW-SUNWAYS-INVERTER-PANELS-WAAREE.jpeg',      caption: 'Dinhar V.R. — Eroor',       sub: specSub('4 kW', 'Sunways', 'Waaree') },
  { img: 'RADHA P K-THEVARA-5KW-EASTMAN-INVERTER-PANELS-EMMVEE.jpeg',     caption: 'Radha P.K. — Thevara',      sub: specSub('5 kW', 'Eastman', 'Emmvee') },
  { img: 'RANJIT RAJ-THEVARA-3KW-EASTMAN-INVERTER-PANELS-WAAREE.jpeg',    caption: 'Ranjit Raj — Thevara',      sub: specSub('3 kW', 'Eastman', 'Waaree') },
  { img: 'SWAPNA BIJU-EROOR-4KW-SUNWAYS-INVERTER-PANELS-WAAREE.jpeg',     caption: 'Swapna Biju — Eroor',       sub: specSub('4 kW', 'Sunways', 'Waaree') },
  { img: 'BABU-NORTH-PARAVUR-5KW-POLYCAB-INVERTER-PANELS-ADANI.jpeg',    caption: 'Babu — North Paravur',           sub: specSub('5 kW', 'Polycab', 'Adani') },
  { img: 'SABU-VARAPUZHA-3KW-DEYE-HYBRID-INVERTER-PANELS-ADANI.jpeg',    caption: 'Sabu — Varapuzha',               sub: specSub('3 kW', 'Deye Hybrid', 'Adani') },
];

const imageGallerySchema = {
  '@type': 'ImageGallery',
  '@id': `${siteUrl}/ml/media/#gallery`,
  'name': 'റയെന്ന എനർജി കേരളത്തിലെ സോളാർ ഇൻസ്റ്റാളേഷനുകൾ',
  'description': 'കേരളമെമ്പാടും റയെന്ന എനർജി പൂർത്തിയാക്കിയ സോളാർ ഇൻസ്റ്റാളേഷനുകൾ.',
  'url': `${siteUrl}/ml/media/`,
  'associatedMedia': installations.map((inst) => ({
    '@type': 'ImageObject',
    'contentUrl': `${siteUrl}/media/references/${inst.img}`,
    'name': `${inst.name} — ${inst.location} · ${inst.capacity} സോളാർ ഇൻസ്റ്റാളേഷൻ`,
    'description': `${inst.location} — ${inst.capacity}, ${inst.inverter} ഇൻവർട്ടർ, ${inst.panels} പാനലുകൾ.`,
  })),
};

const videoLibrarySchema = buildVideoLibrarySchema(siteUrl, videos, `${siteUrl}/ml/media/`);
const installCount = installations.length;
---
<Layout
  lang="ml"
  title="സോളാർ ഇൻസ്റ്റാളേഷൻ ഗാലറി & വീഡിയോകൾ | റയെന്ന എനർജി കേരളം"
  description="കൊച്ചി, എറണാകുളം, കേരളമെമ്പാടുമുള്ള റയെന്ന എനർജിയുടെ സോളാർ ഇൻസ്റ്റാളേഷൻ ഗാലറി — വീട്ടുപയോഗ, കമർഷ്യൽ പ്രോജക്ടുകൾ. ഇൻസ്റ്റാളേഷൻ വീഡിയോകളും ഉപഭോക്തൃ അഭിപ്രായങ്ങളും കാണുക."
  ogImage={OG.media}
  schema={[imageGallerySchema, videoLibrarySchema]}
>

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <img
      src={`${base}/media/references/Gemini_Generated_Image_14u7k214u7k214u7.png`}
      alt="റയെന്ന എനർജി സോളാർ ഇൻസ്റ്റാളേഷനുകൾ"
      class="page-hero__bg"
    />
    <div class="page-hero__overlay"></div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow">പോർട്ട്ഫോളിയോ</p>
      <h1 class="page-hero__title">കേരളമെമ്പാടും<br />സോളാർ ഇൻസ്റ്റാളേഷനുകൾ</h1>
      <p class="page-hero__sub">യഥാർത്ഥ ഇൻസ്റ്റാളേഷനുകൾ. യഥാർത്ഥ സമ്പാദ്യം. കേരളത്തിലെ പൂർത്തിയാക്കിയ പ്രോജക്റ്റുകൾ.</p>
      <div class="page-hero__actions">
        <a href="#gallery-section" class="btn btn-primary">ഇൻസ്റ്റാളേഷനുകൾ കാണുക</a>
        <a href="#video-library" class="btn btn-outline-white">വീഡിയോകൾ കാണുക</a>
      </div>
    </div>
  </section>


  <!-- ===== INSTALLATION GALLERY ===== -->
  <section class="gallery-section" id="gallery-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">ഇൻസ്റ്റാളേഷൻ ഗാലറി</span>
        <h2 class="section-title">പൂർത്തിയാക്കിയ പ്രോജക്റ്റുകൾ</h2>
        <p class="section-intro">ഓരോ ഇൻസ്റ്റാളേഷനും ഒരു വാഗ്ദാനമാണ് — മികച്ച ഘടകങ്ങൾ, കൃത്യമായ ഇൻസ്റ്റാളേഷൻ, ഹരിത കേരളത്തിലേക്കുള്ള ഒരു ചുവട്.</p>
      </div>

      <!-- ── Filter Bar ── -->
      <div class="gallery-filters" id="gallery-filters">
        <details class="gf-group gf-group--accordion" open>
          <summary class="gf-label">സിസ്റ്റം വലിപ്പം</summary>
          <div class="gf-pills">
            <button class="gf-pill gf-pill--active" data-type="cap" data-val="all">എല്ലാം</button>
            <button class="gf-pill" data-type="cap" data-val="3 kW">3 kW</button>
            <button class="gf-pill" data-type="cap" data-val="4 kW">4 kW</button>
            <button class="gf-pill" data-type="cap" data-val="5 kW">5 kW</button>
            <button class="gf-pill" data-type="cap" data-val="10 kW">10 kW</button>
            <button class="gf-pill" data-type="cap" data-val="15 kW">15 kW</button>
          </div>
        </details>
        <details class="gf-group gf-group--accordion" open>
          <summary class="gf-label">ഇൻവർട്ടർ</summary>
          <div class="gf-pills">
            <button class="gf-pill gf-pill--active" data-type="inv" data-val="all">എല്ലാം</button>
            <button class="gf-pill" data-type="inv" data-val="Deye">Deye</button>
            <button class="gf-pill" data-type="inv" data-val="Deye Hybrid">Deye Hybrid</button>
            <button class="gf-pill" data-type="inv" data-val="Eastman">Eastman</button>
            <button class="gf-pill" data-type="inv" data-val="Feston">Feston</button>
            <button class="gf-pill" data-type="inv" data-val="Growatt">Growatt</button>
            <button class="gf-pill" data-type="inv" data-val="Havells">Havells</button>
            <button class="gf-pill" data-type="inv" data-val="Polycab">Polycab</button>
            <button class="gf-pill" data-type="inv" data-val="Selec">Selec</button>
            <button class="gf-pill" data-type="inv" data-val="Solaire">Solaire</button>
            <button class="gf-pill" data-type="inv" data-val="Solis">Solis</button>
            <button class="gf-pill" data-type="inv" data-val="Sunways">Sunways</button>
          </div>
        </details>
        <details class="gf-group gf-group--accordion" open>
          <summary class="gf-label">പാനലുകൾ</summary>
          <div class="gf-pills">
            <button class="gf-pill gf-pill--active" data-type="pan" data-val="all">എല്ലാം</button>
            <button class="gf-pill" data-type="pan" data-val="Adani">Adani</button>
            <button class="gf-pill" data-type="pan" data-val="Emmvee">Emmvee</button>
            <button class="gf-pill" data-type="pan" data-val="Renew">Renew</button>
            <button class="gf-pill" data-type="pan" data-val="Waaree">Waaree</button>
          </div>
        </details>
        <p class="gf-count" id="gf-count" data-total={installCount}>എല്ലാ {installCount} ഇൻസ്റ്റാളേഷനുകളും കാണിക്കുന്നു</p>
      </div>

      <div class="gallery-grid" id="gallery-grid">
        {installations.map((inst, index) => (
          <article
            class="gallery-card gallery-card--interactive"
            data-cap={inst.capacity}
            data-inv={inst.inverter}
            data-pan={inst.panels}
            data-gallery-index={index}
            tabindex="0"
            role="button"
            aria-label={`${inst.name} — ${inst.location} · ${inst.capacity} ഇൻസ്റ്റാളേഷൻ കാണുക`}
          >
            <div class="gallery-card__img-wrap">
              <img
                src={`${base}/media/references/${inst.img}`}
                alt={`${inst.name} — ${inst.location} · ${inst.capacity} സോളാർ ഇൻസ്റ്റാളേഷൻ`}
                loading="lazy"
                decoding="async"
                onload="this.dataset.loaded='1'"
              />
              <div class="gallery-card__overlay">
                <span class="gallery-card__capacity">{inst.capacity}</span>
              </div>
            </div>
            <div class="gallery-card__info">
              <div class="gallery-card__name-row">
                <h3 class="gallery-card__name">{inst.name}</h3>
                <span class="gallery-card__location">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  {inst.location}
                </span>
              </div>
              <div class="gallery-card__specs">
                <span class="spec-pill spec-pill--inverter">{inst.inverter} ഇൻവർട്ടർ</span>
                <span class="spec-pill spec-pill--panels">{inst.panels} പാനലുകൾ</span>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="gf-empty" id="gf-empty" style="display:none">തിരഞ്ഞെടുത്ത ഫിൽട്ടറുകൾക്ക് പൊരുത്തപ്പെടുന്ന ഇൻസ്റ്റാളേഷനുകൾ ഇല്ല. <button class="gf-reset-link" id="gf-reset">ഫിൽട്ടറുകൾ റീസെറ്റ് ചെയ്യുക</button></p>
    </div>
  </section>

  <!-- ===== VIDEO LIBRARY ===== -->
  <section class="video-library" id="video-library">
    <div class="vl-bg-text" aria-hidden="true">ചലച്ചിത്രങ്ങൾ</div>
    <div class="container">

      <div class="section-header section-header--light">
        <span class="section-tag section-tag--light">വീഡിയോ ലൈബ്രറി</span>
        <h2 class="section-title section-title--light">വീഡിയോകൾ, കഥകൾ &amp; അറിവ്</h2>
        <p class="section-intro section-intro--light">ഉപഭോക്താക്കളുടെ അനുഭവങ്ങൾ, ഞങ്ങളുടെ ടീമിന്റെ വിദഗ്ധ ഉപദേശം, റയെന്നയുടെ ബ്രാൻഡ് വീഡിയോകൾ — കാണൂ, അറിയൂ, തീരുമാനിക്കൂ.</p>
      </div>

      <!-- Featured Player -->
      <div class="vl-featured" id="vl-featured">
        <div class="vl-player-frame" id="vl-player-frame">
          <div class="vl-player-placeholder" id="vl-placeholder">
            <div
              class="vl-player-placeholder__bg"
              style={`background-image: url('${videoThumbBg}')`}
              role="img"
              aria-hidden="true"
            ></div>
            <div class="vl-player-placeholder__scrim" aria-hidden="true"></div>
            <div class="vl-player-placeholder__content">
              <img
                src={videoLogo}
                alt={t.images.logoAlt}
                class="vl-player-placeholder__logo"
                width="220"
                height="80"
                loading="eager"
                decoding="async"
              />
              <span class="vl-player-placeholder__label">{mv.thumbLabel}</span>
            </div>
          </div>
          <video
            id="vl-player"
            class="vl-player"
            preload="none"
            playsinline
          >
            നിങ്ങളുടെ ബ്രൗസർ വീഡിയോ ടാഗിനെ പിന്തുണയ്ക്കുന്നില്ല.
          </video>
