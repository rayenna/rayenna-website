  { img: 'AJAYAGHOSH -THEVARA-3KW-EASTMAN-INVERTER-PANELS-ADANI.jpeg', caption: 'Ajaya Ghosh — Thevara',            sub: specSub('3 kW', 'Eastman', 'Adani') },
  { img: 'JOHNSON-THEVARA-3KW-DEYE-INVERTER-PANELS-ADANI.jpeg',       caption: 'Johnson — Thevara',                sub: specSub('3 kW', 'Deye', 'Adani') },
