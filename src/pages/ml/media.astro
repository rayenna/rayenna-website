  { img: 'HARIDAS-KARIMUGHAL-5KW-SOLIS-INVERTER-PANELS-ADANI.png',     caption: 'Haridas — Karimughal',             sub: specSub('5 kW', 'Solis', 'Adani') },
  { img: 'SANTHOSH KUMAR B-KALLARA-3KW-DEYE-INVERTER-PANELS-ADANI.jpeg', caption: 'Santhosh Kumar — Kallara',        sub: specSub('3 kW', 'Deye', 'Adani') },
  { img: 'KOYA-NILAMBUR-3KW-SOLIS-INVERTER-PANELS-RENEW.png',          caption: 'Koya — Nilambur',                  sub: specSub('3 kW', 'Solis', 'Renew') },
