</style>

<script>
  import { trackEvent } from '../../lib/analytics';

  document.querySelectorAll('[data-apt-faq] .accordion-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.accordion-item');
      const open = item?.classList.contains('is-open');
      item?.parentElement?.querySelectorAll('.accordion-item.is-open').forEach((el) => {
        el.classList.remove('is-open');
        el.querySelector('.accordion-trigger')?.setAttribute('aria-expanded', 'false');
      });
      if (!open && item) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  const form = document.getElementById('apartments-form') as HTMLFormElement | null;
  const success = document.getElementById('apt-form-success');
  const errorMsg = document.getElementById('apt-form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('.apt-submit') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'അയയ്ക്കുന്നു…';
    if (errorMsg) errorMsg.style.display = 'none';

    try {
      const formData = new FormData(form);
      formData.append('access_key', '7fec7b57-8d29-4f8b-a09b-6c67140417aa');
      formData.set(
        'subject',
        `Society feasibility enquiry – ${String(formData.get('society_name') || 'Apartments page')}`
      );
      formData.set('source', 'apartments-page');

      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });

      if (response.ok) {
        trackEvent('contact_form_submit', { source: 'apartments-page' });
        trackEvent('apartments_society_enquiry_submit', { source: 'apartments-page' });
        if (success) success.style.display = 'block';
        form.reset();
      } else {
        if (errorMsg) errorMsg.style.display = 'block';
      }
    } catch {
      if (errorMsg) errorMsg.style.display = 'block';
    }

    btn.disabled = false;
    btn.textContent = 'അന്വേഷണ അയയ്ക്കുക';
  });
</script>
