---
import Layout from '../../layouts/Layout.astro';
import { OG } from '../../i18n/og-images';
import { apartmentsFaqsMl } from '../../i18n/apartments-faqs-ml';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const waText = encodeURIComponent(
  'ഹായ് റയെന്ന, ഞങ്ങളുടെ അപ്പാർട്ട്മെന്റ് അസോസിയേഷന് സോളാർ സാധ്യതാ പഠനം വേണം.'
);
const waHref = `https://wa.me/917907369304?text=${waText}`;

const faqs = apartmentsFaqsMl;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Solar feasibility study for apartments and housing societies in Kerala',
  description:
    'Free feasibility study for apartment associations and housing societies in Kerala — roof, shade, structure, common-area bills, subsidy ceiling and metering route.',
  provider: {
    '@type': 'Organization',
    name: 'Rayenna Energy',
    url: 'https://rayennaenergy.com',
  },
  areaServed: { '@type': 'State', name: 'Kerala' },
  serviceType: 'Solar energy consultation',
  url: 'https://rayennaenergy.com/ml/apartments-housing-societies/',
};

// TODO_OWNER: custom Open Graph image for apartments page; reusing services OG for now.
const ogImage = OG.services;
---

<Layout
  lang="ml"
  title="അപ്പാർട്ട്മെന്റ് & സൊസൈറ്റി സോളാർ | കേരളം"
  description="കോമൺ ഏരിയ വൈദ്യുതി ബിൽ കുറയ്ക്കുക. സൗജന്യ സോളാർ സാധ്യതാ പഠനം — ബാധ്യതയില്ല."
  ogImage={ogImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- 1. HERO -->
  <section class="apt-hero">
    <img src={`${base}/media/services-hero-opt3.jpg`} alt="സൂര്യാസ്തമയത്തിൽ മേൽക്കൂരയിലെ സോളാർ പാനലുകൾ" class="apt-hero__bg" />
    <div class="apt-hero__overlay"></div>
    <div class="container apt-hero__inner">
      <p class="apt-hero__eyebrow">കേരളത്തിലെ കമ്മിറ്റികൾക്ക്</p>
      <h1 class="apt-hero__title">കേരളത്തിലെ അപ്പാർട്ട്മെന്റുകൾക്കും ഹൗസിംഗ് സൊസൈറ്റികൾക്കും സോളാർ</h1>
      <p class="apt-hero__sub">
        നിങ്ങളുടെ കോമൺ ഏരിയ വൈദ്യുതി ബിൽ കുറയ്ക്കുക. ഞങ്ങൾ സൗജന്യ സാധ്യതാ പഠനത്തോടെ ആരംഭിക്കുന്നു — ബാധ്യതയില്ല.
      </p>
      <div class="apt-hero__ctas">
        <a href="#enquiry" class="btn btn-primary">സൗജന്യ സൊസൈറ്റി സാധ്യതാ പഠനം അഭ്യർത്ഥിക്കുക</a>
        <a href={waHref} class="btn btn-outline-light" target="_blank" rel="noopener noreferrer" data-analytics-location="apartments-hero-wa">
          WhatsApp ചെയ്യുക
        </a>
      </div>
      <p class="apt-hero__micro">PM സൂര്യ ഘർ എംപാനൽഡ് · ആദ്യം പ്രക്രിയ · കണ്ടുപിടിച്ച പ്രോജക്റ്റ് എണ്ണങ്ങളില്ല</p>
      <img src={`${base}/media/Artboard-2mnre.webp`} alt="PM സൂര്യ ഘർ എംപാനൽഡ് vendor (MNRE)" class="apt-hero__badge" width="160" height="56" />
    </div>
  </section>

  <!-- 2. WHO THIS IS FOR -->
  <section class="apt-section">
    <div class="container apt-split">
      <div class="apt-split__media">
        <img src={`${base}/media/Plan-solar.webp`} alt="കേരളത്തിലെ മൽട്ടി-യൂണിട് കെട്ടിടത്തിന് റൂഫ്ടോപ്പ് സോളാർ പ്ലാനിംഗ്" loading="lazy" />
      </div>
      <div class="apt-split__copy">
        <h2 class="section-title">ആർക്ക് വേണ്ടിയുള്ളതാണ്</h2>
        <p>
          കേരളത്തിലെ അപ്പാർട്ട്മെന്റ് അസോസിയേഷനുകൾ, ഗേറ്റഡ് കമ്മ്യൂണിടികൾ, രെസിഡന്റ്സ് വെൽഫെയർ അസോസിയേഷനുകൾ (RWA), ബിൽഡർ മാനേജ് ചെയ്യുന്ന കമ്മ്യൂണിടികൾ. കമ്മിറ്റിയിലെ പ്രസിഡന്റ്, സെക്രട്ടറി, ട്രഷറർ അല്ലെങ്കിൽ അംഗമാണെങ്കിൽ — വോട്ടിന് മുമ്പ് വ്യക്തമായ ചിത്രം വേണമെങ്കിൽ ഇവിടെ നിന്ന് തുടങ്ങുക.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. THREE WAYS -->
  <section class="apt-section apt-section--alt apt-section--routes">
    <div class="container">
      <h2 class="section-title">ഒരു കെട്ടിടത്തിന് സോളാർ സ്വീകരിക്കാനുള്ള മൂന്ന് വഴികൾ</h2>
      <p class="apt-lead">മേൽക്കൂര അവകാശം, മീറ്ററുകൾ, ബൈലോകൾക്ക് അനുയോജ്യമായ വഴി തിരഞ്ഞെടുക്കുക. പഠനത്തിന് ശേഷം ഞങ്ങൾ ഒന്ന് ശുപാർശ ചെയ്യും.</p>

      <div class="apt-diagram" role="img" aria-label="മൂന്ന് സോളാർ വഴികളുടെ ഡയഗ്രം: വ്യക്തിഗത ഫ്ലാറ്റ് പ്ലാന്റ്, കോമൺ ഏരിയ പ്ലാന്റ്, പങ്കിട്ട വെർച്വല് നെറ്റ് മീറ്ററിംഗ്">
        <svg viewBox="0 0 720 200" xmlns="http://www.w3.org/2000/svg" width="720" height="200" class="apt-diagram__svg" aria-hidden="true">
          <rect x="8" y="20" width="220" height="160" rx="8" fill="#f5f5f5" stroke="#a83838" stroke-width="2"/>
          <text x="118" y="48" text-anchor="middle" font-size="13" font-family="system-ui,sans-serif" fill="#27324f" font-weight="600">A · വ്യക്തിഗത</text>
          <text x="118" y="72" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif" fill="#616161">ഫ്ലാറ്റ് / ടെറസ് പ്ലാന്റ്</text>
          <rect x="48" y="90" width="40" height="28" fill="#a83838"/>
          <rect x="98" y="90" width="40" height="28" fill="#788bba"/>
          <rect x="148" y="90" width="40" height="28" fill="#f9efef"/>
          <text x="118" y="150" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif" fill="#616161">ഒരു ഉടമ · ഒരു മീറ്റർ</text>

          <rect x="250" y="20" width="220" height="160" rx="8" fill="#f5f5f5" stroke="#a83838" stroke-width="2"/>
          <text x="360" y="48" text-anchor="middle" font-size="13" font-family="system-ui,sans-serif" fill="#27324f" font-weight="600">B · കോമൺ ഏരിയ</text>
          <text x="360" y="72" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif" fill="#616161">സൊസൈറ്റി പ്ലാന്റ്</text>
          <rect x="300" y="90" width="120" height="28" fill="#a83838"/>
          <text x="360" y="150" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif" fill="#616161">ലിഫ്റ്റ് · പമ്പ് · ലൈട്ട് · EV</text>

          <rect x="492" y="20" width="220" height="160" rx="8" fill="#f5f5f5" stroke="#a83838" stroke-width="2"/>
          <text x="602" y="48" text-anchor="middle" font-size="13" font-family="system-ui,sans-serif" fill="#27324f" font-weight="600">C · പങ്കിട്ട (VNM)</text>
          <text x="602" y="72" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif" fill="#616161">ഒരു പ്ലാന്റ് · പല മീറ്റർ</text>
          <rect x="542" y="90" width="120" height="28" fill="#788bba"/>
          <line x1="562" y1="118" x2="542" y2="145" stroke="#27324f" stroke-width="1.5"/>
          <line x1="602" y1="118" x2="602" y2="145" stroke="#27324f" stroke-width="1.5"/>
          <line x1="642" y1="118" x2="662" y2="145" stroke="#27324f" stroke-width="1.5"/>
          <text x="602" y="165" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif" fill="#616161">കരാർ അനുസരിച്ച് ക്രെഡിറ്റ്</text>
        </svg>
        <p class="apt-diagram__caption">അപ്പാർട്ട്മെന്റ് കെട്ടിടങ്ങൾക്കുള്ള മൂന്ന് മീറ്ററിംഗ് വഴികൾ — ലളിതമായ ചിത്രീകരണം.</p>
      </div>

      <div class="apt-cards">
        <article class="apt-card">
          <div class="apt-card__media">
            <img src={`${base}/media/solar-rooftop-home.jpg`} alt="കേരള വീട്ടിലെ വ്യക്തിഗത റൂഫ്ടോപ്പ് സോളാർ പാനലുകൾ" loading="lazy" />
          </div>
          <div class="apt-card__body">
            <h3>A. വ്യക്തിഗത ഫ്ലാറ്റ് അല്ലെങ്കിൽ ടെറസ് പ്ലാന്റുകൾ</h3>
          <p>ഉടമയ്ക്ക് പ്രത്യേക മേൽക്കൂര അല്ലെങ്കിൽ ടെറസ് പ്രവേശനമുണ്ട്, സൊസൈറ്റി അനുവദിക്കുന്നിടത്ത് മാത്രം. സാധാരണ PM സൂര്യ ഘർ രെസിഡൻഷ്യൽ നിയമങ്ങൾ ബാധകം.</p>
          </div>
        </article>
        <article class="apt-card">
          <div class="apt-card__media">
            <img src={`${base}/media/solar-panel-installation.jpg`} alt="റൂഫ്ടോപ്പിൽ സോളാർ പാനലുകൾ സ്ഥാപിക്കുന്ന റയെന്ന ടീം" loading="lazy" />
          </div>
          <div class="apt-card__body">
            <h3>B. കോമൺ ഏരിയ പ്ലാന്റ്</h3>
          <p>ലിഫ്റ്റ്, വാട്ടർ പമ്പ്, കോറിഡോർ/ബേസ്മെന്റ് ലൈട്ടിംഗ്, EV ചാർജിംഗ് എന്നിവയ്ക്കുള്ള ഒരു പ്ലാന്റ്. സൊസൈറ്റി തല സബ്സിഡിയും അനുമതികളും ബാധകം (താഴെ കാണുക).</p>
          </div>
        </article>
        <article class="apt-card">
          <div class="apt-card__media">
            <img src={`${base}/media/Hardshell-solar.webp`} alt="കേരള സൂര്യന് കീഴിലുള്ള പൂര്ത്തിയാക്കിയ റൂഫ്ടോപ്പ് സോളാർ അറേ" loading="lazy" />
          </div>
          <div class="apt-card__body">
            <h3>C. പങ്കിട്ട (വെർച്വൽ) നെറ്റ് മീറ്ററിംഗ്</h3>
          <p>
            ഒരു പ്ലാന്റ്; പങ്കെടുക്കുന്ന ഫ്ലാറ്റുകള്ക്കിടയിൽ കരാർ പ്രകാരം ക്രെഡിറ്റ് പങ്കിടൽ. KSERC-യുടെ 2025 നിയന്ത്രണങ്ങൾ പ്രകാരം, മൽട്ടി-സ്റ്റോറിഡ് രെസിഡൻഷ്യൽ കെട്ടിടങ്ങൾക്കും രെസിഡന്റ്സ് അസോസിയേഷനുകൾക്കും VNM-ന് പ്ലാന്റിന്റെ ജനറേഷൻ പൊട്ടൻഷ്യലിന്റെ കുറഞ്ഞത് 20% എനർജി സ്റ്റോറേജ്, Lead person, സൊസൈറ്റി രെസല്യൂഷൻ, ക്രെഡിറ്റ്-ഷെയറിംഗ് കരാർ, KSEB അനുമതി എന്നിവ ആവശ്യമാണ്. ഏറ്റവും കുറഞ്ഞ പ്ലാന്റ് വലുപ്പം 10 kW. കേരളത്തിൽ നടപ്പാക്കൽ ഇപ്പോഴും പുരോഗമിക്കുകയാണ് — നിങ്ങളുടെ കെട്ടിടത്തിന് യോജിക്കുന്നുണ്ടോ എന്ന് പഠനത്തിൽ ഞങ്ങൾ സ്ഥിരീകരിക്കും.
          </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. WHY COMMON-AREA -->
  <section class="apt-section">
    <div class="container apt-split apt-split--flip">
      <div class="apt-split__copy">
        <h2 class="section-title">കോമൺ ഏരിയ ലോഡുകൾക്ക് സോളാർ എന്തുകൊണ്ട് യോജിക്കുന്നു</h2>
        <p>
          ലിഫ്റ്റ്, പമ്പ്, ലൈട്ടിംഗ് എന്നിവ പലപ്പോഴും പകൽ സമയത്ത് പ്രവർത്തിക്കുന്നു — പാനലുകൾ ഉൽപ്പാദിപ്പിക്കുന്ന സമയം. ഈ പകൽ ഓവർലാപ്പ് കാരണം കോമൺ ഏരിയ ലോഡുകൾ റൂഫ്ടോപ്പ് സോളാറിന് സ്വാഭാവികമായി യോജിക്കുന്നു. ഞങ്ങൾ സാധാരണ ശതമാനം സേവിങ്ങ്സ് അവകാശപ്പെടുന്നില്ല — നിങ്ങളുടെ കഴിഞ്ഞ പന്ത്രണ്ട് മാസത്തെ ബില്ലുകളാണ് കേസ് തീരുമാനിക്കുന്നത്.
        </p>
      </div>
      <div class="apt-split__media">
        <img src={`${base}/media/Drilling-solar.jpg`} alt="കേരള റൂഫ്ടോപ്പിലെ സോളാർ പാനൽ മൡണ്ടിംഗ് ജോലി" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 4b. REAL ROOFS STRIP -->
  <section class="apt-section apt-section--gallery" aria-labelledby="apt-gallery-title">
    <div class="container">
      <h2 id="apt-gallery-title" class="section-title">കേരളത്തിലെയുള്ള യഥാർത്ഥ റയെന്ന റൂഫ്ട്ടപ്പുകൾ</h2>
      <p class="apt-lead">ഞങ്ങൾ പൂര്ത്തിയാക്കിയ വീട്ടു ഇൻസ്റ്റലേഷനുകൾ — സൊസൈറ്റി സാധ്യതാ പഠനത്തിലും അതേ ഗുണമാന് പ്രക്രിയയും.</p>
      <div class="apt-gallery">
        <a class="apt-gallery__item" href={`${base}/ml/media/`}>
          <img src={`${base}/media/references/ARUN-KOLLAM-5KW-SOLIS-INVERTER-PANELS-WAAREE.jpeg`} alt="Arun · Kollam · 5 kW" loading="lazy" />
          <span>Arun · Kollam · 5 kW</span>
        </a>
        <a class="apt-gallery__item" href={`${base}/ml/media/`}>
          <img src={`${base}/media/references/SESSY ANTONY-CHOTTANIKKARA-6KW-DEYE-INVERTER-PANELS-EMMVEE.jpeg`} alt="Sessy Antony · Chottanikkara · 6 kW" loading="lazy" />
          <span>Sessy Antony · Chottanikkara · 6 kW</span>
        </a>
        <a class="apt-gallery__item" href={`${base}/ml/media/`}>
          <img src={`${base}/media/references/SURESH-EROOR-4KW-SUNWAYS-INVERTER-PANELS-WAAREE.jpeg`} alt="Suresh · Eroor · 4 kW" loading="lazy" />
          <span>Suresh · Eroor · 4 kW</span>
        </a>
        <a class="apt-gallery__item" href={`${base}/ml/media/`}>
          <img src={`${base}/media/references/DHANYA V T-THOPPUMPADY-5KW-EASTMAN-INVERTER-PANELS-ADANI.jpeg`} alt="Dhanya V.T. · Thoppumpady · 5 kW" loading="lazy" />
          <span>Dhanya V.T. · Thoppumpady · 5 kW</span>
        </a>
      </div>
