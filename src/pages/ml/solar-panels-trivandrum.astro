---
import Layout from '../../layouts/Layout.astro';
import { OG } from '../../i18n/og-images';
import { useTranslations } from '../../i18n/ui';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = useTranslations('ml');
const pc = t.pageConvert.city;
const mlPrefix = '/ml';
---
<Layout lang="ml"
  title="തിരുവനന്തപുരത്ത് സോളാർ ഇൻസ്റ്റാളേഷൻ | റയെന്ന എനർജി"
  description="തിരുവനന്തപുരം (ട്രിവാൻഡ്രം) സോളാർ — MNRE അംഗീകൃത റയെന്ന എനർജി. PM സൂര്യ ഘർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ സർവേ. വിളിക്കുക: +91 7907 369 304."
  ogImage={OG.trivandrum}
>

  <section class="area-hero">
    <img src={`${base}/media/hero (1).webp`} alt="തിരുവനന്തപുരത്ത് മേൽക്കൂര സോളാർ പാനൽ ഇൻസ്റ്റാളേഷൻ" class="area-hero__bg" />
    <div class="area-hero__overlay"></div>
    <div class="container area-hero__inner">
      <p class="area-hero__eyebrow">തിരുവനന്തപുരം</p>
      <h1 class="area-hero__title">തിരുവനന്തപുരത്ത്<br />സോളാർ ഇൻസ്റ്റാളേഷൻ</h1>
      <p class="area-hero__sub">MNRE അംഗീകൃത ഇൻസ്റ്റാളർ. സർക്കാർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ റൂഫ് അസസ്മെന്റ്. 25 വർഷ വാറന്റി.</p>
      <div class="area-hero__ctas">
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-primary">☀️ സമ്പാദ്യം കണക്കാക്കുക</a>
        <a href={`${mlPrefix}/contact/`} class="btn btn-outline-light">സൗജന്യ സർവേ ബുക്ക് →</a>
      </div>
      <p class="area-hero__micro">{pc.heroMicro}</p>
      <p class="area-hero__phone">{pc.heroPhone} <a href="tel:+917907369304" data-analytics-location="city_hero">+91 7907 369 304</a></p>
    </div>
  </section>

  <!-- ===== WHY TRIVANDRUM ===== -->
  <section class="area-why">
    <div class="container area-why__inner">
      <div class="area-why__content">
        <span class="section-tag">തിരുവനന്തപുരത്തിന്റെ സോളാർ സാധ്യത</span>
        <h2 class="section-title">തിരുവനന്തപുരം: കേരളത്തിലെ മികച്ച സോളാർ സ്ഥലങ്ങളിൽ ഒന്ന്</h2>
        <p>തിരുവനന്തപുരം കേരളത്തിന്റെ തെക്കൻ അറ്റത്താണ് — തെളിഞ്ഞ ആകാശവും കുറഞ്ഞ അക്ഷാംശവും ചേർന്ന് സംസ്ഥാനത്തിലെ ഏറ്റവും ഉയർന്ന സോളാർ ഇറാഡിയൻസ് നൽകുന്നു. KSEB ഡാറ്റ തിരുവനന്തപുരത്തെ മേൽക്കൂര സോളാർ ഉത്പാദനത്തിൽ മുൻനിര ജില്ലകളിൽ ഒന്നായി കാണിക്കുന്നു; ഇൻസ്റ്റാൾ ചെയ്ത kW-ന് ശരാശരി ദൈനിക ഉത്പാദനം 4.2–4.8 kWh.</p>
        <p>നഗരത്തിലെ വളരുന്ന IT പാർക്കുകൾ, പട്ടോം, കഴക്കൂട്ടം, തിരുവല്ലം പോലുള്ള സാന്ദ്രതയുള്ള താമസ പ്രദേശങ്ങൾ, വട്ടിയൂർക്കാവ്, ശ്രീകാര്യം എന്നിവിടങ്ങളിലെ വലിയ സ്വതന്ത്ര വീടുകൾ — എല്ലാം സോളാറിന് ശക്തമായ സാധ്യതകൾ. ഷെഡ്യൂൾ ചെയ്ത സർവേ, ഇൻസ്റ്റാളേഷൻ ദിവസങ്ങൾക്ക് റയെന്ന ടീം തിരുവനന്തപുരത്ത് വരുന്നു; നെറ്റ് മീറ്ററിംഗ് അംഗീകാരത്തിനായി KSEB തെക്കൻ ഡിവിഷനുമായി ഏകോപിപ്പിക്കുന്നു.</p>
        <ul class="area-facts">
          <li><span class="fact-icon">🌞</span><span><strong>~4.5 kWh/kWp/day</strong> — കേരളത്തിലെ ഏറ്റവും ഉയർന്ന ദൈനിക സോളാർ ഉത്പാദനത്തിൽ</span></li>
          <li><span class="fact-icon">📉</span><span><strong>KSEB ബിൽ 70–90% കുറയ്ക്കാം</strong> — നെറ്റ് മീറ്ററിംഗുള്ള ശരിയായി സൈസ് ചെയ്ത സിസ്റ്റങ്ങളുടെ സാധാരണ ഫലം</span></li>
          <li><span class="fact-icon">🏢</span><span><strong>കമർഷ്യൽ & IT പാർക്ക് ഇൻസ്റ്റാളേഷനുകൾ</strong> — ടെക്നോപാർക്ക് കോറിഡോറിൽ വലിയ കമർഷ്യൽ സിസ്റ്റങ്ങൾക്ക് റയെന്ന പിന്തുണ</span></li>
          <li><span class="fact-icon">📜</span><span><strong>KSEB നെറ്റ് മീറ്ററിംഗ് സജീവം</strong> — ഗ്രിഡിലേക്ക് കയറ്റിയ അധിക യൂണിറ്റുകൾ മാസം തോറും അക്കൗണ്ടിൽ ക്രെഡിറ്റ്</span></li>
        </ul>
      </div>
      <div class="area-why__image">
        <img src={`${base}/media/solar-panel-installation.jpg`} alt="തിരുവനന്തപുരത്ത് റയെന്ന സോളാർ പാനൽ ഇൻസ്റ്റാളേഷൻ" />
      </div>
    </div>
  </section>

  <!-- ===== SUBSIDY ===== -->
  <section class="area-subsidy">
    <div class="container">
      <div class="area-subsidy__inner">
        <div class="subsidy-icon">🏛️</div>
        <div class="subsidy-content">
          <h2>തിരുവനന്തപുരം നിവാസികൾക്കുള്ള PM സൂര്യ ഘർ സബ്സിഡി</h2>
          <p>തിരുവനന്തപുരം വീട്ടുടമകൾക്ക് ഇന്ത്യയിലെ മറ്റെല്ലാ പ്രദേശങ്ങളിലെയും പോലെ കേന്ദ്ര സർക്കാർ സബ്സിഡിയിൽ അർഹതയുണ്ട് — 3 kW സിസ്റ്റത്തിന് <strong>₹78,000</strong> വരെ, KSEB നെറ്റ് മീറ്റർ കണക്ഷന് ശേഷം 30–60 ദിവസത്തിനുള്ളിൽ നേരിട്ട് ബാങ്ക് അക്കൗണ്ടിലേക്ക്. എല്ലാ പേപ്പർവർക്കും, പോർട്ടൽ സമർപ്പണവും, KSEB ഏകോപണവും ഇൻസ്റ്റാളേഷൻ പാക്കേജിന്റെ ഭാഗമായി റയെന്ന കൈകാര്യം ചെയ്യുന്നു.</p>
          <div class="subsidy-table">
            <div class="subsidy-row"><span>2 kW വരെ</span><strong>₹30,000 – ₹60,000 സബ്സിഡി</strong></div>
            <div class="subsidy-row"><span>3 kW സിസ്റ്റം</span><strong>₹78,000 സബ്സിഡി</strong></div>
            <div class="subsidy-row"><span>3–10 kW സിസ്റ്റം</span><strong>₹78,000 + ബാലൻസ് ചെലവിന്റെ 20%</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LOCAL INSTALLATIONS ===== -->
  <section class="area-installs">
    <div class="container">
      <h2 class="section-title text-center">സമീപകാല തിരുവനന്തപുരം & തെക്കൻ കേരള ഇൻസ്റ്റാളേഷനുകൾ</h2>
      <div class="area-installs-grid">
        {[
          { name: 'Abdul Kalam', location: 'Varkala', cap: '3 kW', img: 'ABDUL-KALAM-VARKALA-3KW-SOLIS-INVERTER-PANELS-ADANI.png' },
          { name: 'Shamna',      location: 'Kollam',  cap: '3 kW', img: 'SHAMNA-KOLLAM-3KW-SOLIS-INVERTER-PANELS-ADANI.jpeg' },
          { name: 'Arun',        location: 'Kollam',  cap: '5 kW', img: 'ARUN-KOLLAM-5KW-SOLIS-INVERTER-PANELS-WAAREE.jpeg' },
          { name: 'Mariamma',    location: 'Kollam',  cap: '5 kW', img: 'MARIAMMA-KOLLAM-5KW-DEYE HYBRID-INVERTER-PANELS-ADANI.jpeg' },
        ].map(item => (
          <div class="area-install-card">
            <img src={`${base}/media/references/${item.img}`} alt={`${item.name}, ${item.location} — ${item.cap} സോളാർ ഇൻസ്റ്റാളേഷൻ`} loading="lazy" />
            <div class="area-install-label">
              <strong>{item.name}</strong>
              <span>{item.location} · {item.cap}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="installs-cta-text"><a href={`${mlPrefix}/media/`}>എല്ലാ ഇൻസ്റ്റാളേഷനുകളും കാണുക →</a></p>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="area-faq">
    <div class="container area-faq__inner">
      <h2 class="section-title">തിരുവനന്തപുരം വീട്ടുടമകളുടെ ചോദ്യങ്ങൾ</h2>
      <div class="area-faq__list">
        {[
          {
            q: 'ഇൻസ്റ്റാളേഷനും ആഫ്റ്റർ-സെയിൽസ് പിന്തുണയും നൽകാൻ റയെന്ന തിരുവനന്തപുരം സേവനം നടത്തുമോ?',
            a: 'അതെ. സർവേകൾ, ഇൻസ്റ്റാളേഷനുകൾ, വാർഷിക പരിപാലനം എന്നിവയ്ക്ക് റയെന്ന തിരുവനന്തപുരത്ത് നിയമിത സന്ദർശനങ്ങൾ ഷെഡ്യൂൾ ചെയ്യുന്നു. ആഫ്റ്റർ-സെയിൽസ് പ്രശ്നങ്ങൾക്ക് ഓൺലൈൻ മോണിറ്ററിംഗ് വഴി റിമോട്ടായി ഏകോപിപ്പിക്കുകയും ആവശ്യമുള്ളപ്പോൾ സൈറ്റിൽ സേവനത്തിന് വരുകയും ചെയ്യുന്നു.',
          },
          {
            q: 'തിരുവനന്തപുരം ഫ്ലാറ്റ് അല്ലെങ്കിൽ അപ്പാർട്ട്മെന്റിന് ഏത് സിസ്റ്റം സൈസ് അനുയോജ്യം?',
            a: 'പ്രത്യേക മേൽക്കൂര പ്രവേശനമുള്ള അപ്പാർട്ട്മെന്റുകൾക്ക് സാധാരണയായി 1–3 kW സിസ്റ്റങ്ങൾ (നിഴൽരഹിത പ്രദേശം അനുസരിച്ച്). സൈറ്റ് സർവേയിൽ വിശദമായ ഷേഡ് അനാലിസിസും സ്ട്രക്ചറൽ പരിശോധനയും ഉൾപ്പെടുന്നു. കഴക്കൂട്ടം, പട്ടോം എന്നിവിടങ്ങളിലെ പല ഫ്ലാറ്റ് ഉടമകളും 1.5–2 kW സിസ്റ്റങ്ങൾ വിജയകരമായി ഇൻസ്റ്റാൾ ചെയ്തിട്ടുണ്ട്.',
          },
          {
            q: 'മറ്റ് കേരള ജില്ലകളേക്കാൾ തിരുവനന്തപുരത്തിൽ KSEB നെറ്റ് മീറ്ററിംഗ് അംഗീകാരം വേഗത്തിലാണോ?',
            a: 'അംഗീകാര സമയം KSEB സബ്-ഡിവിഷനും നിലവിലെ അപേക്ഷ ഭാരവും അനുസരിച്ച് വ്യത്യാസപ്പെടുന്നു. ഞങ്ങളുടെ അനുഭവത്തിൽ സാങ്കേതിക പരിശോധനയ്ക്ക് ശേഷം തിരുവനന്തപുരം അംഗീകാരങ്ങൾ സാധാരണയായി 30–45 ദിവസം എടുക്കുന്നു. ഇൻസ്റ്റാളേഷന് ശേഷം ഉടനടി അപേക്ഷ സമർപ്പിക്കുകയും നിങ്ങളുടെ പേരിൽ ഫോളോ അപ്പ് ചെയ്യുകയും ചെയ്യുന്നു.',
          },
        ].map(item => (
          <details class="area-faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <p class="area-faq__more">കൂടുതൽ ചോദ്യങ്ങളുണ്ടോ? <a href={`${mlPrefix}/faqs/`}>മുഴുവൻ FAQ നോക്കുക →</a></p>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="area-cta">
    <div class="container area-cta__inner">
      <div>
        <h2>തിരുവനന്തപുരത്തിൽ സൗജന്യ മേൽക്കൂര സർവേ നേടുക</h2>
        <p>ഞങ്ങളുടെ ടീം തിരുവനന്തപുരത്തിൽ നിയമിതമായി വരുന്നു. സൗജന്യ അസസ്മെന്റ് ഷെഡ്യൂൾ ചെയ്യാൻ ബന്ധപ്പെടുക — സൈറ്റ്-സ്പെസിഫിക് സമ്പാദ്യ കണക്ക് ബാധ്യതയില്ലാതെ ലഭിക്കും.</p>
      </div>
      <div class="area-cta__btns">
        <a href={`${mlPrefix}/contact/`} class="btn btn-primary">{pc.ctaContact}</a>
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-outline">{pc.ctaCalc}</a>
      </div>
    </div>
  </section>

  <!-- Useful blog reading -->
  <section class="area-blog">
    <div class="container">
      <h2 class="section-title">തീരുമാനിക്കും മുമ്പ് ഉപകാരപ്രദമായ ലേഖനങ്ങൾ</h2>
      <div class="area-blog__grid">
        <a href={`${mlPrefix}/blog/pm-surya-ghar-subsidy-guide/`} class="area-blog-card">
          <span class="blog-card-tag">സർക്കാർ പദ്ധതികൾ</span>
          <strong>PM സൂര്യ ഘർ മുഫ്ത് ബിജ്ലി യോജന: പൂർണ്ണ സബ്സിഡി ഗൈഡ്</strong>
          <span class="blog-card-arrow">→</span>
        </a>
        <a href={`${mlPrefix}/blog/kseb-net-metering-rules-2026/`} class="area-blog-card">
          <span class="blog-card-tag">നെറ്റ് മീറ്ററിംഗ്</span>
          <strong>കേരളത്തിലെ നെറ്റ് മീറ്ററിംഗ് നിയമങ്ങൾ 2026-ൽ മാറുന്നു — ഓരോ സോളാർ ഉടമയും അറിയേണ്ടത്</strong>
          <span class="blog-card-arrow">→</span>
        </a>
        <a href={`${mlPrefix}/blog/monsoon-solar-system-kerala/`} class="area-blog-card">
          <span class="blog-card-tag">പരിപാലനം</span>
