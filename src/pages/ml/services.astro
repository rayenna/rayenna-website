---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mlPrefix = '/ml';
---
<Layout lang="ml" title="കേരളത്തിലെ സോളാർ സേവനങ്ങൾ | റയെന്ന എനർജി" description="വീട്ടുപയോഗ, കമർഷ്യൽ സോളാർ സേവനങ്ങൾ. MNRE അംഗീകൃത. PM സൂര്യ ഘർ സബ്സിഡി ₹78,000 വരെ.">

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <img src={`${base}/media/services-hero-opt3.jpg`} alt="Solar panels on a rooftop at sunset" class="page-hero__bg" />
    <div class="page-hero__overlay"></div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow">ഞങ്ങൾ നൽകുന്നത്</p>
      <h1 class="page-hero__title">കേരളത്തിലെ സോളാർ<br />ഇൻസ്റ്റാളേഷൻ സേവനങ്ങൾ</h1>
      <p class="page-hero__sub">ഓരോ വീടിനും ബിസിനസിനും അനുയോജ്യമായ സോളാർ പരിഹാരങ്ങൾ.</p>
    </div>
  </section>

  <!-- ===== INTRO ===== -->
  <section class="intro-section">
    <div class="container intro-section__inner">
      <div class="intro-section__content">
        <span class="section-tag">സമഗ്ര സോളാർ സേവനം</span>
        <h2 class="section-title">ഞങ്ങളുടെ സേവനങ്ങൾ അന്വേഷിക്കുക — നിങ്ങൾക്ക് അനുയോജ്യമായത് കണ്ടെത്തുക</h2>
        <p>റയെന്നിൽ ഓരോ ഉപഭോക്താവിന്റെയും ഊർജ്ജ ആവശ്യങ്ങൾ വ്യത്യസ്തമാണെന്ന് ഞങ്ങൾ മനസ്സിലാക്കുന്നു — അതിനാൽ സേവനങ്ങൾ വഴക്കമുള്ളതായി രൂപകൽപ്പന ചെയ്തിരിക്കുന്നു. വൈദ്യുതി ബിൽ കുറയ്ക്കാൻ ആഗ്രഹിക്കുന്ന വീട്ടുടമയോ, ദീർഘകാല ചെലവ് ലാഭം തേടുന്ന ബിസിനസോ — നിങ്ങളുടെ ആവശ്യങ്ങൾക്കനുസരിച്ച് ക്രമീകരിച്ച സോളാർ പരിഹാരങ്ങൾ ഞങ്ങൾ നൽകുന്നു.</p>
        <p>മികച്ച ഗ്രേഡ് ഘടകങ്ങൾ, അസാധാരണമായ ഇൻസ്റ്റാളേഷൻ, തുടർച്ചയായ പിന്തുണ — ഓരോ സിസ്റ്റവും പരമാവധി പ്രകടനത്തിൽ പ്രവർത്തിക്കാൻ ഉറപ്പാക്കുന്നു. റയെന്നയുടെ സമഗ്ര സോളാർ സേവനങ്ങളോടെ പുനരുപയോഗ ഊർജ്ജം വീട്ടുപയോഗത്തിനും കമർഷ്യൽ സ്ഥാപനങ്ങൾക്കും സാമ്പത്തികവും ലഭ്യവും കാര്യക്ഷമവുമാണ്.</p>
      </div>
      <div class="intro-highlights">
        {[
          { num: '20+', label: 'ബ്രാൻഡുകൾ' },
          { num: '80%',  label: 'ശരാശരി ബിൽ കുറവ്' },
          { num: '3–4',  label: 'വർഷം ROI' },
          { num: '20',   label: 'വർഷ പാനൽ ആയുസ്' },
        ].map(s => (
          <div class="intro-highlight">
            <strong>{s.num}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SERVICE 1: DOMESTIC ===== -->
  <section class="service-block service-block--alt" id="domestic">
    <div class="container domestic-inner">

      <!-- Top row: image left, text right — both top-aligned -->
      <div class="domestic-top">
        <div class="service-block__image">
          <img src={`${base}/media/Drilling-solar.jpg`} alt="Domestic solar panel installation" />
          <div class="service-block__badge">01</div>
        </div>
        <div class="service-block__content">
          <span class="section-tag">വീട്ടുപയോഗ</span>
          <h2 class="section-title">വീട്ടുപയോഗ സേവനങ്ങൾ</h2>
          <p>റയെന്നയുടെ വീട്ടുപയോഗ സോളാർ ഇൻസ്റ്റാളേഷനോടെ യഥാർത്ഥ ഊർജ്ജ സമ്പാദ്യത്തിനൊപ്പം ഊർജ്ജ സ്വാതന്ത്ര്യവും നേടാം. സ്വന്തമായി വൈദ്യുതി ഉത്പാദിപ്പിച്ച് ചെലവ് കുറയ്ക്കാം — വീട്ടുആവശ്യങ്ങൾ, EV ചാർജിംഗ്, മാസിക ബിൽ കുറയ്ക്കൽ. സുസ്ഥിരമായി ഉത്പാദിപ്പിക്കുന്ന ഊർജ്ജം സ്വതന്ത്രമായി ഉപയോഗിക്കാം.</p>
          <p>എല്ലാ വലുപ്പത്തിലുള്ള വീടുകൾക്കും സിസ്റ്റം ഡിസൈൻ ചെയ്ത് നടപ്പാക്കാം. ശരിയായ പരിപാലനത്തോടെ പാനലുകൾ 20 വർഷം വരെ കാര്യക്ഷമമായി സേവിക്കും; 5–6 വർഷത്തിനുള്ളിൽ നിക്ഷേപം പൂർണ്ണമായി തിരിച്ചെടുക്കാം.</p>
          <a href={`${mlPrefix}/solar-calculator/`} class="service-calc-cta">ശരിയായ സിസ്റ്റം വലുപ്പം കണ്ടെത്തുക → കാൽക്കുലേറ്റർ പരീക്ഷിക്കുക</a>
        </div>
      </div>

      <!-- Bottom row: 3 steps horizontally -->
      <div class="service-steps-h">
        <div class="service-step-h">
          <div class="service-step__num">01</div>
          <div class="service-step__body">
            <h3>സാധ്യതാ വിലയിരുത്തൽ</h3>
            <p>റൂഫ് ദിശ, നിഴൽ, ഊർജ്ജ ഉപഭോഗം എന്നിവ ഉൾപ്പെടെ സൈറ്റ് വിശദമായി പഠിക്കുന്നു — സിസ്റ്റം പരമാവധി ഉത്പാദനം നൽകാൻ.</p>
          </div>
        </div>
        <div class="service-step-h">
          <div class="service-step__num">02</div>
          <div class="service-step__body">
            <h3>രജിസ്ട്രേഷനും അംഗീകാരങ്ങളും</h3>
            <p>എല്ലാ രേഖകളും സർക്കാർ രജിസ്ട്രേഷനുകളും ഞങ്ങൾ കൈകാര്യം ചെയ്യുന്നു — പ്രാദേശിക അംഗീകാരം മുതൽ ലഭ്യമായ സബ്സിഡി അപേക്ഷ വരെ.</p>
          </div>
        </div>
        <div class="service-step-h">
          <div class="service-step__num">03</div>
          <div class="service-step__body">
            <h3>ഇൻസ്റ്റാളേഷനും പൂർത്തീകരണവും</h3>
            <p>പരിശീലനം പൂർത്തിയാക്കിയ എഞ്ചിനീയർമാർ ഏറ്റവും ഉയർന്ന മാനദണ്ഡങ്ങളിൽ ഇൻസ്റ്റാൾ ചെയ്യുന്നു; പരീക്ഷണം, കമ്മിഷനിംഗ്, പൂർണ്ണ സിസ്റ്റം പരിശീലനത്തോടെയുള്ള ഹാൻഡ്ഓവർ.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ===== SERVICE 2: COMMERCIAL ===== -->
  <section class="service-block" id="commercial">
    <div class="container service-block__inner service-block__inner--flip">
      <div class="service-block__content">
        <span class="section-tag">ബിസിനസും വ്യവസായവും</span>
        <h2 class="section-title">കമർഷ്യൽ സേവനങ്ങൾ</h2>
        <p>ബിസിനസുകൾക്കുള്ള റയെന്നയുടെ സോളാർ പരിഹാരങ്ങൾ തൽക്ഷണവും ദീർഘകാലവും ആനുകൂല്യങ്ങൾ നൽകുന്നു. ഹോട്ടലുകൾ, റെസ്റ്റോറന്റുകൾ, കമർഷ്യൽ കെട്ടിടങ്ങൾ — സോളാർ പാനലുകൾ പ്രവർത്തന ചെലവ് വളരെ കുറയ്ക്കും; പരിസ്ഥിതി ഉത്തരവാദിത്വം പ്രദർശിപ്പിച്ച് ഹരിത മനസ്സുള്ള ഉപഭോക്താക്കളെയും നിക്ഷേപകരെയും ആകർഷിക്കും.</p>
        <p>പ്രീമിയം ഘടകങ്ങൾ ദീർഘകാല പ്രകടനവും ക്ഷമതയും ഉറപ്പാക്കുന്നു — ബിസിനസുകൾ പ്രവർത്തനങ്ങളിൽ ശ്രദ്ധ കേന്ദ്രീകരിക്കാം. ഓൺലൈൻ മോണിറ്ററിംഗ് തത്സമയ പ്രകടനം ട്രാക്ക് ചെയ്യാനും പരിപാലന അലേർട്ടുകൾ നേടാനും — ആവശ്യമുള്ളപ്പോൾ വേഗത്തിലുള്ള പിന്തുണ.</p>
        <div class="service-perks">
          {[
            'വൈദ്യുതി ചെലവിൽ ഗണ്യമായ കുറവ്',
            'പ്രീമിയം ഘടകങ്ങളോടെ ദീർഘകാല പ്രകടനം',
            'തത്സമയ ഓൺലൈൻ മോണിറ്ററിംഗ് ഡാഷ്ബോർഡ്',
            'നിങ്ങളുടെ ബ്രാൻഡിന്റെ ഹരിത ക്രെഡൻഷ്യൽ മെച്ചപ്പെടുത്തൽ',
          ].map(p => (
            <div class="service-perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>{p}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="service-block__image">
        <img src={`${base}/media/Plan-solar.webp`} alt="Commercial solar installation" />
        <div class="service-block__badge">02</div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICE 3: CONSULTATION ===== -->
  <section class="service-block service-block--alt" id="consultation">
    <div class="container service-block__inner">
      <div class="service-block__image">
        <img src={`${base}/media/Hardshell-solar.webp`} alt="Solar energy consultation" />
        <div class="service-block__badge">03</div>
      </div>
      <div class="service-block__content">
        <span class="section-tag">വിദഗ്ധ മാർഗ്ഗനിർദേശം</span>
        <h2 class="section-title">കൺസൾട്ടേഷൻ സേവനങ്ങൾ</h2>
        <p>റയെന്നയുടെ കൺസൾട്ടേഷൻ സേവനങ്ങൾ സോളാർ ഊർജ്ജത്തിലേക്ക് മാറുന്ന മുഴുവൻ പ്രക്രിയയിലും സമഗ്ര മാർഗ്ഗനിർദേശം നൽകുന്നു. വിശദമായ സൈറ്റ് വിലയിരുത്തൽ, ഊർജ്ജ ഓഡിറ്റ് — നിങ്ങളുടെ സ്ഥലത്തിൽ സോളാറിന് ഏറ്റവും വലിയ പ്രഭാവം എവിടെയാണെന്ന് കണ്ടെത്താൻ.</p>
        <p>സാമ്പത്തിക വശങ്ങളും ഞങ്ങൾ സഹായിക്കുന്നു — ലഭ്യമായ പ്രോത്സാഹനങ്ങൾ, സാധ്യമായ സമ്പാദ്യം, സോളാർ നിക്ഷേപത്തിൽ മികച്ച തിരിച്ചടി. ഏറ്റവും പുതിയ നികുതി ഇളവുകളും സാമ്പത്തിക പ്രോത്സാഹനങ്ങളും ഞങ്ങളുടെ വിദഗ്ധർ അപ്ഡേറ്റ് ചെയ്യുന്നു.</p>

        <div class="consult-features">
          {[
            { icon: '📋', title: 'സൈറ്റ് വിലയിരുത്തൽ', text: 'നിങ്ങളുടെ സ്ഥലത്തിന്റെ സോളാർ സാധ്യതയുടെ വിശദ വിലയിരുത്തൽ.' },
            { icon: '⚡', title: 'ഊർജ്ജ ഓഡിറ്റ്', text: 'നിലവിലെ ഉപഭോഗ പാറ്റേണുകൾ മനസ്സിലാക്കൽ.' },
            { icon: '💰', title: 'സാമ്പത്തിക മാർഗ്ഗനിർദേശം', text: 'പ്രോത്സാഹനങ്ങൾ, സബ്സിഡി, ROI വിശകലനം.' },
            { icon: '📊', title: 'വ്യക്തിഗത പ്രൊപ്പോസൽ', text: 'നിങ്ങൾക്കായി മാത്രം ക്രമീകരിച്ച സിസ്റ്റം ശുപാർശ.' },
          ].map(f => (
            <div class="consult-feature">
              <span class="consult-feature__icon">{f.icon}</span>
              <div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            </div>
          ))}
        </div>
        <a href={`${mlPrefix}/solar-calculator/`} class="service-calc-cta">ശരിയായ സിസ്റ്റം വലുപ്പം കണ്ടെത്തുക → കാൽക്കുലേറ്റർ പരീക്ഷിക്കുക</a>
      </div>
    </div>
  </section>

  <!-- ===== CTA BANNER ===== -->
  <section class="cta-banner">
    <div class="container cta-banner__inner">
      <div class="cta-banner__content">
        <h2>സോളാർ ഊർജ്ജത്തിലേക്ക് മാറാൻ തയ്യാറാണോ?</h2>
        <p>ഇന്ന് ഞങ്ങളെ ബന്ധപ്പെട്ട് കൺസൾട്ടേഷൻ ഷെഡ്യൂൾ ചെയ്ത് റയെന്ന നിങ്ങളുടെ ഊർജ്ജ ഉപയോഗം എങ്ങനെ മാറ്റുമെന്ന് കണ്ടെത്തുക.</p>
      </div>
      <div class="cta-banner__actions">
        <a href={`${mlPrefix}/contact/`} class="btn btn-primary">സൗജന്യ കൺസൾട്ടേഷൻ നേടുക</a>
        <a href={`${mlPrefix}/contact/`} class="btn btn-outline-white">ഇപ്പോൾ വിളിക്കുക</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ===========================
   Services Page — Mobile First
   =========================== */

/* ===== PAGE HERO ===== */
.page-hero {
  position: relative;
  min-height: 420px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding-bottom: 56px;
}
.page-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  z-index: 0;
}
.page-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
