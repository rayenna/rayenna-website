---
import Layout from '../../layouts/Layout.astro';
import { OG } from '../../i18n/og-images';
import { useTranslations } from '../../i18n/ui';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mlPrefix = '/ml';
const t = useTranslations('ml');
const pc = t.pageConvert.services;
---
<Layout lang="ml" title="കേരളത്തിലെ സോളാർ പാനൽ ഇൻസ്റ്റാളേഷൻ സേവനങ്ങൾ | റയെന്ന എനർജി" description="കേരളമെമ്പാടും വീട്ടുപയോഗ, കമർഷ്യൽ സോളാർ, കൺസൾട്ടേഷൻ സേവനങ്ങൾ. കൊച്ചിയിലെ MNRE അംഗീകൃത ഇൻസ്റ്റാളർ. PM സൂര്യ ഘർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ സൈറ്റ് സർവേ." ogImage={OG.services}>

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <img src={`${base}/media/services-hero-opt3.jpg`} alt="സൂര്യാസ്തമയത്തിൽ മേൽക്കൂരയിലെ സോളാർ പാനലുകൾ" class="page-hero__bg" />
    <div class="page-hero__overlay"></div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow">ഞങ്ങൾ നൽകുന്നത്</p>
      <h1 class="page-hero__title">കേരളത്തിലെ സോളാർ<br />ഇൻസ്റ്റാളേഷൻ സേവനങ്ങൾ</h1>
      <p class="page-hero__sub">ഓരോ വീടിനും ബിസിനസിനും അനുയോജ്യമായ സോളാർ പരിഹാരങ്ങൾ — MNRE അംഗീകൃത ഇൻസ്റ്റാളേഷൻ, സബ്സിഡി സഹായം.</p>
      <div class="page-hero__ctas">
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-primary">{pc.heroCalc}</a>
        <a href={`${mlPrefix}/contact/`} class="btn btn-outline-light">{pc.heroContact}</a>
      </div>
      <p class="page-hero__micro">{pc.heroMicro}</p>
      <p class="page-hero__phone">{pc.heroPhone} <a href="tel:+917907369304" data-analytics-location="services_hero">+91 7907 369 304</a></p>
    </div>
  </section>

  <!-- ===== INTRO ===== -->
  <section class="intro-section">
    <div class="container intro-section__inner">
      <div class="intro-section__content">
        <span class="section-tag">സമഗ്ര സോളാർ സേവനം</span>
        <h2 class="section-title">നിങ്ങൾക്കായി തയ്യാറാക്കിയ സോളാർ സേവനങ്ങൾ</h2>
        <p>ഓരോ വീടും വ്യത്യസ്തമാണ്. ഓരോ ബിസിനസ്സും വ്യത്യസ്തമാണ്. അതിനാൽ ഞങ്ങളുടെ സേവനങ്ങളും വ്യത്യസ്തമാണ് — ഓരോരുത്തർക്കും അനുയോജ്യമായ രീതിയിൽ. KSEB ബിൽ കുറയ്ക്കാൻ ആഗ്രഹിക്കുന്ന വീട്ടുടമ ആണോ? ദീർഘകാല ചെലവ് ലാഭം തേടുന്ന ബിസിനസ്സ് ആണോ? ആരായാലും, ശരിയായ പരിഹാരം ഞങ്ങളുടെ കൈയ്യിലുണ്ട്.</p>
        <p>മികച്ച ഘടകങ്ങൾ, വൈദഗ്ധ്യമുള്ള ഇൻസ്റ്റാളേഷൻ, ഇൻസ്റ്റാളേഷന് ശേഷവും നിലനിൽക്കുന്ന പിന്തുണ — ഇതാണ് ഓരോ റയെന്ന സിസ്റ്റത്തിന്റെയും അടിത്തറ. സൗരോർജ്ജം ഇനി ആർക്കും അകലെയല്ല — വീട്ടിലേക്കും ബിസിനസ്സിലേക്കും.</p>
      </div>
      <div class="intro-highlights">
        {[
          { num: '20+', label: 'ബ്രാൻഡുകൾ' },
          { num: '80%',  label: 'ശരാശരി ബിൽ കുറവ്' },
          { num: '3–4',  label: 'വർഷം ROI' },
          { num: '20',   label: 'വർഷ പാനൽ ആയുസ്' },
        ].map(s => (
          <div class="intro-highlight">
            <strong>{s.num}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SERVICE 1: DOMESTIC ===== -->
  <section class="service-block service-block--alt" id="domestic">
    <div class="container domestic-inner">

      <!-- Top row: image left, text right — both top-aligned -->
      <div class="domestic-top">
        <div class="service-block__image">
          <img src={`${base}/media/Drilling-solar.jpg`} alt="വീട്ടുപയോഗ സോളാർ പാനൽ ഇൻസ്റ്റാളേഷൻ" />
          <div class="service-block__badge">01</div>
        </div>
        <div class="service-block__content">
          <span class="section-tag">വീട്ടുപയോഗ</span>
          <h2 class="section-title">വീട്ടിലേക്കുള്ള സോളാർ സേവനങ്ങൾ</h2>
          <p>സോളാർ പാനൽ വെക്കുന്നത് വെറും ബിൽ കുറയ്ക്കലല്ല — അത് നിങ്ങളുടെ വീടിനെ ഊർജ്ജ സ്വതന്ത്രമാക്കലാണ്. വീട്ടാവശ്യങ്ങൾക്കോ, EV ചാർജിംഗിനോ, അതോ ഓരോ മാസവും വരുന്ന ആ കറന്റ് ബിൽ ഞെട്ടൽ ഒഴിവാക്കാനോ — ഏത് ആവശ്യത്തിനും ഞങ്ങൾ ശരിയായ സിസ്റ്റം തയ്യാറാക്കും.</p>
          <p>ചെറിയ വീടായാലും വലിയ വീടായാലും, റയെന്ന നിങ്ങൾക്ക് അനുയോജ്യമായ സോളാർ സിസ്റ്റം ഡിസൈൻ ചെയ്യും. ശരിയായ പരിചരണത്തോടെ 25 വർഷം വരെ കാര്യക്ഷമമായി പ്രവർത്തിക്കും — നിക്ഷേപം 3–5 വർഷത്തിനുള്ളിൽ തിരിച്ചെടുക്കാം. അതിനുശേഷം? വർഷങ്ങളോളം സൗജന്യ വൈദ്യുതി.</p>
          <a href={`${mlPrefix}/solar-calculator/`} class="service-calc-cta">ശരിയായ സിസ്റ്റം വലുപ്പം കണ്ടെത്തുക → കാൽക്കുലേറ്റർ പരീക്ഷിക്കുക</a>
        </div>
      </div>

      <!-- Bottom row: 3 steps horizontally -->
      <div class="service-steps-h">
        <div class="service-step-h">
          <div class="service-step__num">01</div>
          <div class="service-step__body">
            <h3>സൈറ്റ് പരിശോധന</h3>
            <p>റൂഫ് ഡിസൈൻ, നിഴൽ, ഊർജ്ജ ആവശ്യം — ഇവ കൃത്യമായി വിലയിരുത്തി സിസ്റ്റം പരമാവധി ഫലപ്രദമാകുന്ന രീതിയിൽ ആസൂത്രണം ചെയ്യുന്നു.</p>
          </div>
        </div>
        <div class="service-step-h">
          <div class="service-step__num">02</div>
          <div class="service-step__body">
            <h3>രജിസ്ട്രേഷനും സബ്സിഡിയും</h3>
            <p>എല്ലാ രേഖകളും സർക്കാർ രജിസ്ട്രേഷനും ഞങ്ങൾ കൈകാര്യം ചെയ്യുന്നു — PM സൂര്യ ഘർ സബ്സിഡി ₹78,000 വരെ ലഭ്യം.</p>
          </div>
        </div>
        <div class="service-step-h">
          <div class="service-step__num">03</div>
          <div class="service-step__body">
            <h3>ഇൻസ്റ്റാളേഷൻ — തുടക്കം മുതൽ അവസാനം വരെ</h3>
            <p>പരിശീലനം പൂർത്തിയാക്കിയ എഞ്ചിനീയർമാർ — ഇൻസ്റ്റാൾ, പരിശോധന, കമ്മിഷനിംഗ്, പൂർണ്ണ സിസ്റ്റം പരിശീലനം — ഒരൊറ്റ ടീം. 🔥</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ===== SERVICE 2: COMMERCIAL ===== -->
  <section class="service-block" id="commercial">
    <div class="container service-block__inner service-block__inner--flip">
      <div class="service-block__content">
        <span class="section-tag">ബിസിനസും വ്യവസായവും</span>
        <h2 class="section-title">ബിസിനസ്സിനുള്ള സോളാർ സേവനങ്ങൾ</h2>
        <p>കറന്റ് ബിൽ ഒരു ബിസിനസ്സിന്റെ ഏറ്റവും വലിയ ഭാരങ്ങളിൽ ഒന്നാണ്. റയെന്ന അത് മാറ്റുന്നു. ഹോട്ടലുകൾ, റെസ്റ്റോറന്റുകൾ, കമ്മേഴ്സ്യൽ കെട്ടിടങ്ങൾ — സോളാർ ഇൻസ്റ്റാൾ ചെയ്യുന്നതോടെ പ്രവർത്തന ചെലവ് ഗണ്യമായി കുറയുന്നു. അതോടൊപ്പം, പരിസ്ഥിതി ബോധമുള്ള ഉപഭോക്താക്കളെയും നിക്ഷേപകരെയും ആകർഷിക്കുന്ന ഒരു ഗ്രീൻ ബ്രാൻഡ് ഇമേജും കൈവരുന്നു.</p>
        <p>മികച്ച ഘടകങ്ങൾ, ദീർഘകാല പ്രകടനം, തത്സമയ ഓൺലൈൻ മോണിറ്ററിംഗ് — ഇതെല്ലാം ചേർന്ന് നിങ്ങളുടെ ബിസിനസ്സ് യാതൊരു തടസ്സങ്ങളുമില്ലാതെ മുന്നോട്ട് പോകുന്നു. ആവശ്യം വരുമ്പോൾ മെയ്ൻറ്റനൻസ് അലേർട്ടും പ്രോആക്ടീവ് സപ്പോർട്ടും — ഞങ്ങൾ എപ്പോഴും കൂടെയുണ്ട്.</p>
        <div class="service-perks">
          {[
            '⚡ വൈദ്യുതി ചെലവിൽ ഗണ്യമായ കുറവ്',
            '🔩 മികച്ച ഘടകങ്ങൾ, ദീർഘകാല ഉറപ്പ്',
            '📊 തത്സമയ പ്രകടന മോണിറ്ററിംഗ്',
            '🌿 ഗ്രീൻ ബ്രാൻഡ് — ഉപഭോക്താക്കളും നിക്ഷേപകരും ശ്രദ്ധിക്കും',
          ].map(p => (
            <div class="service-perk">
              <span>{p}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="service-block__image">
        <img src={`${base}/media/Plan-solar.webp`} alt="കമർഷ്യൽ സോളാർ ഇൻസ്റ്റാളേഷൻ" />
        <div class="service-block__badge">02</div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICE 3: CONSULTATION ===== -->
  <section class="service-block service-block--alt" id="consultation">
    <div class="container service-block__inner">
      <div class="service-block__image">
        <img src={`${base}/media/Hardshell-solar.webp`} alt="സോളാർ ഊർജ്ജ കൺസൾട്ടേഷൻ" />
        <div class="service-block__badge">03</div>
      </div>
      <div class="service-block__content">
        <span class="section-tag">വിദഗ്ധ ഉപദേശം</span>
        <h2 class="section-title">കൺസൾട്ടേഷൻ സേവനങ്ങൾ</h2>
        <p>സോളാറിലേക്ക് മാറുന്നത് എവിടെ തുടങ്ങണം എന്ന് അറിയില്ലേ? അതാണ് ഞങ്ങൾ ആദ്യം ചെയ്യുന്നത്. സൈറ്റ് പരിശോധന മുതൽ ഊർജ്ജ വിശകലനം വരെ — നിങ്ങളുടെ സ്ഥലത്തിന് ഏറ്റവും അനുയോജ്യമായ സോളാർ പരിഹാരം ഞങ്ങൾ കണ്ടെത്തും.</p>
        <p>സബ്സിഡി, നികുതി ആനുകൂല്യങ്ങൾ, ROI — ഇതെല്ലാം മനസ്സിലാക്കുന്നത് ആർക്കും എളുപ്പമല്ല. ആ ഭാരം ഞങ്ങൾ ഏറ്റെടുക്കുന്നു. നിങ്ങളുടെ നിക്ഷേപം പരമാവധി ഫലം തരുന്നുണ്ടെന്ന് ഉറപ്പാക്കാൻ ഞങ്ങളുടെ ടീം എപ്പോഴും കൂടെയുണ്ട്.</p>

        <div class="consult-features">
          {[
            { icon: '📋', title: 'സൈറ്റ് പരിശോധന', text: 'നിങ്ങളുടെ സ്ഥലത്തിന്റെ സോളാർ സാധ്യത നേരിൽ കണ്ട് കൃത്യമായി വിലയിരുത്തുന്നു.' },
            { icon: '⚡', title: 'ഊർജ്ജ വിശകലനം', text: 'നിലവിലെ വൈദ്യുതി ഉപഭോഗം മനസ്സിലാക്കി ഏറ്റവും അനുയോജ്യമായ സിസ്റ്റം നിർദ്ദേശിക്കുന്നു.' },
            { icon: '💰', title: 'സാമ്പത്തിക ഉപദേശം', text: 'സബ്സിഡി, പ്രോത്സാഹനങ്ങൾ, ROI — നിങ്ങളുടെ നിക്ഷേപം പരമാവധി ഫലം തരുന്നുണ്ടെന്ന് ഉറപ്പാക്കുന്നു.' },
            { icon: '📊', title: 'നിങ്ങൾക്കായി മാത്രം', text: 'നിങ്ങളുടെ വീടിനും ബിസിനസ്സിനും മാത്രമായി തയ്യാറാക്കിയ സോളാർ ശുപാർശ.' },
          ].map(f => (
            <div class="consult-feature">
              <span class="consult-feature__icon">{f.icon}</span>
              <div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            </div>
          ))}
        </div>
        <a href={`${mlPrefix}/solar-calculator/`} class="service-calc-cta">ശരിയായ സിസ്റ്റം വലുപ്പം കണ്ടെത്തുക → കാൽക്കുലേറ്റർ പരീക്ഷിക്കുക</a>
      </div>
    </div>
  </section>

  <!-- ===== CTA BANNER ===== -->
  <section class="cta-banner">
    <div class="container cta-banner__inner">
      <div class="cta-banner__content">
        <h2>{pc.ctaTitle}</h2>
        <p>{pc.ctaSub}</p>
        <p>{pc.ctaSub2}</p>
      </div>
      <div class="cta-banner__actions">
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-primary">{pc.ctaCalc}</a>
        <a href={`${mlPrefix}/contact/`} class="btn btn-outline-white">{pc.ctaContact}</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ===========================
   Services Page — Mobile First
   =========================== */

/* ===== PAGE HERO ===== */
.page-hero {
  position: relative;
  min-height: 420px;
  display: flex;
