---
import Layout from '../../layouts/Layout.astro';
import { faqCategoriesMl as categories } from '../../i18n/faqs-ml';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mlPrefix = '/ml';
const FAQ_COUNT_HINT = '6 വിഷയങ്ങളിൽ 45 ചോദ്യങ്ങൾ';
---
<Layout lang="ml" title="സോളാർ ചോദ്യോത്തരങ്ങൾ കേരളം | റയെന്ന എനർജി" description="കേരളത്തിലെ സോളാർ — ചെലവ്, PM സൂര്യ ഘർ സബ്സിഡി, KSEB നെറ്റ് മീറ്ററിംഗ്, ഇൻസ്റ്റാളേഷൻ, പരിപാലനം.">

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <img src={`${base}/media/federico-beccari-ahi73ZN5P0Y-unsplash.jpg`} alt="റയെന്ന സോളാർ FAQ" class="page-hero__bg" />
    <div class="page-hero__overlay"></div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow">അറിവ് ബേസ്</p>
      <h1 class="page-hero__title">കേരള വീടുകൾക്കുള്ള<br />സോളാർ ചോദ്യോത്തരങ്ങൾ</h1>
      <p class="page-hero__sub">സോളാറിലേക്ക് മാറുന്നതിനെക്കുറിച്ചുള്ള എല്ലാ ചോദ്യങ്ങൾക്കും വ്യക്തമായ ഉത്തരങ്ങൾ.</p>
      <p class="page-hero__count">6 വിഷയങ്ങളിൽ 45 ചോദ്യങ്ങൾ</p>
    </div>
  </section>


  <!-- ===== SEARCH + CATEGORY NAV ===== -->
  <div class="faq-nav-wrap" id="faq-nav-wrap">
    <!-- Search row -->
    <div class="faq-search-row">
      <div class="container faq-search-inner">
        <div class="faq-search-field">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="faq-search" placeholder="ചോദ്യം തിരയുക…" autocomplete="off" aria-label="ചോദ്യോത്തരങ്ങൾ തിരയുക" />
          <button class="faq-search-clear" id="faq-search-clear" aria-label="മായ്ക്കുക">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <p class="faq-search-hint" id="faq-search-hint">{FAQ_COUNT_HINT}</p>
      </div>
    </div>

    <!-- Category pills -->
    <nav class="cat-nav" aria-label="ചോദ്യോത്തര വിഭാഗങ്ങൾ">
      <div class="container">
        <div class="cat-nav__inner" id="cat-nav-inner">
          <button class="cat-pill cat-pill--active" data-filter="all">എല്ലാം</button>
          {categories.map(c => (
            <button class="cat-pill" data-filter={c.id}>
              <span class="cat-pill__emoji">{c.emoji}</span>
              <span>{c.label}</span>
              <span class="cat-pill__count">{c.count}</span>
            </button>
          ))}
        </div>
      </div>
    </nav>
  </div>

  <!-- ===== FAQ BODY ===== -->
  <div class="faq-body" id="faq-body">

    <div class="no-results" id="no-results" style="display:none">
      <div class="no-results__icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
      <p>നിങ്ങളുടെ തിരയലുമായി പൊരുത്തപ്പെടുന്ന ചോദ്യങ്ങളൊന്നുമില്ല.</p>
      <button id="clear-search-btn" class="btn btn-primary" style="margin-top:20px;padding:10px 28px;font-size:0.88rem;">തിരയൽ മായ്ക്കുക</button>
    </div>

    {categories.map((cat, ci) => (
      <section class="faq-category" id={`cat-${cat.id}`} data-category={cat.id}>
        <div class="container">
          <div class="faq-category__header">
            <span class="section-tag">{cat.emoji} {cat.label}</span>
          </div>

          <div class="accordion" data-cat={cat.id}>
            {cat.faqs.map((faq, fi) => (
              <div class="accordion-item" data-question={faq.q.toLowerCase()}>
                <button class="accordion-trigger" aria-expanded="false">
                  <span class="accordion-num">0{fi + 1}</span>
                  <span class="accordion-q">{faq.q}</span>
                  <span class="accordion-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </button>
                <div class="accordion-panel">
                  <div class="accordion-panel__body">
                    <p>{faq.a}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- ===== SUBSIDY HIGHLIGHT ===== -->
  <section class="subsidy-section">
    <div class="container subsidy-inner">
      <div class="subsidy-img-col">
        <img
          src="https://images.unsplash.com/photo-1509391366360-2e959784a276?w=800&q=80&auto=format&fit=crop"
          alt="വീട്ടു മേൽക്കൂരയിലെ സോളാർ പാനലുകൾ"
          class="subsidy-photo"
          loading="lazy"
        />
        <div class="subsidy-badge">
          <strong>₹78,000</strong>
          <span>പരമാവധി സബ്സിഡി ലഭ്യം</span>
        </div>
      </div>
      <div class="subsidy-content-col">
        <span class="section-tag">PM സൂര്യ ഘർ പദ്ധതി</span>
        <h2 class="section-title">സർക്കാർ സബ്സിഡിയായ <span>₹78,000</span> നഷ്ടപ്പെടുത്തരുത്</h2>
        <p class="subsidy-desc">PM സൂര്യ ഘർ: മുഫ്ത് ബിജ്ളി യോജന MNRE-എംപാനൽ ചെയ്ത ഇൻസ്റ്റാളർമാർ വഴി മാത്രമേ ലഭ്യമാകൂ. സർട്ടിഫൈഡ് ചാനൽ പാർട്ണറായി റയെന്ന എനർജി രേഖകൾ, പോർട്ടൽ സമർപ്പണം, KSEB അംഗീകാരങ്ങൾ, ബാങ്ക് ക്രെഡിറ്റ് എന്നിവ മുഴുവനും നിങ്ങൾക്ക് വേണ്ടി കൈകാര്യം ചെയ്യുന്നു — അധിക ചെലവില്ല.</p>
        <ul class="subsidy-points">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            പരമാവധി ₹78,000 നേരിട്ട് നിങ്ങളുടെ ബാങ്കിലേക്ക്
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            റയെന്ന പോലുള്ള MNRE-അംഗീകൃത വെൻഡർമാർ വഴി മാത്രം
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            കമ്മീഷനിംഗിന് ശേഷം 30 പ്രവൃത്തി ദിവസത്തിനുള്ളിൽ ക്രെഡിറ്റ്
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            എല്ലാ രേഖകളും ഞങ്ങൾ കൈകാര്യം ചെയ്യുന്നു — നിങ്ങൾ അംഗീകരിക്കുക മാത്രം
          </li>
        </ul>
        <a href={`${mlPrefix}/contact/`} class="btn btn-primary">എന്റെ യോഗ്യത പരിശോധിക്കുക</a>
      </div>
    </div>
  </section>

  <!-- ===== WARRANTY STRIP ===== -->
  <section class="warranty-strip">
    <div class="container">
      <div class="section-header-center">
        <span class="section-tag">മനസ്സമാധാനം</span>
        <h2 class="section-title text-center">എല്ലാം വാറന്റിയോടെ</h2>
      </div>
      <div class="warranty-cards">
        <div class="warranty-card">
          <div class="warranty-card__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <strong>25 വർഷം</strong>
          <p>പാനൽ പെർഫോർമൻസ് വാറന്റി — 85%+ ഉത്പാദനം ഉറപ്പ്</p>
        </div>
        <div class="warranty-card">
          <div class="warranty-card__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
          </div>
          <strong>5–10 വർഷം</strong>
          <p>ഞങ്ങൾ ഇൻസ്റ്റാൾ ചെയ്യുന്ന എല്ലാ പ്രധാന ബ്രാൻഡുകൾക്കും ഇൻവെർട്ടർ വാറന്റി</p>
        </div>
        <div class="warranty-card">
          <div class="warranty-card__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <strong>5 വർഷം</strong>
          <p>ഇൻസ്റ്റാളേഷൻ ഗുണനിലവാരത്തിനും റൂഫ് സീലിംഗിനും വർക്ക്മാൻഷിപ്പ് വാറന്റി</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CALCULATOR CTA ===== -->
  <section style="padding: 0 0 8px; background: var(--color-light)">
    <div class="container">
      <div class="calc-cta-card">
        <p class="calc-cta-card__heading">☀️ നിങ്ങളുടെ സോളാർ സമ്പാദ്യം കാണുക</p>
        <p class="calc-cta-card__sub">ഞങ്ങളുടെ സൗജന്യ കാൽക്കുലേറ്റർ — 5 മിനിറ്റിനുള്ളിൽ വ്യക്തിഗത ശുപാർശ.</p>
        <a href={`${mlPrefix}/solar-calculator/`} class="calc-cta-card__btn">എന്റെ സമ്പാദ്യം കണക്കാക്കുക →</a>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="faq-cta">
    <img src={`${base}/media/glass-BG.webp`} alt="" class="faq-cta__bg" />
    <div class="faq-cta__overlay"></div>
    <div class="container faq-cta__inner">
      <h2 class="faq-cta__title">ഇനിയും ചോദ്യങ്ങളുണ്ടോ?</h2>
      <p class="faq-cta__sub">ഞങ്ങളുടെ സോളാർ വിദഗ്ധർ ഒരു കോൾ അല്ലെങ്കിൽ സന്ദേശം അകലെയല്ല. സൗജന്യ കൺസൾട്ടേഷൻ, സത്യസന്ധമായ ഉത്തരങ്ങൾ, സമ്മർദ്ദമില്ല.</p>
      <div class="faq-cta__actions">
        <a href={`${mlPrefix}/contact/`} class="btn btn-primary">വിദഗ്ധനുമായി സംസാരിക്കുക</a>
        <a href="tel:+917907369304" class="faq-cta__call">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.69 3.18 2 2 0 0 1 3.68 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.69A16 16 0 0 0 16 16.61l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          +91 7907 369 304
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ============================
   FAQ Page — Mobile First
   Aligned with About / Services / Contact
   ============================ */

/* ===== PAGE HERO ===== */
.page-hero {
  position: relative;
  min-height: 420px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding-bottom: 56px;
}
.page-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 45%;
  z-index: 0;
}
.page-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(10, 25, 50, 0.88) 0%,
    rgba(10, 25, 50, 0.45) 50%,
    rgba(10, 25, 50, 0.15) 100%
  );
  z-index: 1;
}
.page-hero__inner {
  position: relative;
  z-index: 2;
  padding-top: 88px;
}
.page-hero__eyebrow {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  margin-bottom: 10px;
}
.page-hero__title {
  font-family: var(--font-heading);
  font-size: clamp(2.2rem, 5vw, 3.6rem);
  font-weight: 500;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 14px;
}
.page-hero__sub {
  font-size: clamp(0.92rem, 2vw, 1rem);
  color: rgba(255,255,255,0.70);
  max-width: 500px;
  line-height: 1.8;
  margin-bottom: 16px;
}
.page-hero__count {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 99px;
  padding: 5px 14px;
}

/* ===== SEARCH + NAV WRAPPER ===== */
.faq-nav-wrap {
  background: #fff;
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 64px;
  z-index: 100;
  box-shadow: 0 2px 16px rgba(0,0,0,0.06);
}

/* Search row */
.faq-search-row {
  border-bottom: 1px solid var(--color-border);
  padding: 14px 0;
}
.faq-search-row .container {
  padding: var(--container-pad);
}
.faq-search-inner {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.faq-search-field {
  position: relative;
  flex: 1;
  min-width: 200px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--color-light);
  border: 2px solid var(--color-border);
  border-radius: 99px;
  padding: 9px 16px;
  transition: border-color 0.2s;
}
.faq-search-field:focus-within {
  border-color: var(--color-primary);
  background: #fff;
}
.faq-search-field svg { color: var(--color-text-muted); flex-shrink: 0; }
.faq-search-field input {
  border: none;
  background: none;
  outline: none;
  font-family: var(--font-body);
  font-size: 0.9rem;
  color: var(--color-text);
  width: 100%;
}
.faq-search-field input::placeholder { color: var(--color-text-muted); }
.faq-search-clear {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text-muted);
  display: none;
  padding: 2px;
  flex-shrink: 0;
}
.faq-search-clear.visible { display: flex; }
.faq-search-hint {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  white-space: nowrap;
}

/* Category pills */
.cat-nav { overflow: hidden; }
.cat-nav__inner {
  display: flex;
  gap: 4px;
  padding: 10px 24px 10px 24px;
  overflow-x: auto;
  scrollbar-width: none;
  /* Ensure last pill is never clipped */
  -webkit-overflow-scrolling: touch;
}
.cat-nav__inner::-webkit-scrollbar { display: none; }
/* Remove the container's side padding so pills scroll edge-to-edge */
.cat-nav .container {
  padding: 0;
  max-width: 100%;
  overflow: hidden;
}
.cat-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 16px;
  border-radius: 99px;
  border: 2px solid transparent;
  background: var(--color-light);
  color: var(--color-text-muted);
  font-family: var(--font-heading);
  font-size: 0.78rem;
  font-weight: 600;
  white-space: nowrap;
  cursor: pointer;
  transition: all 0.2s ease;
}
.cat-pill:hover {
  background: var(--color-primary-light);
  color: var(--color-primary);
}
.cat-pill--active {
  background: var(--color-primary);
  color: #fff;
}
.cat-pill__emoji { font-size: 0.85rem; }
.cat-pill__count {
  background: rgba(0,0,0,0.12);
  border-radius: 99px;
  font-size: 0.68rem;
  padding: 1px 6px;
  font-weight: 700;
}
.cat-pill--active .cat-pill__count { background: rgba(255,255,255,0.25); }

/* ===== FAQ BODY ===== */
.faq-body { background: var(--color-light); }

.no-results {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80px 24px;
  color: var(--color-text-muted);
  gap: 10px;
  text-align: center;
}
.no-results__icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

/* Category section */
.faq-category { padding: 52px 0 0; }
.faq-category:last-child { padding-bottom: 56px; }
.faq-category__header { margin-bottom: 24px; }

/* ===== ACCORDION ===== */
.accordion { display: flex; flex-direction: column; gap: 8px; }

.accordion-item {
  background: #fff;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  overflow: hidden;
  transition: box-shadow 0.25s ease, border-color 0.25s ease;
}
.accordion-item:hover { box-shadow: var(--shadow-sm); }
.accordion-item.is-open {
  border-color: rgba(168,56,56,0.3);
  box-shadow: var(--shadow-md);
}
.accordion-item--hidden { display: none; }

.accordion-trigger {
  width: 100%;
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 20px 22px;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
}
.accordion-num {
  font-family: var(--font-heading);
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--color-primary);
  opacity: 0.55;
  flex-shrink: 0;
  margin-top: 3px;
  min-width: 18px;
}
.accordion-q {
  flex: 1;
  font-family: var(--font-heading);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-navy);
  line-height: 1.5;
  transition: color 0.2s;
}
.accordion-item.is-open .accordion-q { color: var(--color-primary); }
.accordion-icon {
  flex-shrink: 0;
  color: var(--color-text-muted);
  margin-top: 2px;
  transition: transform 0.3s ease, color 0.2s;
}
.accordion-item.is-open .accordion-icon {
  transform: rotate(180deg);
  color: var(--color-primary);
}

.accordion-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}
.accordion-panel__body {
  padding: 0 22px 22px calc(22px + 14px + 18px);
  border-top: 1px solid var(--color-border);
  padding-top: 18px;
}
.accordion-panel__body p {
  color: var(--color-text-muted);
  font-size: 0.92rem;
  line-height: 1.9;
}

/* ===== SUBSIDY SECTION ===== */
.subsidy-section {
  padding: var(--section-padding);
  background: #fff;
}
.subsidy-inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
  align-items: center;
}
.subsidy-img-col {
  position: relative;
}
.subsidy-photo {
  width: 100%;
