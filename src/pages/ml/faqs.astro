  object-fit: cover;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}
.subsidy-badge {
  position: absolute;
  bottom: -18px;
  right: 20px;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-md);
  padding: 14px 22px;
  text-align: center;
  box-shadow: 0 8px 24px rgba(168,56,56,0.4);
}
.subsidy-badge strong {
  display: block;
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 800;
  line-height: 1;
}
.subsidy-badge span {
  display: block;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  opacity: 0.85;
  margin-top: 4px;
}
.subsidy-content-col { padding-top: 24px; }
.subsidy-desc {
  color: var(--color-text-muted);
  font-size: 0.95rem;
