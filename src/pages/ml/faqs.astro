}
.subsidy-points li svg { color: var(--color-primary); flex-shrink: 0; margin-top: 2px; }

/* ===== WARRANTY STRIP ===== */
.warranty-strip {
  padding: var(--section-padding);
  background: var(--color-light);
}
.section-header-center {
  text-align: center;
  margin-bottom: 40px;
}
.warranty-cards {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}
.warranty-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 32px 28px;
  text-align: center;
  box-shadow: var(--shadow-sm);
