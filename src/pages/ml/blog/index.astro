---
import Layout from '../../../layouts/Layout.astro';
import BlogPostEndCta from '../../../components/BlogPostEndCta.astro';
import { blogPostsListingMl } from '../../../i18n/blog-articles-ml/index.ts';
import { blogCategoriesMl, categoryLabel } from '../../../i18n/blog-ml.ts';
import { blogUiMlStrings as ui } from '../../../i18n/blog-ui';
import { OG } from '../../../i18n/og-images';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mlPrefix = '/ml';

const posts = blogPostsListingMl;
const featured = posts[0];
const rest = posts.slice(1);
const articleCountHint = `${posts.length} വിദഗ്ധ ലേഖനങ്ങൾ`;

const categoryKeys = ['all', ...new Set(posts.map((p) => p.categoryKey))] as const;
const filterLabels: Record<string, string> = {
  all: 'എല്ലാം',
  ...Object.fromEntries(
    Object.entries(blogCategoriesMl).map(([k, v]) => [k, v.label])
  ),
};
---
<Layout lang="ml" title="സോളാർ എനർജി ബ്ലോഗ് കേരളം | റയെന്ന എനർജി" description="കേരളത്തിലെ വീട്ടുടമസ്ഥർക്കുള്ള സോളാർ ലേഖനങ്ങൾ — ചെലവ്, PM സൂര്യ ഘർ സബ്സിഡി, KSEB നെറ്റ് മീറ്ററിംഗ്." ogImage={OG.blog}>

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <img src={`${base}/media/blog.webp`} alt="റയെന്ന സോളാർ ബ്ലോഗ്" class="page-hero__bg" />
    <div class="page-hero__overlay"></div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow">{ui.indexEyebrow}</p>
      <h1 class="page-hero__title">{ui.indexTitle}</h1>
      <p class="page-hero__sub">{ui.indexSub}</p>
      <p class="page-hero__count">{articleCountHint}</p>
      <div class="page-hero__actions">
        <a href={`${mlPrefix}/contact/`} class="btn btn-primary">{ui.indexQuoteBtn}</a>
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-outline-white">{ui.indexCalcBtn}</a>
      </div>
    </div>
  </section>

  <!-- ===== BLOG CONTENT ===== -->
  <section class="blog-section">
    <div class="container">

      <!-- Search -->
      <div class="blog-search-row">
        <div class="blog-search-field">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="blog-search" placeholder={ui.indexSearchPlaceholder} autocomplete="off" aria-label="ബ്ലോഗ് ലേഖനങ്ങൾ തിരയുക" />
          <button class="blog-search-clear" id="blog-search-clear" aria-label="മായ്ക്കുക">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <p class="blog-search-hint" id="blog-search-hint">{articleCountHint}</p>
      </div>

      <!-- Popular reads -->
      <div class="blog-popular">
        <p class="blog-popular__label">{ui.indexPopularLabel}</p>
        <div class="blog-popular__grid">
          {ui.indexPopularReads.map((item) => (
            <a href={`${mlPrefix}/blog/${item.slug}/`} class="blog-popular__chip">{item.label}</a>
          ))}
        </div>
      </div>

      <!-- Category filter -->
      <div class="category-filter-wrap">
        <div class="category-filter">
          {categoryKeys.map((key) => (
            <button
              class={`cat-btn ${key === 'all' ? 'active' : ''}`}
              data-cat={key}
            >
              {filterLabels[key]}
            </button>
          ))}
        </div>
      </div>

      <div class="no-results" id="blog-no-results" style="display:none">
        <p>{ui.indexNoResults}</p>
        <button type="button" id="blog-clear-search-btn" class="btn btn-primary">{ui.indexClearSearch}</button>
      </div>

      <!-- Featured post -->
      <article class="featured-card" data-category={featured.categoryKey} data-search={`${featured.title} ${featured.excerpt}`.toLowerCase()}>
        <div class="featured-card__label">
          <span class="featured-badge">{ui.indexFeaturedBadge}</span>
          <span
            class="cat-pill"
            style={`background:${blogCategoriesMl[featured.categoryKey].color}18; color:${blogCategoriesMl[featured.categoryKey].color};`}
          >
            {categoryLabel(featured.categoryKey)}
          </span>
          <span class="read-time">{featured.readTime}</span>
        </div>
        <h2 class="featured-card__title">
          <a href={`${mlPrefix}/blog/${featured.slug}/`}>{featured.title}</a>
        </h2>
        <p class="featured-card__excerpt">{featured.excerpt}</p>
        <div class="featured-card__footer">
          <span class="post-date">{featured.date}</span>
          <a href={`${mlPrefix}/blog/${featured.slug}/`} class="read-more-link">
            ലേഖനം വായിക്കുക
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </article>

      <!-- Posts grid -->
      <div class="posts-grid">
        {rest.map((post) => (
          <article class="post-card" data-category={post.categoryKey} data-search={`${post.title} ${post.excerpt}`.toLowerCase()}>
            <div
              class="post-card__accent"
              style={`background:${blogCategoriesMl[post.categoryKey].color};`}
            ></div>
            <div class="post-card__body">
              <div class="post-meta">
                <span
                  class="cat-pill"
                  style={`background:${blogCategoriesMl[post.categoryKey].color}18; color:${blogCategoriesMl[post.categoryKey].color};`}
                >
                  {categoryLabel(post.categoryKey)}
                </span>
                <span class="read-time">{post.readTime}</span>
              </div>
              <h2 class="post-title">
                <a href={`${mlPrefix}/blog/${post.slug}/`}>{post.title}</a>
              </h2>
              <p class="post-excerpt">{post.excerpt}</p>
              <div class="post-footer">
                <span class="post-date">{post.date}</span>
                <a href={`${mlPrefix}/blog/${post.slug}/`} class="read-more-link">
                  വായിക്കുക
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <BlogPostEndCta lang="ml" />

  <!-- ===== INSTALLATION CTA ===== -->
  <section class="blog-install-cta">
    <div class="container blog-install-cta__inner">
      <div class="blog-install-cta__copy">
        <span class="section-tag">{ui.indexInstallTag}</span>
        <h2 class="blog-install-cta__title">{ui.indexInstallTitle}</h2>
        <p class="blog-install-cta__sub">{ui.indexInstallSub}</p>
      </div>
      <a href={`${mlPrefix}/contact/`} class="btn btn-primary blog-install-cta__btn">{ui.indexInstallBtn}</a>
    </div>
  </section>

  <!-- ===== RESOURCE LINKS ===== -->
  <section class="blog-resources">
    <div class="container">
      <h2 class="blog-resources__heading">{ui.resourceHeading}</h2>
      <div class="blog-resources__grid">
        {ui.resources.map((link) => (
          <a href={`${base}${link.href}`} class="blog-resources__link">{link.label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== BOTTOM CTA ===== -->
  <section class="blog-bottom-cta">
    <img src={`${base}/media/glass-BG.webp`} alt="" class="blog-bottom-cta__bg" />
    <div class="blog-bottom-cta__overlay"></div>
    <div class="container blog-bottom-cta__inner">
      <h2 class="blog-bottom-cta__title">{ui.indexBottomTitle}</h2>
      <p class="blog-bottom-cta__sub">{ui.indexBottomSub}</p>
      <div class="blog-bottom-cta__actions">
        <a href={`${mlPrefix}/contact/`} class="btn btn-primary">{ui.indexBottomBtn}</a>
        <a href="tel:+917907369304" class="blog-bottom-cta__call">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.69 3.18 2 2 0 0 1 3.68 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.69A16 16 0 0 0 16 16.61l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          +91 7907 369 304
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ===========================
   Blog Page — Mobile First
   =========================== */

/* ===== PAGE HERO ===== */
.page-hero {
  position: relative;
  min-height: 420px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding-bottom: 56px;
}
.page-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
  z-index: 0;
}
.page-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(10, 25, 50, 0.9) 0%,
    rgba(10, 25, 50, 0.55) 50%,
    rgba(10, 25, 50, 0.2) 100%
  );
  z-index: 1;
}
.page-hero__inner {
  position: relative;
  z-index: 2;
  padding-top: 88px;
}
.page-hero__eyebrow {
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.65);
  margin-bottom: 10px;
}
.page-hero__title {
  font-family: var(--font-heading);
  font-size: clamp(1.45rem, 2.1vw, 2rem);
  font-weight: 500;
  color: #ffffff;
  line-height: 1.28;
  margin-bottom: 14px;
  text-wrap: balance;
  max-width: 18ch;
}
.page-hero__sub {
  font-size: clamp(0.95rem, 2vw, 1.05rem);
  color: rgba(255,255,255,0.72);
  max-width: 520px;
  line-height: 1.75;
  margin-bottom: 16px;
}
.page-hero__count {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 99px;
  padding: 5px 14px;
  margin-bottom: 20px;
}
.page-hero__actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  max-width: 360px;
}
.page-hero__actions .btn {
  width: 100%;
  justify-content: center;
  min-height: 52px;
}
.btn-outline-white {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 28px;
  border-radius: var(--radius-sm);
  border: 2px solid rgba(255,255,255,0.75);
  color: #fff;
  font-family: var(--font-heading);
  font-size: 0.92rem;
  font-weight: 600;
  background: transparent;
  transition: background 0.2s ease, border-color 0.2s ease;
}
.btn-outline-white:hover {
  background: rgba(255,255,255,0.12);
  border-color: #fff;
}

/* ===== BLOG SECTION ===== */
.blog-section {
  padding: var(--section-padding);
  background: var(--color-light);
}

/* Search */
.blog-search-row {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}
.blog-search-field {
  position: relative;
  flex: 1;
  min-width: 200px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
  border: 2px solid var(--color-border);
  border-radius: 99px;
  padding: 9px 16px;
  transition: border-color 0.2s;
}
.blog-search-field:focus-within {
  border-color: var(--color-primary);
}
.blog-search-field svg { color: var(--color-text-muted); flex-shrink: 0; }
.blog-search-field input {
  border: none;
  background: none;
  outline: none;
  font-family: var(--font-body);
  font-size: 0.9rem;
  color: var(--color-text);
  width: 100%;
}
.blog-search-field input::placeholder { color: var(--color-text-muted); }
.blog-search-clear {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text-muted);
  display: none;
  padding: 2px;
  flex-shrink: 0;
}
.blog-search-clear.visible { display: flex; }
.blog-search-hint {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  white-space: nowrap;
}

/* Popular reads */
.blog-popular { margin-bottom: 22px; }
.blog-popular__label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin-bottom: 12px;
}
.blog-popular__grid {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 2px;
  -webkit-overflow-scrolling: touch;
}
.blog-popular__grid::-webkit-scrollbar { display: none; }
.blog-popular__chip {
  flex-shrink: 0;
  border: 1px solid var(--color-border);
  background: #fff;
  color: var(--color-navy);
  border-radius: 99px;
  padding: 9px 16px;
  font-family: var(--font-heading);
  font-size: 0.78rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.blog-popular__chip:hover {
  border-color: rgba(168,56,56,0.35);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* Category filter */
.category-filter-wrap { overflow: hidden; margin-bottom: 28px; }
.category-filter {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 4px;
  -webkit-overflow-scrolling: touch;
}
.category-filter::-webkit-scrollbar { display: none; }
.no-results {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 48px 24px;
  text-align: center;
  color: var(--color-text-muted);
}
.cat-btn {
  padding: 7px 18px;
  border-radius: 50px;
  border: 2px solid var(--color-border);
  background: var(--color-white);
  font-family: var(--font-heading);
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  color: var(--color-text-muted);
  transition: all var(--transition);
  white-space: nowrap;
}
.cat-btn:hover, .cat-btn.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #ffffff;
}

/* ===== FEATURED CARD ===== */
.featured-card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 36px 32px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 28px;
  border-left: 5px solid var(--color-primary);
  transition: all var(--transition);
  display: flex;
  flex-direction: column;
}
.featured-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}
.featured-card__label {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}
.featured-badge {
  font-family: var(--font-heading);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 3px 10px;
  border-radius: 99px;
}
.featured-card__title {
  font-family: var(--font-heading);
  font-size: clamp(1.2rem, 2.5vw, 1.7rem);
  font-weight: 600;
  color: var(--color-navy);
  line-height: 1.35;
  margin-bottom: 14px;
}
.featured-card__title a { transition: color var(--transition); }
.featured-card__title a:hover { color: var(--color-primary); }
.featured-card__excerpt {
  font-size: 0.95rem;
  color: var(--color-text-muted);
  line-height: 1.8;
  margin-bottom: 24px;
  max-width: 720px;
}
.featured-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  padding-top: 20px;
  border-top: 1px solid var(--color-border);
}

/* ===== POST GRID ===== */
.posts-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}
.post-card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  transition: all var(--transition);
}
.post-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-4px);
}
.post-card__accent {
  height: 4px;
  width: 100%;
  flex-shrink: 0;
}
.post-card__body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.post-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

/* Category pill */
.cat-pill {
  font-family: var(--font-heading);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  padding: 3px 10px;
  border-radius: 50px;
}
.read-time {
  font-size: 0.78rem;
  color: var(--color-text-muted);
}
.post-title {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-navy);
  line-height: 1.45;
  margin-bottom: 10px;
}
.post-title a { transition: color var(--transition); }
.post-title a:hover { color: var(--color-primary); }
.post-excerpt {
  font-size: 0.86rem;
  color: var(--color-text-muted);
  line-height: 1.75;
  flex: 1;
  margin-bottom: 18px;
}
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14px;
  border-top: 1px solid var(--color-border);
  gap: 8px;
}
.post-date {
  font-size: 0.78rem;
  color: var(--color-text-muted);
}
.read-more-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-heading);
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--color-primary);
  transition: gap var(--transition);
  white-space: nowrap;
}
.read-more-link:hover { gap: 8px; }

/* ===== INSTALLATION CTA ===== */
.blog-install-cta {
  padding: 40px 0;
  background: linear-gradient(135deg, rgba(168,56,56,0.08) 0%, rgba(10,25,50,0.04) 100%);
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}
.blog-install-cta__inner {
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: flex-start;
}
.blog-install-cta__title {
  font-family: var(--font-heading);
  font-size: clamp(1.35rem, 3vw, 1.85rem);
  font-weight: 600;
  color: var(--color-navy);
  line-height: 1.35;
  margin: 8px 0 10px;
}
.blog-install-cta__sub {
  color: var(--color-text-muted);
  font-size: 0.92rem;
  line-height: 1.75;
  max-width: 560px;
}
.blog-install-cta__btn {
  width: 100%;
  justify-content: center;
  min-height: 52px;
}

/* ===== RESOURCE LINKS ===== */
.blog-resources {
  padding: 48px 0;
  background: #fff;
}
.blog-resources__heading {
  font-family: var(--font-heading);
  font-size: clamp(1.2rem, 2.5vw, 1.5rem);
  font-weight: 600;
  color: var(--color-navy);
  margin-bottom: 20px;
  text-align: center;
}
.blog-resources__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
}
.blog-resources__link {
  display: inline-flex;
  align-items: center;
  padding: 10px 18px;
  border-radius: 99px;
  border: 1px solid var(--color-border);
  background: var(--color-light);
  color: var(--color-navy);
  font-family: var(--font-heading);
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
}
.blog-resources__link:hover {
  border-color: rgba(168,56,56,0.35);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* ===== BOTTOM CTA ===== */
.blog-bottom-cta {
  position: relative;
  min-height: 360px;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.blog-bottom-cta__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
}
.blog-bottom-cta__overlay {
  position: absolute;
  inset: 0;
  background: rgba(8, 18, 40, 0.87);
  z-index: 1;
}
.blog-bottom-cta__inner {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 64px 24px;
}
.blog-bottom-cta__title {
  font-family: var(--font-heading);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
