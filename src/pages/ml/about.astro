---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mlPrefix = '/ml';
---
<Layout lang="ml" title="ഞങ്ങളെക്കുറിച്ച് | റയെന്ന എനർജി" description="വ്യറ്റിലയിലെ MNRE അംഗീകൃത സോളാർ കമ്പനി. കേരളമെമ്പാടും വീട്ടുപയോഗ, കമർഷ്യൽ ഇൻസ്റ്റാളേഷൻ. PM സൂര്യ ഘർ സബ്സിഡി സഹായം.">

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero">
    <img src={`${base}/media/hero-copy.jpg`} alt="റയെന്ന എനർജി സോളാർ ഇൻസ്റ്റാളേഷൻ" class="page-hero__bg" />
    <div class="page-hero__overlay"></div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow">ഉത്തരവിത്തമുള്ള ഊർജ്ജ കമ്പനി</p>
      <h1 class="page-hero__title">കേരളത്തിന്റെ സ്വന്തം<br />സോളാർ കമ്പനി.</h1>
      <p class="page-hero__sub">മേൽക്കൂര തോറും ഊർജ്ജ വിപ്ലവം.</p>
    </div>
  </section>

  <!-- ===== WHO WE ARE ===== -->
  <section class="intro-section">
    <div class="container intro-section__inner">
      <div class="intro-section__image">
        <img src={`${base}/media/Solar-Kochi-workers.jpg`} alt="റയെന്ന ഇൻസ്റ്റാളേഷൻ ടീം പ്രവർത്തിക്കുന്നു" />
      </div>
      <div class="intro-section__content">
        <span class="section-tag">ഞങ്ങൾ ആരാണ്</span>
        <h2 class="section-title">നാളത്തെ ഊർജ്ജം. ഇന്നത്തെ മേൽക്കൂരയിൽ.</h2>
        <p>റയെന്ന എനർജി കേരളത്തിലെ ഉപഭോക്താക്കളെ ഊർജ്ജ സ്വതന്ത്രമാക്കുന്നതിനായി പ്രതിജ്ഞാബദ്ധമായ ഒരു സോളാർ കമ്പനിയാണ്. സുസ്ഥിരത, കാര്യക്ഷമത, താങ്ങാനാവുന്ന വില — ഈ മൂന്ന് തത്ത്വങ്ങൾ ഞങ്ങളുടെ ഓരോ ഇൻസ്റ്റാളേഷന്റെയും അടിത്തറയാണ്. ഒരു ഹരിത ഭാവി കെട്ടിപ്പടുക്കുക — അതാണ് ഞങ്ങളുടെ ദൗത്യം.</p>
        <p>സോളാറിലേക്ക് മാറുന്നത് വെറും ബിൽ കുറയ്ക്കൽ മാത്രമല്ല — അത് നിങ്ങളുടെ കുടുംബത്തിനും വരും തലമുറകൾക്കും ഒരു സമ്മാനമാണ്. ആ തീരുമാനം ശരിയാക്കാൻ ഞങ്ങളുടെ ടീമിന്റെ വർഷങ്ങളുടെ അനുഭവവും പ്രതിബദ്ധതയും നിങ്ങളുടെ കൂടെയുണ്ട്.</p>
        <div class="intro-badges">
          <div class="intro-badge">
            <strong>MNRE</strong>
            <span>അംഗീകൃത ചാനൽ പാർട്ണർ</span>
          </div>
          <div class="intro-badge">
            <strong>ഇന്ത്യാ സർക്കാർ</strong>
            <span>സർട്ടിഫൈഡ്</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== OUR MISSION ===== -->
  <section class="mission-section">
    <div class="container mission-section__inner">
      <div class="mission-section__content">
        <span class="section-tag">ഞങ്ങളുടെ ദൗത്യം</span>
        <h2 class="section-title">വിശ്വസനീയം. താങ്ങാനാവുന്നത്. ഇനി ആർക്കും അകലെയല്ല.</h2>
        <p>ഞങ്ങളുടെ ലക്ഷ്യം വലുതാണ് — സോളാർ ഊർജ്ജം കേരളത്തിലെ ഓരോ ഉപഭോക്താവിനും എത്തിക്കുക; വിശ്വസനീയമായി, താങ്ങാനാവുന്ന വിലയിൽ, ഒരു വിട്ടുവീഴ്ചയുമില്ലാതെ.</p>
        <p>ഓരോ ഇൻസ്റ്റാളേഷനും ഒരു വാഗ്ദാനമാണ് — മികച്ച ഗുണനിലവാരം, സമ്പൂർണ്ണ സുതാര്യത, ഇൻസ്റ്റാളേഷന് ശേഷവും നിലനിൽക്കുന്ന പിന്തുണ. നിങ്ങൾ തൃപ്തരാകുമ്പോൾ മാത്രമാണ് ഞങ്ങളുടെ ജോലി പൂർത്തിയാകുന്നത്.</p>
      </div>
      <div class="mission-pillars">
        {[
          { icon: '⚡', title: 'ഗുണനിലവാരം മുൻഗണന', text: 'റയെന്ന ഇൻസ്റ്റാളേഷനിൽ മികച്ച ഘടകങ്ങൾ മാത്രം — ഒരു വിട്ടുവീഴ്ചയുമില്ലാതെ.' },
          { icon: '🌿', title: 'സുസ്ഥിരത', text: 'ഞങ്ങൾ സ്ഥാപിക്കുന്ന ഓരോ സിസ്റ്റവും ഭൂമിയുടെ ഭാരം കുറയ്ക്കുന്നു.' },
          { icon: '🔍', title: 'സുതാര്യത', text: 'ഓരോ ഘട്ടത്തിലും തുറന്ന സംവാദം — ഒളിച്ചുവെക്കലില്ല, ആശ്ചര്യങ്ങളില്ല.' },
          { icon: '🤝', title: 'ഉപഭോക്താവ് മുൻഗണന', text: 'നിങ്ങൾ തൃപ്തരാകുമ്പോൾ മാത്രമാണ് ഞങ്ങളുടെ ജോലി പൂർത്തിയാകുന്നത്.' },
        ].map(p => (
          <div class="mission-pillar">
            <div class="mission-pillar__icon">{p.icon}</div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LEADERSHIP ===== -->
  <section class="leadership-section">
    <div class="container">
      <div class="leadership-header">
        <span class="section-tag">ഞങ്ങളുടെ സ്ഥാപകർ</span>
        <h2 class="section-title">നേതൃത്വത്തിന്റെ വിദഗ്ധത</h2>
        <p class="leadership-intro">നേതൃത്വമാണ് റയെന്നയുടെ ഏറ്റവും വലിയ സമ്പത്ത്. സമുദ്രയാത്ര, ഊർജ്ജം, എന്റർപ്രൈസ് എന്നിവയിൽ ദശകങ്ങളുടെ സംയുക്ത അനുഭവം — സഹ-സ്ഥാപകരും ഓരോ തീരുമാനത്തിലും അതുല്യമായ ആഴം നൽകുന്നു. പശ്ചാത്തലത്തിൽ പൂരകം, ലക്ഷ്യത്തിൽ ഐക്യം — റയെന്ന നിർമ്മിച്ച അടിത്തറ അവർ തന്നെ.</p>
      </div>

      <div class="leaders-grid">
        <div class="leader-card">
          <div class="leader-card__photo">
            <img src={`${base}/media/ganesh-venkitachalam.jpg`} alt="Ganesh Venkitachalam" />
          </div>
          <div class="leader-card__body">
            <div class="leader-card__identity">
              <h3 class="leader-card__name">Ganesh Venkitachalam</h3>
              <span class="leader-role">മാനേജിംഗ് ഡയറക്ടർ &amp; സഹ-സ്ഥാപകൻ</span>
            </div>
            <p class="leader-card__bio">ഗണേഷ് തന്റെ കരിയർ Thermax-ൽ പ്രോജക്റ്റ് എഞ്ചിനീയറായി ആരംഭിച്ചു — HVAC സിസ്റ്റങ്ങളിൽ വിദഗ്ധൻ. പിന്നീട് മർച്ചന്റ് നേവിയിലേക്ക്. 23 വർഷത്തെ കപ്പൽയാത്രാ അനുഭവത്തിൽ മാസ്റ്ററായി അമൂല്യമായ നേതൃത്വ കഴിവുകൾ വികസിപ്പിച്ചു; ബെസ്റ്റ് മാസ്റ്റർ ബഹുമതികൾ — മികവിനോടുള്ള അചലമായ പ്രതിബദ്ധതയുടെ തെളിവ്.</p>
          </div>
        </div>

        <div class="leader-card">
          <div class="leader-card__photo">
            <img src={`${base}/media/arun-balakrishnan.jpg`} alt="Capt. Arun Balakrishnan" />
          </div>
          <div class="leader-card__body">
            <div class="leader-card__identity">
              <h3 class="leader-card__name">Capt. Arun Balakrishnan</h3>
              <span class="leader-role">ഡയറക്ടർ &amp; സഹ-സ്ഥാപകൻ</span>
            </div>
            <p class="leader-card__bio">ഇന്ത്യാ സർക്കാർ സർട്ടിഫൈഡ് മാസ്റ്റർ മറൈനർ — ആഗോള കടലുകളിൽ ബൾക്ക് കാരിയറുകളിൽ 100+ മാസം കമാൻഡ്. അരുണ്‍ അപൂർവ്വമായ പ്രവർത്തന കൃത്യതയും സമുദ്രയാത്രാ വിദഗ്ധതയും നൽകുന്നു. ആഗോള ഷിപ്പിംഗ് അറിവ് കമ്പനിയുടെ ലോജിസ്റ്റിക്സ് തന്ത്രത്തിന് അമൂല്യമായ നാവിഗേറ്ററാക്കുന്നു.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== THE SKILLED HANDS ===== -->
  <section class="skilled-section">
    <div class="container skilled-section__inner">
      <div class="skilled-section__content">
        <span class="section-tag">ഞങ്ങളുടെ ടീം</span>
        <h2 class="section-title">ഓരോ ഇൻസ്റ്റാളേഷന്റെയും പിന്നിലെ വിദഗ്ധ കൈകൾ</h2>
        <p>എഞ്ചിനീയർമാർ, ടെക്നീഷ്യൻമാർ, കസ്റ്റമർ സർവീസ് പ്രതിനിധികൾ എന്നിവരുടെ പ്രതിജ്ഞാബദ്ധമായ ടീമാണ് റയെന്ന എനർജിയെ ശക്തമാക്കുന്നത് — മുൻനിരയിലേക്ക് നയിക്കാൻ അവർ അവശ്യമാണ്. സാങ്കേതിക മേഖലകളിലും പ്രോജക്റ്റ് മാനേജ്മെന്റിലും ഉയർന്ന കഴിവുള്ള വിദഗ്ധർ ഊർജ്ജ ഉത്പാദനത്തിനുള്ള വ്യവസായ മാനദണ്ഡങ്ങൾ പാലിക്കുന്ന സിസ്റ്റങ്ങളുടെ ഡിസൈനും നടപ്പാക്കലും ഉറപ്പാക്കുന്നു.</p>
        <p>തുടർച്ചയായ പഠനത്തിലും പരിശീലനത്തിലും ടീമിന്റെ പ്രതിബദ്ധത വ്യവസായ വികാസങ്ങളിൽ മുന്നോട്ട് നിൽക്കാൻ സഹായിക്കുന്നു — സോളാർ പരിഹാരങ്ങളിലെ നേതാവായി റയെന്നയുടെ നില നിലനിർത്തുന്നു.</p>
      </div>
      <div class="skilled-section__image">
        <img src={`${base}/media/Drilling-solar.webp`} alt="റയെന്ന എഞ്ചിനീയർമാർ സോളാർ പാനലുകൾ ഇൻസ്റ്റാൾ ചെയ്യുന്നു" />
      </div>
    </div>
  </section>

  <!-- ===== OUR PROMISE ===== -->
  <section class="promise-section">
    <div class="container promise-section__inner">
      <div class="promise-section__image">
        <img src={`${base}/media/Plan-solar.webp`} alt="റയെന്ന സോളാർ ആസൂത്രണം" />
      </div>
      <div class="promise-section__content">
        <span class="section-tag">ഞങ്ങളുടെ വാഗ്ദാനം</span>
        <h2 class="section-title">നിങ്ങൾക്കുള്ള ഞങ്ങളുടെ വാഗ്ദാനം</h2>
        <p>ഒരു വാഗ്ദാനം വെറും വാക്കല്ല — അത് പാലിക്കപ്പെടുമ്പോഴാണ് അർഥമുള്ളത്. റയെന്നയിൽ ആ വാഗ്ദാനം മൂന്ന് കാര്യങ്ങളാണ് — മികച്ച ഗുണനിലവാരം, പൂർണ്ണ സുതാര്യത, പരിസ്ഥിതിയോടുള്ള ഉത്തരവാദിത്തം.</p>
        <p>നിങ്ങൾ സോളാറിലേക്ക് മാറുമ്പോൾ, ഒരു ഉൽപ്പന്നം മാത്രമല്ല വാങ്ങുന്നത് — ഒരു ടീമിന്റെ പ്രതിബദ്ധതകൂടി. ഇൻസ്റ്റാളേഷൻ കഴിഞ്ഞാലും ഞങ്ങൾ നിങ്ങളോടൊപ്പമുണ്ട്. കാരണം, നിങ്ങളുടെ സംതൃപ്തിയാണ് ഞങ്ങളുടെ ഏറ്റവും വലിയ അംഗീകാരം.</p>
        <div class="promise-cta">
          <a href={`${mlPrefix}/contact/`} class="btn btn-primary">കോൺടാക്റ്റ്</a>
          <a href={`${mlPrefix}/services/`} class="btn btn-outline">ഞങ്ങളുടെ സേവനങ്ങൾ</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ===========================
   About Page — Mobile First
   =========================== */

/* ===== PAGE HERO ===== */
.page-hero {
  position: relative;
  min-height: 420px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding-bottom: 56px;
}
.page-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  z-index: 0;
}
.page-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(10, 25, 50, 0.88) 0%,
    rgba(10, 25, 50, 0.55) 50%,
    rgba(10, 25, 50, 0.25) 100%
  );
  z-index: 1;
}
.page-hero__inner {
  position: relative;
  z-index: 2;
  padding-top: 88px;
}
.page-hero__eyebrow {
  font-family: var(--font-heading);
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.65);
  margin-bottom: 10px;
}
.page-hero__title {
  font-family: var(--font-heading);
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  font-weight: 500;
  color: #ffffff;
  line-height: 1.15;
  margin-bottom: 14px;
}
.page-hero__sub {
  font-size: clamp(0.95rem, 2vw, 1.1rem);
  color: rgba(255,255,255,0.72);
  max-width: 480px;
  line-height: 1.7;
}

/* ===== WHO WE ARE ===== */
.intro-section {
  padding: var(--section-padding);
  background: #ffffff;
}
.intro-section__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
  align-items: center;
}
.intro-section__image {
  position: relative;
