---
import Layout from '../../layouts/Layout.astro';
import { OG } from '../../i18n/og-images';
import { useTranslations } from '../../i18n/ui';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = useTranslations('ml');
const pc = t.pageConvert.city;
const mlPrefix = '/ml';
---
<Layout lang="ml"
  title="കൊച്ചിയിൽ സോളാർ പാനൽ ഇൻസ്റ്റാളേഷൻ | റയെന്ന എനർജി"
  description="കൊച്ചിയിലെ MNRE അംഗീകൃത റയെന്ന എനർജി. PM സൂര്യ ഘർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ സൈറ്റ് സർവേ. വിളിക്കുക: +91 7907 369 304."
  ogImage={OG.kochi}
>

  <section class="area-hero">
    <img src={`${base}/media/hero (1).webp`} alt="കൊച്ചിയിലെ മേൽക്കൂരയിലെ സോളാർ പാനലുകൾ" class="area-hero__bg" />
    <div class="area-hero__overlay"></div>
    <div class="container area-hero__inner">
      <p class="area-hero__eyebrow">കൊച്ചി & എറണാകുളം</p>
      <h1 class="area-hero__title">കൊച്ചിയിൽ<br />സോളാർ ഇൻസ്റ്റാളേഷൻ</h1>
      <p class="area-hero__sub">വ്യറ്റിലയിലെ MNRE അംഗീകൃത ഇൻസ്റ്റാളർ. സർക്കാർ സബ്സിഡി ₹78,000 വരെ. സൗജന്യ സൈറ്റ് സർവേ. 25 വർഷ പാനൽ വാറന്റി.</p>
      <div class="area-hero__ctas">
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-primary">☀️ സമ്പാദ്യം കണക്കാക്കുക</a>
        <a href={`${mlPrefix}/contact/`} class="btn btn-outline-light">സൗജന്യ ക്വോട്ട് →</a>
      </div>
      <p class="area-hero__micro">{pc.heroMicro}</p>
      <p class="area-hero__phone">{pc.heroPhone} <a href="tel:+917907369304" data-analytics-location="city_hero">+91 7907 369 304</a></p>
    </div>
  </section>

  <!-- ===== WHY KOCHI ===== -->
  <section class="area-why">
    <div class="container area-why__inner">
      <div class="area-why__content">
        <span class="section-tag">കൊച്ചിയുടെ സോളാർ ഗുണം</span>
        <h2 class="section-title">കൊച്ചി — സോളാറിന് ഏറ്റവും അനുയോജ്യമായ നഗരം</h2>
        <p>കൊച്ചിക്ക് വർഷത്തിൽ 2,000-ലധികം പീക്ക് സൺ അവറുകൾ ലഭിക്കുന്നു — മേൽക്കൂര സോളാർ സിസ്റ്റത്തെ വീട്ടുടമയുടെ ഏറ്റവും വിശ്വസനീയമായ നിക്ഷേപങ്ങളിലൊന്നാക്കാൻ ഇത് മതി. മോൺസൂൺ സീസൺ ഉണ്ടെങ്കിലും കൊച്ചിയുടെ വാർഷിക സോളാർ ഉത്പാദനം ശക്തമായി തുടരുന്നു. KSEB-യുടെ നെറ്റ് മീറ്ററിംഗ് നയം കാരണം നിങ്ങൾ ഉത്പാദിപ്പിച്ച് ഉപയോഗിക്കാത്ത യൂണിറ്റുകൾ ബില്ലിൽ ക്രെഡിറ്റ് ആകും.</p>
        <p>കൊച്ചി ആസ്ഥാനമായ കമ്പനി എന്ന നിലയിൽ പ്രാദേശിക കെട്ടിട തരങ്ങൾ റയെന്നയ്ക്ക് നന്നായി അറിയാം — കാക്കനാട്, എടപ്പള്ളിയിലെ അപ്പാർട്ട്മെന്റുകൾ മുതൽ തേവര, വൈറ്റിലയിലെ സ്വതന്ത്ര വില്ലകൾ വരെ. ജില്ലയിൽ ഞങ്ങൾ പൂർത്തിയാക്കുന്ന ഓരോ ഇൻസ്റ്റാളേഷനിലും KSEB നെറ്റ് മീറ്റർ അപേക്ഷ, ഘടനാപരമായ പരിശോധന, സബ്സിഡി പേപ്പർവർക്ക് — എല്ലാം ഞങ്ങൾ കൈകാര്യം ചെയ്യുന്നു.</p>
        <ul class="area-facts">
          <li><span class="fact-icon">🌞</span><span><strong>വർഷത്തിൽ 2,000+ പീക്ക് സൺ അവറുകൾ</strong> — എറണാകുളം ജില്ലയിൽ</span></li>
          <li><span class="fact-icon">🏠</span><span><strong>15+ കൊച്ചി പ്രദേശങ്ങളിൽ ഇൻസ്റ്റാളേഷനുകൾ</strong> — എടപ്പള്ളി, തേവര, വൈറ്റില, കാക്കനാട്, ഫോർട്ട് കൊച്ചി, പള്ളുരുത്തി, രവിപുരം മുതലായവ</span></li>
          <li><span class="fact-icon">⚡</span><span><strong>KSEB നെറ്റ് മീറ്ററിംഗ്</strong> — അധിക യൂണിറ്റുകൾ കയറ്റി ബിൽ ഏതാണ്ട് പൂജ്യമാക്കാം</span></li>
          <li><span class="fact-icon">🏢</span><span><strong>കൊച്ചി നഗര കേന്ദ്രത്തിൽ നിന്ന് വെറും 5 km അകലെ ഓഫീസ്</strong> — എറണാകുളത്ത് സൈറ്റ് പരിശോധനയ്ക്ക് ഏറ്റവും വേഗത്തിലുള്ള പ്രതികരണം</span></li>
        </ul>
      </div>
      <div class="area-why__image">
        <img src={`${base}/media/solar-panel-installation.jpg`} alt="കൊച്ചിയിൽ റയെന്ന എനർജിയുടെ മേൽക്കൂര സോളാർ ഇൻസ്റ്റാളേഷൻ" />
      </div>
    </div>
  </section>

  <!-- ===== SUBSIDY ===== -->
  <section class="area-subsidy">
    <div class="container">
      <div class="area-subsidy__inner">
        <div class="subsidy-icon">🏛️</div>
        <div class="subsidy-content">
          <h2>കൊച്ചിയിൽ PM സൂര്യ ഘർ സബ്സിഡി ലഭ്യം</h2>
          <p>കൊച്ചി വീട്ടുടമകൾക്ക് കേന്ദ്ര സർക്കാരിന്റെ PM സൂര്യ ഘർ മുഫ്ത് ബിജ്ലി യോജനയിൽ അർഹതയുണ്ട് — 3 kW വരെയുള്ള സിസ്റ്റങ്ങൾക്ക് <strong>₹78,000</strong> വരെ നേരിട്ടുള്ള സബ്സിഡി, വലിയ സിസ്റ്റങ്ങൾക്ക് അനുപാതിക പിന്തുണ. ഓരോ ഇൻസ്റ്റാളേഷന്റെ ഭാഗമായി KSEB DISCom അംഗീകാരവും പോർട്ടൽ സമർപ്പണവും ഉൾപ്പെടെ മുഴുവൻ അപേക്ഷാ പ്രക്രിയയും റയെന്ന കൈകാര്യം ചെയ്യുന്നു.</p>
          <div class="subsidy-table">
            <div class="subsidy-row"><span>1–2 kW സിസ്റ്റം</span><strong>₹30,000 – ₹60,000 സബ്സിഡി</strong></div>
            <div class="subsidy-row"><span>3 kW സിസ്റ്റം</span><strong>₹78,000 സബ്സിഡി</strong></div>
            <div class="subsidy-row"><span>3–10 kW സിസ്റ്റം</span><strong>₹78,000 + അധിക ചെലവിന്റെ 20%</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LOCAL INSTALLATIONS ===== -->
  <section class="area-installs">
    <div class="container">
      <h2 class="section-title text-center">സമീപകാല കൊച്ചി & എറണാകുളം ഇൻസ്റ്റാളേഷനുകൾ</h2>
      <div class="area-installs-grid">
        {[
          { name: 'Byju George',   location: 'Thevara',    cap: '10 kW', img: 'BYJU-GEORGE10KWTHEVARA-SOLIS-INVERTER-PANELS-WAAREE-1.jpeg' },
          { name: 'Angelo Thomas', location: 'Edapally',   cap: '10 kW', img: 'ANGELO-THOMAS-EDAPALLY-10KW-SOLIS-INVERTER-PANELS-WAAREE.png' },
          { name: 'Aysha George',  location: 'Ravipuram',  cap: '3 kW',  img: 'AYSHA-GEORGE-RAVIPURAM-3KW-SOLIS-INVERTER-PANELS-ADANI.png' },
          { name: 'Joseph K.V.',   location: 'Vennala',    cap: '5 kW',  img: 'JOSEPH-KV-VENNALA-5KW-SOLIS-INVERTER-PANELS-ADANI.png' },
        ].map(item => (
          <div class="area-install-card">
            <img src={`${base}/media/references/${item.img}`} alt={`${item.name}, ${item.location}, കൊച്ചി — ${item.cap} സോളാർ ഇൻസ്റ്റാളേഷൻ`} loading="lazy" />
            <div class="area-install-label">
              <strong>{item.name}</strong>
              <span>{item.location} · {item.cap}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="installs-cta-text"><a href={`${mlPrefix}/media/`}>എല്ലാ ഇൻസ്റ്റാളേഷനുകളും കാണുക →</a></p>
    </div>
  </section>

  <!-- ===== LOCAL FAQ ===== -->
  <section class="area-faq">
    <div class="container area-faq__inner">
      <h2 class="section-title">കൊച്ചി വീട്ടുടമകൾ ചോദിക്കുന്നത്</h2>
      <div class="area-faq__list">
        {[
          {
            q: 'കേരളത്തിലെ മോൺസൂണിൽ കനത്ത മഴ സോളാർ ഉത്പാദനത്തെ കുറയ്ക്കുമോ?',
            a: 'അതെ, കനത്ത മേഘാവൃതിയുള്ള ദിവസങ്ങളിൽ ഉത്പാദനം കുറയും — പീക്ക് മോൺസൂൺ മാസങ്ങളിൽ (ജൂൺ–ഓഗസ്റ്റ്) സാധാരണയായി 20–40%. എന്നിരുന്നാലും 8–9 മാസം ശക്തമായ സൂര്യപ്രകാശം ഉള്ളതിനാൽ വാർഷിക ഉത്പാദനം ഉയർന്നതായി തുടരും. സീസണൽ വ്യത്യാസം കണക്കിലെടുത്ത് സിസ്റ്റങ്ങൾ ശരിയായി സൈസ് ചെയ്യുന്നതിനാൽ പേയ്ബാക്ക് കണക്കുകളിൽ മോൺസൂൺ മാസങ്ങളും ഉൾപ്പെടുന്നു.',
          },
          {
            q: 'കൊച്ചിയിലെ അപ്പാർട്ട്മെന്റ് മേൽക്കൂരയിൽ സോളാർ ഇൻസ്റ്റാൾ ചെയ്യാമോ?',
            a: 'അതെ, നിങ്ങൾക്ക് പ്രത്യേക മേൽക്കൂര പ്രദേശം (സാധാരണയായി kW-ന് 50–100 sq ft) ലഭിക്കുകയും ഹൗസിംഗ് സൊസൈറ്റി അനുവദിക്കുകയും ചെയ്താൽ. കാക്കനാട്, എടപ്പള്ള, ഫോർട്ട് കൊച്ചി എന്നിവിടങ്ങളിൽ റയെന്ന അപ്പാർട്ട്മെന്റ് മേൽക്കൂര ഇൻസ്റ്റാളേഷനുകൾ പൂർത്തിയാക്കിയിട്ടുണ്ട്. സൗജന്യ സൈറ്റ് സർവേയിൽ സാധ്യത വിലയിരുത്താം.',
          },
          {
            q: 'എറണാകുളത്ത് KSEB നെറ്റ് മീറ്ററിംഗ് അംഗീകാരത്തിന് എത്ര സമയം?',
            a: 'സാങ്കേതിക പരിശോധനയ്ക്ക് ശേഷം KSEB സാധാരണയായി 30–60 ദിവസത്തിനുള്ളിൽ നെറ്റ് മീറ്ററിംഗ് അപേക്ഷകൾ പ്രോസസ്സ് ചെയ്യുന്നു. റയെന്ന നിങ്ങളുടെ പേരിൽ എല്ലാ പേപ്പർവർക്കും സമർപ്പിക്കുകയും പ്രാദേശിക KSEB ഓഫീസുമായി ഫോളോ അപ്പ് ചെയ്യുകയും ചെയ്യുന്നു — സർക്കാർ ഓഫീസിൽ പോകേണ്ടതില്ല.',
          },
          {
            q: 'കൊച്ചി തീരത്തിനടുത്തുള്ള സോളാർ പാനലുകൾക്ക് കടൽ കാറ്റ് (ഉപ്പ് മൂടകം) പ്രശ്നമാകുമോ?',
            a: 'ഉപ്പ് നിറഞ്ഞ വായു വിലയില്ലാത്ത മൗണ്ടിംഗ് സ്ട്രക്ചറുകളുടെ അരിക്കൽ വേഗത്തിലാക്കാം. തീരദേശ ഇൻസ്റ്റാളേഷനുകൾക്ക് റയെന്ന മറൈൻ-ഗ്രേഡ് അനോഡൈസ്ഡ് അലുമിനിയം റെയിലുകളും സ്റ്റെയിൻലെസ് സ്റ്റീൽ ഫാസ്റ്റനറുകളും ഉപയോഗിക്കുന്നു — ഫോർട്ട് കൊച്ചി, പള്ളുരുത്തി, ചേരായി എന്നിവിടങ്ങളിലെ എല്ലാ ഇൻസ്റ്റാളേഷനുകളിലും സ്റ്റാൻഡേർഡ് ആചരണം.',
          },
        ].map(item => (
          <details class="area-faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <p class="area-faq__more">കൂടുതൽ ചോദ്യങ്ങളുണ്ടോ? <a href={`${mlPrefix}/faqs/`}>മുഴുവൻ FAQ നോക്കുക →</a></p>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="area-cta">
    <div class="container area-cta__inner">
      <div>
        <h2>കൊച്ചിയിൽ സോളാറിലേക്ക് തയ്യാറാണോ?</h2>
        <p>ഞങ്ങളുടെ കൊച്ചി ടീമിൽ നിന്ന് ബാധ്യതയില്ലാത്ത സൈറ്റ് സർവേ നേടുക. മേൽക്കൂര വിലയിരുത്തുക, സാധ്യമായ സമ്പാദ്യം കണക്കാക്കുക, സബ്സിഡി പ്രക്രിയ വിശദീകരിക്കുക — എല്ലാം സൗജന്യം.</p>
      </div>
      <div class="area-cta__btns">
        <a href={`${mlPrefix}/contact/`} class="btn btn-primary">{pc.ctaContact}</a>
        <a href={`${mlPrefix}/solar-calculator/`} class="btn btn-outline">{pc.ctaCalc}</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ===== AREA HERO ===== */
.area-hero {
  position: relative;
  min-height: 500px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding-bottom: 64px;
}
.area-hero__bg {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: center 25%; z-index: 0;
}
