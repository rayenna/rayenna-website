---
import Layout from '../layouts/Layout.astro';
import { OG } from '../i18n/og-images';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const waText = encodeURIComponent(
  'Hi Rayenna, our apartment association would like a solar feasibility study.'
);
const waHref = `https://wa.me/917907369304?text=${waText}`;

const faqs = [
  {
    q: 'Who can apply for a society or common-area solar plant?',
    a: 'A registered apartment association, housing society, residents’ welfare association (RWA), or builders’ managed community can explore a common-area plant under PM Surya Ghar Group Housing Society / RWA rules. Individual flat owners with dedicated roof or terrace access may still apply under the normal residential pathway where the society permits it.',
  },
  {
    q: 'Do all residents need to agree?',
    a: 'This depends on your society’s bye-laws and builder agreement. Most societies need a general body resolution and any NOC the bye-laws require. We review these during the feasibility study.',
  },
  {
    q: 'Who owns the roof?',
    a: 'This depends on your society’s bye-laws and builder agreement. We review these during the feasibility study.',
  },
  {
    q: 'What are the three routes for a building to go solar?',
    a: 'A) Individual flat or terrace plants where an owner has dedicated roof access and the society permits it. B) A common-area plant for lifts, pumps, corridor and basement lighting, and EV charging — net metering up to 500 kW for common service connections under KSERC 2025. C) Shared (virtual) net metering across flat meters: minimum 10 kW, energy storage of at least 20% of generation potential for multi-storied residential / residents’ association plants, plus a Lead person, society resolution, credit-sharing agreement and KSEB approval. Ground implementation of VNM is still maturing in Kerala.',
  },
  {
    q: 'How is the society subsidy calculated?',
    a: 'For Group Housing Society / RWA common facilities (including EV charging), PM Surya Ghar CFA is ₹18,000 per kW up to 500 kW capacity, at 3 kW per house, with the upper limit inclusive of individual rooftop plants installed by residents. Final eligibility is confirmed on the national portal (pmsuryaghar.gov.in).',
  },
  {
    q: 'Will solar run the lifts at night?',
    a: 'Panels generate in daylight. Night loads use grid power unless you add storage. Daytime common loads — lifts, pumps and lighting that run while the sun is up — often align well with solar generation. We do not claim typical percentage savings; your bills decide the case.',
  },
  {
    q: 'Can EV charging be included?',
    a: 'Yes. Common-facility plants under the GHS/RWA pathway can include EV charging. We size against your common-area load and roof space in the feasibility study.',
  },
  {
    q: 'Who maintains the plant?',
    a: 'This depends on your society’s bye-laws, the installation agreement and any service plan you choose. We review maintenance expectations during the feasibility study.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Solar feasibility study for apartments and housing societies in Kerala',
  description:
    'Free feasibility study for apartment associations and housing societies in Kerala — roof, shade, structure, common-area bills, subsidy ceiling and metering route.',
  provider: {
    '@type': 'Organization',
    name: 'Rayenna Energy',
    url: 'https://rayennaenergy.com',
  },
  areaServed: { '@type': 'State', name: 'Kerala' },
  serviceType: 'Solar energy consultation',
  url: 'https://rayennaenergy.com/apartments-housing-societies/',
};

// TODO_OWNER: custom Open Graph image for apartments page; reusing services OG for now.
const ogImage = OG.services;
---

<Layout
  title="Solar for Apartments & Societies | Kerala"
  description="Cut common-area electricity bills. Free solar feasibility study for apartment associations and housing societies in Kerala — no commitment."
  ogImage={ogImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- 1. HERO -->
  <section class="apt-hero">
    <img src={`${base}/media/services-hero-opt3.jpg`} alt="Solar panels on a rooftop at sunset" class="apt-hero__bg" />
    <div class="apt-hero__overlay"></div>
    <div class="container apt-hero__inner">
      <p class="apt-hero__eyebrow">For committees in Kerala</p>
      <h1 class="apt-hero__title">Solar for Apartments &amp; Housing Societies in Kerala</h1>
      <p class="apt-hero__sub">
        Cut your common-area electricity bill. We start with a free feasibility study, with no commitment.
      </p>
      <div class="apt-hero__ctas">
        <a href="#enquiry" class="btn btn-primary">Request a free society feasibility study</a>
        <a href={waHref} class="btn btn-outline-light" target="_blank" rel="noopener noreferrer" data-analytics-location="apartments-hero-wa">
          WhatsApp us
        </a>
      </div>
      <p class="apt-hero__micro">PM Surya Ghar empanelled · Process first · No invented project counts</p>
      <img src={`${base}/media/Artboard-2mnre.webp`} alt="PM Surya Ghar empanelled vendor (MNRE)" class="apt-hero__badge" width="160" height="56" />
    </div>
  </section>

  <!-- 2. WHO THIS IS FOR -->
  <section class="apt-section">
    <div class="container apt-split">
      <div class="apt-split__media">
        <img src={`${base}/media/Plan-solar.webp`} alt="Rooftop solar planning for a multi-unit building in Kerala" loading="lazy" />
      </div>
      <div class="apt-split__copy">
        <h2 class="section-title">Who this is for</h2>
        <p>
          Apartment associations, gated communities, residents’ welfare associations and builders’ managed communities in Kerala.
          If you sit on the committee — president, secretary, treasurer or member — and you want a clear picture before any vote, start here.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. THREE WAYS -->
  <section class="apt-section apt-section--alt apt-section--routes">
    <div class="container">
      <h2 class="section-title">Three ways a building can go solar</h2>
      <p class="apt-lead">Pick the route that matches roof rights, meters and your bye-laws. We recommend one after the study.</p>

      <div class="apt-diagram" role="img" aria-label="Diagram of three solar routes: individual flat plant, common-area plant, and shared virtual net metering">
        <svg viewBox="0 0 720 200" xmlns="http://www.w3.org/2000/svg" width="720" height="200" class="apt-diagram__svg" aria-hidden="true">
          <rect x="8" y="20" width="220" height="160" rx="8" fill="#f5f5f5" stroke="#a83838" stroke-width="2"/>
          <text x="118" y="48" text-anchor="middle" font-size="14" font-family="system-ui,sans-serif" fill="#27324f" font-weight="600">A · Individual</text>
          <text x="118" y="72" text-anchor="middle" font-size="12" font-family="system-ui,sans-serif" fill="#616161">Flat / terrace plant</text>
          <rect x="48" y="90" width="40" height="28" fill="#a83838"/>
          <rect x="98" y="90" width="40" height="28" fill="#788bba"/>
          <rect x="148" y="90" width="40" height="28" fill="#f9efef"/>
          <text x="118" y="150" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif" fill="#616161">One owner · one meter</text>

          <rect x="250" y="20" width="220" height="160" rx="8" fill="#f5f5f5" stroke="#a83838" stroke-width="2"/>
          <text x="360" y="48" text-anchor="middle" font-size="14" font-family="system-ui,sans-serif" fill="#27324f" font-weight="600">B · Common area</text>
          <text x="360" y="72" text-anchor="middle" font-size="12" font-family="system-ui,sans-serif" fill="#616161">Society plant</text>
          <rect x="300" y="90" width="120" height="28" fill="#a83838"/>
          <text x="360" y="150" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif" fill="#616161">Lifts · pumps · lighting · EV</text>

          <rect x="492" y="20" width="220" height="160" rx="8" fill="#f5f5f5" stroke="#a83838" stroke-width="2"/>
          <text x="602" y="48" text-anchor="middle" font-size="14" font-family="system-ui,sans-serif" fill="#27324f" font-weight="600">C · Shared (VNM)</text>
          <text x="602" y="72" text-anchor="middle" font-size="12" font-family="system-ui,sans-serif" fill="#616161">One plant · many meters</text>
          <rect x="542" y="90" width="120" height="28" fill="#788bba"/>
          <line x1="562" y1="118" x2="542" y2="145" stroke="#27324f" stroke-width="1.5"/>
          <line x1="602" y1="118" x2="602" y2="145" stroke="#27324f" stroke-width="1.5"/>
          <line x1="642" y1="118" x2="662" y2="145" stroke="#27324f" stroke-width="1.5"/>
          <text x="602" y="165" text-anchor="middle" font-size="11" font-family="system-ui,sans-serif" fill="#616161">Credits split by agreement</text>
        </svg>
        <p class="apt-diagram__caption">Three metering routes for apartment buildings — simplified.</p>
      </div>

      <div class="apt-cards">
        <article class="apt-card">
          <div class="apt-card__media">
            <img src={`${base}/media/apartments/apt-route-a-terrace.jpg`} alt="Individual flat balcony solar panels on a residential building" loading="lazy" />
          </div>
          <div class="apt-card__body">
            <h3>A. Individual flat or terrace plants</h3>
            <p>Only where an owner has dedicated roof or terrace access and the society permits it. Follows the normal PM Surya Ghar residential rules.</p>
          </div>
        </article>
        <article class="apt-card">
          <div class="apt-card__media">
            <img src={`${base}/media/apartments/apt-route-b-common.jpg`} alt="Large common-area solar plant covering a building rooftop" loading="lazy" />
          </div>
          <div class="apt-card__body">
            <h3>B. Common-area plant</h3>
            <p>One plant for lifts, water pumps, corridor and basement lighting, and EV charging. Society-level subsidy and approvals apply (see below).</p>
          </div>
        </article>
        <article class="apt-card">
          <div class="apt-card__media">
            <img src={`${base}/media/apartments/apt-route-c-shared.jpg`} alt="Multi-storey apartment building with rooftop solar for shared metering" loading="lazy" />
          </div>
          <div class="apt-card__body">
            <h3>C. Shared (virtual) net metering</h3>
            <p>
              One plant, credits shared among participating flats under an agreement.
              Under KSERC’s 2025 regulations, VNM for multi-storied residential buildings and residents’ associations
              needs energy storage of at least 20% of the plant’s generation potential, a Lead person, a society resolution,
              a credit-sharing agreement and KSEB approval. Minimum plant size is 10 kW.
              Implementation on the ground is still maturing in Kerala — we confirm the fit for your building in the study.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. WHY COMMON-AREA -->
  <section class="apt-section">
    <div class="container apt-split apt-split--flip">
      <div class="apt-split__copy">
        <h2 class="section-title">Why common-area loads suit solar</h2>
        <p>
          Lifts, pumps and lighting often run in daytime hours, when panels generate.
          That daytime overlap is why common-area loads are a natural fit for rooftop solar.
          We do not claim typical percentage savings — your last twelve months of bills decide the case.
        </p>
      </div>
      <div class="apt-split__media">
        <img src={`${base}/media/Drilling-solar.jpg`} alt="Solar panel mounting work on a Kerala rooftop" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 4b. REAL ROOFS STRIP -->
  <section class="apt-section apt-section--gallery" aria-labelledby="apt-gallery-title">
    <div class="container">
      <h2 id="apt-gallery-title" class="section-title">Real Rayenna rooftops across Kerala</h2>
      <p class="apt-lead">Home installs we have completed — the same quality and process we bring to society feasibility studies.</p>
      <div class="apt-gallery">
        <a class="apt-gallery__item" href={`${base}/media/`}>
          <img src={`${base}/media/references/ARUN-KOLLAM-5KW-SOLIS-INVERTER-PANELS-WAAREE.jpeg`} alt="5 kW solar installation for Arun in Kollam" loading="lazy" />
          <span>Arun · Kollam · 5 kW</span>
        </a>
        <a class="apt-gallery__item" href={`${base}/media/`}>
          <img src={`${base}/media/references/SESSY ANTONY-CHOTTANIKKARA-6KW-DEYE-INVERTER-PANELS-EMMVEE.jpeg`} alt="6 kW solar installation for Sessy Antony in Chottanikkara" loading="lazy" />
          <span>Sessy Antony · Chottanikkara · 6 kW</span>
        </a>
        <a class="apt-gallery__item" href={`${base}/media/`}>
          <img src={`${base}/media/references/SURESH-EROOR-4KW-SUNWAYS-INVERTER-PANELS-WAAREE.jpeg`} alt="4 kW solar installation for Suresh in Eroor" loading="lazy" />
          <span>Suresh · Eroor · 4 kW</span>
        </a>
        <a class="apt-gallery__item" href={`${base}/media/`}>
          <img src={`${base}/media/references/DHANYA V T-THOPPUMPADY-5KW-EASTMAN-INVERTER-PANELS-ADANI.jpeg`} alt="5 kW solar installation for Dhanya V.T. in Thoppumpady" loading="lazy" />
          <span>Dhanya V.T. · Thoppumpady · 5 kW</span>
        </a>
      </div>
      <p class="apt-gallery__cta"><a href={`${base}/media/`}>View all installations →</a></p>
    </div>
  </section>

  <!-- 5. SUBSIDY -->
  <section class="apt-section apt-section--subsidy">
    <div class="apt-band">
      <img src={`${base}/media/apartments/apt-buildings.jpg`} alt="Modern multi-storey apartment buildings" class="apt-band__img" loading="lazy" />
      <div class="apt-band__shade"></div>
      <div class="container apt-band__inner">
        <p class="apt-band__eyebrow">PM Surya Ghar · GHS / RWA</p>
        <h2 class="apt-band__title">The subsidy for societies</h2>
        <div class="apt-stats">
          <div class="apt-stat">
            <span class="apt-stat__value">₹18,000</span>
            <span class="apt-stat__label">CFA per kW for common facilities</span>
          </div>
          <div class="apt-stat">
            <span class="apt-stat__value">500 kW</span>
            <span class="apt-stat__label">Upper capacity (3 kW per house)</span>
          </div>
          <div class="apt-stat">
            <span class="apt-stat__value">1–500 kW</span>
            <span class="apt-stat__label">Common-area net metering (KSERC 2025)</span>
          </div>
        </div>
      </div>
    </div>
    <div class="container apt-subsidy-grid">
      <div class="apt-subsidy-copy">
        <p>
          Under PM Surya Ghar for Group Housing Society / Resident Welfare Association common facilities
          (including EV charging), Central Financial Assistance (CFA) is <strong>₹18,000 per kW</strong>,
          up to <strong>500 kW</strong> capacity (at 3 kW per house), with the upper limit inclusive of
          individual rooftop plants installed by residents. Source: pmsuryaghar.gov.in.
        </p>
        <p>
          For comparison, the individual residential CFA is ₹30,000 per kW up to 2 kW; ₹18,000 per kW for the third kW;
          capped at ₹78,000 above 3 kW.
        </p>
        <p>
          Under the KSERC (Renewable Energy and Related Matters) Regulations, 2025 (in force from 6 November 2025),
          net metering is available for <strong>common-area service connections</strong> of residential high-rise /
          multi-storied buildings and residential colonies from <strong>1 kW to 500 kW</strong>.
          Plants above 25 kW have hybrid-inverter storage requirements under the same regulations — we size and confirm
          this during the feasibility study. Source: Kerala Gazette / KSERC regulations, 2025.
        </p>
      </div>
      <div class="apt-subsidy-aside">
        <div class="apt-subsidy-aside__media">
          <img src={`${base}/media/apartments/apt-ev.jpg`} alt="EV charging at a residential building" loading="lazy" />
        </div>
        <aside class="apt-illustration" aria-label="Worked subsidy illustration">
          <p class="apt-illustration__label">Illustration only</p>
          <p>
            A 60-flat society has an eligible-capacity ceiling of 180 kW (3 kW per flat).
            Actual plant size depends on your common-area load and roof space.
            For example, a 30 kW common-area plant would attract up to ₹5.4 lakh at ₹18,000 per kW
            (30 × 18,000 = 5,40,000). Final eligibility is confirmed on the national portal.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 6. HOW IT WORKS -->
  <section class="apt-section apt-section--process">
    <div class="container">
      <header class="apt-process-head">
        <div>
          <p class="apt-kicker">From first call to commissioning</p>
          <h2 class="section-title">How it works</h2>
          <p class="apt-lead">Timelines depend on approvals and your society’s decision process — we keep every step clear.</p>
        </div>
        <div class="apt-process-head__photos" aria-hidden="true">
          <img src={`${base}/media/Solar-Kochi-workers.jpg`} alt="" loading="lazy" />
          <img src={`${base}/media/apartments/apt-meeting.jpg`} alt="" loading="lazy" />
        </div>
      </header>
      <ol class="apt-process">
        <li class="apt-process__step">
          <span class="apt-process__num" aria-hidden="true">01</span>
          <h3>Free feasibility study</h3>
          <p>Roof, shade, structure, and 12 months of common-area bills — honest sizing before any deposit.</p>
        </li>
        <li class="apt-process__step">
          <span class="apt-process__num" aria-hidden="true">02</span>
          <h3>Committee briefing</h3>
          <p>A clear verbal walkthrough plus a written summary your committee can circulate.</p>
        </li>
        <li class="apt-process__step">
          <span class="apt-process__num" aria-hidden="true">03</span>
          <h3>General body resolution</h3>
          <p>And any NOC your bye-laws require — we flag what to table before the vote.</p>
        </li>
        <li class="apt-process__step">
          <span class="apt-process__num" aria-hidden="true">04</span>
          <h3>Design and proposal</h3>
          <p>Layout and kit sized to your actual load and usable roof — not a generic package.</p>
        </li>
        <li class="apt-process__step">
          <span class="apt-process__num" aria-hidden="true">05</span>
          <h3>Approvals &amp; subsidy</h3>
          <p>KSEB, national portal and PM Surya Ghar filing handled by our team end to end.</p>
        </li>
        <li class="apt-process__step">
          <span class="apt-process__num" aria-hidden="true">06</span>
          <h3>Install &amp; monitor</h3>
          <p>Installation, commissioning and monitoring — after your society decides to proceed.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 7–8. DELIVERABLE + CHECKLIST -->
  <section class="apt-section apt-section--duo">
    <div class="apt-duo-banner">
      <img src={`${base}/media/apartments/apt-solar-roof.jpg`} alt="Rooftop solar array on a building" class="apt-duo-banner__img" loading="lazy" />
      <div class="apt-duo-banner__shade"></div>
      <div class="container apt-duo-banner__inner">
        <h2 class="apt-duo-banner__title">Feasibility study — what you get, what we need</h2>
        <p>One short written note. No obligation. If solar does not make sense for your building, we will tell you.</p>
      </div>
    </div>
    <div class="container apt-duo">
      <article class="apt-panel apt-panel--deliver">
        <div class="apt-panel__media">
          <img src={`${base}/media/apartments/apt-docs.jpg`} alt="Documents and planning materials on a desk" loading="lazy" />
        </div>
        <div class="apt-panel__body">
          <p class="apt-kicker">You receive</p>
          <h3>From the feasibility study</h3>
          <ul class="apt-checklist">
            <li>Usable roof area</li>
            <li>Indicative system size range</li>
            <li>Indicative annual generation</li>
            <li>Subsidy ceiling for your building</li>
            <li>The metering route we recommend</li>
          </ul>
        </div>
      </article>
      <article class="apt-panel apt-panel--need">
        <div class="apt-panel__media">
          <img src={`${base}/media/apartments/apt-meeting.jpg`} alt="Committee meeting around a table" loading="lazy" />
        </div>
        <div class="apt-panel__body">
          <p class="apt-kicker">Please share</p>
          <h3>What we need from you</h3>
          <ul class="apt-checklist apt-checklist--need">
            <li>Last 12 months of common-area electricity bills</li>
            <li>KSEB consumer numbers for common connections</li>
            <li>Roof photos or plan</li>
            <li>Society registration details and bye-laws</li>
            <li>Name and contact of the secretary or president</li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- 9. GLOSSARY -->
  <section class="apt-section apt-section--glossary">
    <div class="container">
      <header class="apt-section-head">
        <p class="apt-kicker">Plain language</p>
        <h2 class="section-title">Glossary</h2>
        <p class="apt-lead">The terms committees ask about most — without the jargon.</p>
      </header>
      <div class="apt-glossary-grid">
        <article class="apt-term">
          <div class="apt-term__media">
            <img src={`${base}/media/apartments/apt-skyline.jpg`} alt="" loading="lazy" />
          </div>
          <h3>Common service connection</h3>
          <p>The electricity meter that powers lifts, pumps and common lighting.</p>
        </article>
        <article class="apt-term">
          <div class="apt-term__media">
            <img src={`${base}/media/apartments/apt-solar-roof.jpg`} alt="" loading="lazy" />
          </div>
          <h3>Net metering</h3>
          <p>Surplus daytime solar is credited against your bill.</p>
        </article>
        <article class="apt-term">
          <div class="apt-term__media">
            <img src={`${base}/media/apartments/apt-buildings.jpg`} alt="" loading="lazy" />
          </div>
          <h3>Virtual net metering</h3>
          <p>One shared plant whose credits are split across several meters.</p>
        </article>
        <article class="apt-term">
          <div class="apt-term__media">
            <img src={`${base}/media/apartments/apt-ev.jpg`} alt="" loading="lazy" />
          </div>
          <h3>CFA</h3>
          <p>The central government subsidy, called Central Financial Assistance.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="apt-section apt-section--faq">
    <div class="container apt-faq-layout">
      <aside class="apt-faq-aside">
        <div class="apt-faq-aside__media">
          <img src={`${base}/media/apartments/apt-skyline.jpg`} alt="City skyline with high-rise buildings" loading="lazy" />
        </div>
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="apt-lead">Straight answers for secretaries, presidents and committee members.</p>
        <a href="#enquiry" class="btn btn-primary">Request a study</a>
      </aside>
      <div class="accordion" data-apt-faq>
        {faqs.map((faq, fi) => (
          <div class="accordion-item">
            <button class="accordion-trigger" type="button" aria-expanded="false">
              <span class="accordion-num">{String(fi + 1).padStart(2, '0')}</span>
              <span class="accordion-q">{faq.q}</span>
              <span class="accordion-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </button>
            <div class="accordion-panel">
              <div class="accordion-panel__body">
                <p>{faq.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. ENQUIRY FORM -->
  <section class="apt-section apt-section--enquiry" id="enquiry">
    <img src={`${base}/media/apartments/apt-skyline.jpg`} alt="" class="apt-enquiry__bg" aria-hidden="true" />
    <div class="container apt-form-layout">
      <div class="apt-form-intro">
        <div class="apt-form-intro__copy">
          <h2 class="section-title">Request a free society feasibility study</h2>
          <p class="apt-lead">Tell us about your building. We will reply with next steps — no spam, no hard sell.</p>
        </div>
        <div class="apt-form-intro__photo">
