---
import Layout from '../layouts/Layout.astro';
import { OG } from '../i18n/og-images';
import { calcEn } from '../i18n/calculator-en.ts';
import '../styles/solar-calculator.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const commercialWaHref =
  'https://api.whatsapp.com/send?phone=917907369304&text=Hi%20Rayenna%20Energy!%20I%27m%20interested%20in%20commercial%20solar%20installation.';
---
<Layout
  title="Free Solar Calculator for Kerala Homes | System Size & Cost Estimator | Rayenna Energy"
  description="Use Rayenna's free solar calculator to find the right system size and cost for your Kerala home. Get panel count, PM Surya Ghar subsidy estimate, and payback period instantly."
  ogImage={OG.calculator}
>

  <!-- ===== HERO ===== -->
  <section class="page-hero calc-page-hero">
    <img src={`${base}/media/services-hero-opt3.jpg`} alt="Solar panels on a rooftop at sunset" class="page-hero__bg" />
    <div class="page-hero__overlay"></div>
    <div class="container page-hero__inner">
      <p class="page-hero__eyebrow page-hero__eyebrow--pill">☀️ Smart Solar Sizing Tool</p>
      <h1 class="page-hero__title">Find Out How Much<br /><span class="hero-title-grad">You Could Save</span><br />with Solar</h1>
      <p class="page-hero__sub">{calcEn.pageHeroSub}</p>
      <div class="hero-stat-pills" aria-hidden="true">
        <span class="hero-stat-pill"><strong>5 min</strong> to complete</span>
        <span class="hero-stat-pill"><strong>100%</strong> personalised</span>
        <span class="hero-stat-pill"><strong>Free</strong> · no commitment</span>
      </div>
      <div class="hero-commercial-callout page-hero__note page-hero__note--callout">
        <p class="hero-commercial-callout__text">{calcEn.commercialCalloutText}</p>
        <a
          href={commercialWaHref}
          class="hero-commercial-callout__btn"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-location="calculator_hero_commercial_wa"
        >
          <svg width="18" height="18" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M16 .5C7.439.5.5 7.439.5 16c0 2.75.703 5.389 2.043 7.719L.5 31.5l8-2c2.219 1.188 4.719 1.813 7.5 1.813C24.561 31.313 31.5 24.374 31.5 15.813 31.5 7.439 24.561.5 16 .5zm0 28.625c-2.5 0-4.938-.656-7.063-1.906l-.5-.313-5.25 1.313 1.375-5.063-.344-.531C2.844 20.5 2.125 18.281 2.125 16 2.125 8.344 8.344 2.125 16 2.125S29.875 8.344 29.875 16 23.656 29.125 16 29.125zm7.813-9.969c-.438-.219-2.563-1.25-2.969-1.406s-.688-.219-.969.219-1.125 1.406-1.375 1.688-.5.313-.938.094c-.438-.219-1.844-.688-3.5-2.188-1.313-1.156-2.188-2.594-2.438-3.031s-.031-.688.188-.906c.188-.188.438-.5.656-.75s.281-.438.438-.719.156-.531.063-.75-1-2.375-1.375-3.25c-.375-.875-.75-.75-1-.75s-.531 0-.813 0-1.063.281-1.625.875S7.5 10.719 7.5 12.5c0 1.781 1.313 3.531 1.5 3.781s2.594 3.969 6.281 5.563c.875.375 1.563.594 2.094.781.875.281 1.688.25 2.313.156.719-.094 2.219-.906 2.531-1.781s.313-1.625.219-1.781-.344-.281-.781-.5z"/>
          </svg>
          {calcEn.commercialCalloutBtn}
        </a>
      </div>
      <div class="hero-btns">
        <a href="#calculator" class="btn btn-primary hero-scroll-btn">Start the Calculator ↓</a>
        <a href={`${base}/contact/`} class="btn btn-outline-white">Get a Free Consultation</a>
      </div>
    </div>
  </section>

  <!-- ===== TRUST STRIP ===== -->
  <section class="trust-strip">
    <div class="container trust-inner">
      {calcEn.trustMetrics.map(m => (
        <div class="trust-metric">
          <strong>{m.val}</strong>
          <span>{m.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="calc-intro">
    <div class="container calc-intro__inner">
      <div class="calc-intro__image">
        <img src={`${base}/media/solar-calculator-intro.jpg`} alt="High-efficiency solar panels on a rooftop" />
      </div>
      <div class="calc-intro__content">
        <span class="section-tag">How it works</span>
        <h2 class="section-title">Your Home is Unique. Your Solar System Should Be Too.</h2>
        <p>Most solar quotes start with guesswork, not your home's reality. Ours don't. Tell us your home type, rooms, appliances, and EV usage — and we'll calculate your system size, panel count, roof space, subsidy, and 25-year savings. All of it. Free. In under 5 minutes.</p>
        <p>Not a generic estimate. A smart starting point built around your home — before your free site survey.</p>
        <div class="how-steps">
          <div class="how-step">
            <span class="how-step__num">1</span>
            <span class="how-step__icon" aria-hidden="true">⚡</span>
            <div>
              <h3>Enter your details</h3>
              <p>Home type, rooms, and appliances</p>
            </div>
          </div>
          <div class="how-step__divider" aria-hidden="true"></div>
          <div class="how-step">
            <span class="how-step__num">2</span>
            <span class="how-step__icon" aria-hidden="true">☀️</span>
            <div>
              <h3>Get your recommendation</h3>
              <p>System size, panels, and roof space</p>
            </div>
          </div>
          <div class="how-step__divider" aria-hidden="true"></div>
          <div class="how-step">
            <span class="how-step__num">3</span>
            <span class="how-step__icon" aria-hidden="true">💰</span>
            <div>
              <h3>See your savings</h3>
              <p>Payback period and lifetime savings</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CALCULATOR MODULE ===== -->
  <section class="calculator-section" id="calculator">
    <div class="container">
      <div class="calc-pre-trust" aria-label="Why you can trust this calculator">
        {calcEn.preTrust.map((item) => (
          <span>{item}</span>
        ))}
      </div>
      <div class="calc-card">

        <div class="calc-head">
          <div class="calc-progress">
            <div class="calc-progress-head">
              <div class="calc-progress-track" aria-hidden="true">
                <div class="calc-progress-fill" id="calc-progress-fill" style="width: 0%"></div>
              </div>
              <div class="calc-progress-steps" role="list">
                {calcEn.progressStepNames.map((name, i) => (
                  <div class:list={['cpb-step', { active: i === 0 }]} data-step={i + 1} role="listitem">
                    <div class="cpb-dot">
                      {i === 3 ? <span class="cpb-sun" aria-hidden="true">☀</span> : <span>{i + 1}</span>}
                    </div>
                    <span class="cpb-step-name">{name}</span>
                  </div>
                ))}
              </div>
            </div>
            <p class="calc-step-label" id="step-label">{calcEn.stepLabels[1]}</p>
          </div>
        </div>

        <div class="calc-body">

        <!-- ── STEP 1: HOME ── -->
        <div class="calc-step" id="step-1">
          <h3 class="calc-step-title">About Your Home</h3>
          <p class="calc-step-sub">{calcEn.stepSubtitles[1]}</p>
          <p class="calc-field-label">Home type</p>
          <div class="home-type-grid" id="home-type-grid">
            <div class="ht-card selected" data-type="house">
              <span class="ht-icon">🏠</span>
              <strong>Independent house</strong>
              <small>Standalone home</small>
            </div>
            <div class="ht-card" data-type="apartment">
              <span class="ht-icon">🏢</span>
              <strong>Apartment</strong>
              <small>Flat / unit in a building</small>
            </div>
            <div class="ht-card" data-type="villa">
              <span class="ht-icon">🏡</span>
              <strong>Villa</strong>
              <small>Detached / gated villa</small>
            </div>
            <div class="ht-card" data-type="rowhouse">
              <span class="ht-icon">🏘</span>
              <strong>Row house</strong>
              <small>Terraced / linked home</small>
            </div>
          </div>

          <div class="steppers-group">
            <div class="stepper-row">
              <label>Bedrooms</label>
              <div class="stepper" data-id="bedrooms" data-min="1" data-max="10" data-val="3">
                <button class="stp-btn stp-minus" type="button" aria-label="Decrease">−</button>
                <span class="stp-val">3</span>
                <button class="stp-btn stp-plus" type="button" aria-label="Increase">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <label>Bathrooms</label>
              <div class="stepper" data-id="bathrooms" data-min="1" data-max="10" data-val="2">
                <button class="stp-btn stp-minus" type="button" aria-label="Decrease">−</button>
                <span class="stp-val">2</span>
                <button class="stp-btn stp-plus" type="button" aria-label="Increase">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <label>Floors</label>
              <div class="stepper" data-id="floors" data-min="1" data-max="4" data-val="1">
                <button class="stp-btn stp-minus" type="button" aria-label="Decrease">−</button>
                <span class="stp-val">1</span>
                <button class="stp-btn stp-plus" type="button" aria-label="Increase">+</button>
              </div>
            </div>
          </div>

          <div class="calc-nav">
            <div></div>
            <button class="btn-calc-next" type="button" data-next="2">{calcEn.nextToAppliances}</button>
          </div>
        </div>

        <!-- ── STEP 2: APPLIANCES ── -->
        <div class="calc-step hidden" id="step-2">
          <h3 class="calc-step-title">Your Appliances</h3>
          <p class="calc-step-sub">{calcEn.stepSubtitles[2]}</p>

          <p class="calc-category-label">❄️ Cooling</p>
          <div class="steppers-group">
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>Air conditioners</label>
                <small>1.5 ton split AC, 1500W each</small>
              </div>
              <div class="stepper" data-id="ac" data-min="0" data-max="15" data-val="2">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">2</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>Ceiling fans</label>
                <small>75W each</small>
              </div>
              <div class="stepper" data-id="fans" data-min="0" data-max="30" data-val="4">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">4</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
          </div>

          <p class="calc-category-label">📺 Entertainment</p>
          <div class="steppers-group">
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>Televisions</label>
                <small>LED, 120W each</small>
              </div>
              <div class="stepper" data-id="tvs" data-min="0" data-max="15" data-val="2">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">2</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
          </div>

          <p class="calc-category-label">🍳 Kitchen</p>
          <div class="steppers-group">
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>Refrigerator</label>
                <small>200W, runs 30% of time</small>
              </div>
              <div class="stepper" data-id="fridge" data-min="0" data-max="5" data-val="1">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">1</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>Microwave / OTG</label>
                <small>1200W, ~1 hr/day</small>
              </div>
              <div class="stepper" data-id="microwave" data-min="0" data-max="5" data-val="1">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">1</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
            <div class="stepper-row">
              <div class="stepper-label-group">
                <label>Washing machine</label>
                <small>500W, ~1 hr/day</small>
              </div>
              <div class="stepper" data-id="washing" data-min="0" data-max="4" data-val="1">
                <button class="stp-btn stp-minus" type="button">−</button>
                <span class="stp-val">1</span>
                <button class="stp-btn stp-plus" type="button">+</button>
              </div>
            </div>
          </div>

          <p class="calc-category-label">🔌 Other</p>
          <div class="toggles-group">
            <div class="toggle-row">
              <div class="stepper-label-group">
                <label>Water heater / geyser</label>
                <small>2000W, ~1 hr/day</small>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggle-geyser" checked />
                <span class="toggle-pill"></span>
              </label>
            </div>
            <div class="toggle-row">
              <div class="stepper-label-group">
                <label>Water pump / motor</label>
                <small>750W, ~2 hrs/day</small>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggle-pump" />
                <span class="toggle-pill"></span>
              </label>
            </div>
          </div>

          <!-- EV Section -->
          <div class="ev-section">
            <div class="toggle-row ev-toggle-row">
              <label class="ev-main-label">⚡ I have an electric vehicle</label>
              <label class="toggle-switch">
                <input type="checkbox" id="toggle-ev" />
                <span class="toggle-pill"></span>
              </label>
            </div>

            <div class="ev-panel hidden" id="ev-panel">
              <div class="steppers-group">
                <div class="stepper-row">
                  <label>Number of EVs</label>
                  <div class="stepper" data-id="ev-count" data-min="1" data-max="4" data-val="1">
                    <button class="stp-btn stp-minus" type="button">−</button>
                    <span class="stp-val">1</span>
                    <button class="stp-btn stp-plus" type="button">+</button>
                  </div>
                </div>
              </div>

              <p class="calc-field-label" style="margin-top:20px;">Charger type</p>
              <div class="charger-grid" id="charger-grid">
                <div class="charger-card" data-kw="2.3">
                  <strong>2.3 kW</strong>
                  <span>Regular 5A socket</span>
                  <small>Overnight standard plug</small>
                </div>
                <div class="charger-card selected" data-kw="3.3">
                  <strong>3.3 kW</strong>
                  <span>Slow wall box</span>
                  <small>Standard home charger</small>
                </div>
                <div class="charger-card" data-kw="7.4">
                  <strong>7.4 kW</strong>
                  <span>Fast wall box</span>
                  <small>Dedicated AC charger</small>
                </div>
                <div class="charger-card" data-kw="11">
                  <strong>11 kW</strong>
                  <span>Rapid AC charger</span>
                  <small>3-phase, premium setup</small>
                </div>
              </div>

              <div class="sliders-group">
                <div class="slider-row">
                  <label>Daily charging duration: <strong id="ev-hours-val">4</strong> hrs</label>
                  <input type="range" id="ev-hours" min="1" max="12" value="4" step="1" class="calc-slider" />
                  <div class="slider-range-labels"><span>1 hr</span><span>12 hrs</span></div>
                </div>
                <div class="slider-row">
                  <label>Days charged per week: <strong id="ev-days-val">5</strong> days</label>
                  <input type="range" id="ev-days" min="1" max="7" value="5" step="1" class="calc-slider" />
                  <div class="slider-range-labels"><span>1 day</span><span>7 days</span></div>
                </div>
              </div>

              <div class="ev-impact-panel" id="ev-impact">
                <div class="ev-impact-row">
                  <div>
                    <p class="ev-impact-label">Added daily load (avg)</p>
                    <p class="ev-impact-val" id="ev-added-load">— kWh</p>
                  </div>
                  <div>
                    <p class="ev-impact-label">Extra panels needed</p>
                    <p class="ev-impact-val" id="ev-extra-panels">— panels</p>
                  </div>
                </div>
                <p class="ev-impact-note" id="ev-impact-note"></p>
              </div>
            </div>
          </div>

          <div class="calc-nav">
            <button class="btn-calc-back" type="button" data-back="1">← Back</button>
            <button class="btn-calc-next" type="button" data-next="3">{calcEn.nextToUsage}</button>
          </div>
        </div>

        <!-- ── STEP 3: USAGE PATTERN ── -->
        <div class="calc-step hidden" id="step-3">
          <h3 class="calc-step-title">Your Usage Pattern</h3>
          <p class="calc-step-sub">{calcEn.stepSubtitles[3]}</p>
          <div class="sliders-group">
            <div class="slider-row">
              <label>AC usage per day: <strong id="ac-hours-val">8</strong> hrs</label>
              <input type="range" id="ac-hours" min="2" max="16" value="8" step="1" class="calc-slider" />
              <div class="slider-range-labels"><span>2 hrs</span><span>16 hrs</span></div>
            </div>
          </div>

          <p class="calc-field-label" style="margin-top:28px;">Daytime occupancy</p>
          <div class="occupancy-grid" id="occupancy-grid">
            <div class="occ-card selected" data-occ="home">
              <strong>🏠 Home all day</strong>
              <small>Housewife, work from home</small>
            </div>
            <div class="occ-card" data-occ="away">
              <strong>🚗 Away daytime</strong>
              <small>Office goers, school hours</small>
            </div>
          </div>

          <div class="sliders-group" style="margin-top:28px;">
            <div class="slider-row">
              <label>Monthly KSEB bill: <strong id="bill-val">₹5,000</strong></label>
              <input type="range" id="bill-slider" min="1000" max="15000" value="5000" step="500" class="calc-slider" />
              <div class="slider-range-labels"><span>₹1,000</span><span>₹15,000</span></div>
            </div>
          </div>

          <div class="calc-nav">
            <button class="btn-calc-back" type="button" data-back="2">← Back</button>
            <button class="btn-calc-next btn-calc-primary" type="button" data-next="4">{calcEn.calculateCta}</button>
          </div>
        </div>

        <!-- ── STEP 4: RESULTS ── -->
        <div class="calc-step hidden" id="step-4">
          <h3 class="calc-step-title">Your Personalised Solar Estimate</h3>
          <p class="calc-results-intro">A planning estimate based on your inputs and current Kerala rooftop solar assumptions.</p>

          <!-- Hero result card -->
          <div class="result-hero">
            <div class="result-hero__top">
              <div>
                <p class="result-hero-label">Recommended rooftop solar size</p>
                <p class="result-hero-kw" id="result-kw">— kW</p>
                <p class="result-hero-units" id="result-units">Estimated generation ~— units/year</p>
              </div>
              <div class="result-pill-row">
                <span class="result-pill">Planning estimate</span>
                <span class="result-pill">Residential only</span>
                <span class="result-pill">Kerala market basis</span>
              </div>
            </div>
            <p class="result-hero-summary" id="result-summary">Sized around your current bill, appliance mix, and daytime usage pattern.</p>
            <div class="result-highlights">
              <div class="result-highlight">
                <span class="rh-label">Estimated annual savings</span>
                <strong class="rh-value" id="result-annual-top">—</strong>
              </div>
              <div class="result-highlight">
                <span class="rh-label">Estimated payback</span>
                <strong class="rh-value" id="result-payback-top">—</strong>
              </div>
            </div>
          </div>

          <div class="kpi-dashboard" aria-label="Key estimate metrics">
            <div class="kpi-card kpi-card--accent">
              <span class="kpi-icon" aria-hidden="true">☀️</span>
              <p class="kpi-label">Recommended system</p>
              <p class="kpi-value" id="kpi-system-kw">— kW</p>
            </div>
            <div class="kpi-card">
              <span class="kpi-icon" aria-hidden="true">💚</span>
              <p class="kpi-label">Estimated annual savings</p>
              <p class="kpi-value" id="kpi-annual">—</p>
            </div>
            <div class="kpi-card">
              <span class="kpi-icon" aria-hidden="true">⏱️</span>
              <p class="kpi-label">Estimated payback</p>
              <p class="kpi-value" id="kpi-payback">—</p>
            </div>
            <div class="kpi-card">
              <span class="kpi-icon" aria-hidden="true">💳</span>
              <p class="kpi-label">Net cost to you</p>
              <p class="kpi-value" id="kpi-net-cost">—</p>
            </div>
            <div class="kpi-card">
              <span class="kpi-icon" aria-hidden="true">📈</span>
              <p class="kpi-label">25-year savings</p>
              <p class="kpi-value" id="kpi-lifetime">—</p>
            </div>
            <div class="kpi-card">
              <span class="kpi-icon" aria-hidden="true">⚡</span>
              <p class="kpi-label">Daily consumption</p>
              <p class="kpi-value" id="kpi-daily">—</p>
            </div>
          </div>

          <div class="chart-panel">
            <h4 class="chart-panel__title">{calcEn.chartTitle}</h4>
            <p class="chart-panel__subtitle">{calcEn.chartSubtitle}</p>
            <div class="chart-panel__canvas">
              <canvas id="savings-chart" aria-label={calcEn.chartTitle}></canvas>
            </div>
          </div>

          <div class="result-guidance-grid">
            <div class="result-guide-card result-guide-card--accent">
              <p class="guide-card__label">Best fit for your home</p>
              <h4 id="result-fit-title">Balanced family-home solar system</h4>
              <p id="result-fit-copy">Sized from your appliance mix, current bill, and typical Kerala solar conditions.</p>
            </div>
            <div class="result-guide-card">
              <p class="guide-card__label">Before you finalise</p>
              <p>We confirm roof access, shade, structure, wiring runs, and final inverter placement during the free site survey before issuing a fixed proposal.</p>
            </div>
          </div>

          <!-- 4 stat cards -->
          <div class="result-stats-grid">
            <div class="result-stat">
              <span class="rs-icon" aria-hidden="true">⚡</span>
              <p class="rs-label">Daily consumption estimate</p>
              <p class="rs-val" id="result-daily">—</p>
            </div>
            <div class="result-stat">
              <span class="rs-icon" aria-hidden="true">🔲</span>
              <p class="rs-label">Panels needed</p>
