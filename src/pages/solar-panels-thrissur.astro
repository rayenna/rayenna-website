---
import Layout from '../layouts/Layout.astro';
import { OG } from '../i18n/og-images';
import { useTranslations } from '../i18n/ui';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = useTranslations('en');
const pc = t.pageConvert.city;
---
<Layout
  title="Solar Panel Installation in Thrissur | Rayenna Energy Kerala"
  description="Solar panel installation in Thrissur by Rayenna Energy — MNRE-approved, PM Surya Ghar subsidy up to ₹78,000, free site survey. Call +91 7907 369 304."
  ogImage={OG.thrissur}
>

  <section class="area-hero">
    <img src={`${base}/media/hero (1).webp`} alt="Rooftop solar panel installation in Thrissur, Kerala" class="area-hero__bg" />
    <div class="area-hero__overlay"></div>
    <div class="container area-hero__inner">
      <p class="area-hero__eyebrow">Serving Thrissur District</p>
      <h1 class="area-hero__title">Solar Panel Installation<br />in Thrissur</h1>
      <p class="area-hero__sub">MNRE-approved solar installer serving Thrissur and surrounding areas. Government subsidy up to ₹78,000. Free rooftop assessment. 25-year panel warranty.</p>
      <div class="area-hero__ctas">
        <a href={`${base}/solar-calculator`} class="btn btn-primary">☀️ Calculate My Savings</a>
        <a href={`${base}/contact`} class="btn btn-outline-light">Book a Free Survey →</a>
      </div>
      <p class="area-hero__micro">{pc.heroMicro}</p>
      <p class="area-hero__phone">{pc.heroPhone} <a href="tel:+917907369304" data-analytics-location="city_hero">+91 7907 369 304</a></p>
    </div>
  </section>

  <!-- ===== WHY THRISSUR ===== -->
  <section class="area-why">
    <div class="container area-why__inner">
      <div class="area-why__content">
        <span class="section-tag">Thrissur's Solar Potential</span>
        <h2 class="section-title">Solar in Thrissur — The Numbers Work</h2>
        <p>Thrissur district's semi-interior location means it enjoys slightly more stable solar irradiance than coastal Kochi, with lower humidity reducing soiling losses on panels. A well-sized 3–5 kW system in Thrissur can offset 80–90% of the average household's KSEB bill, with payback typically in 3–4 years after subsidy.</p>
        <p>Thrissur's mix of large independent homes, commercial establishments, and agricultural land makes it an ideal region for both domestic and commercial solar adoption. Rayenna's team makes regular visits to Thrissur for site surveys and installations, ensuring fast turnaround without the delay of distant contractors.</p>
        <ul class="area-facts">
          <li><span class="fact-icon">🌞</span><span><strong>Higher annual yields</strong> — Thrissur's inland position reduces coastal cloud cover compared to Kochi</span></li>
          <li><span class="fact-icon">🏠</span><span><strong>Larger roof areas</strong> — independent homes in Thrissur commonly support 5–10 kW systems</span></li>
          <li><span class="fact-icon">⚡</span><span><strong>KSEB net metering active</strong> — surplus units exported to the grid reduce your bill further</span></li>
          <li><span class="fact-icon">📞</span><span><strong>Regular service visits</strong> — Rayenna's team visits Thrissur district weekly for surveys and follow-ups</span></li>
        </ul>
      </div>
      <div class="area-why__image">
        <img src={`${base}/media/Hardshell-solar.webp`} alt="High-quality solar panels installed in Thrissur by Rayenna" />
      </div>
    </div>
  </section>

  <!-- ===== SUBSIDY ===== -->
  <section class="area-subsidy">
    <div class="container">
      <div class="area-subsidy__inner">
        <div class="subsidy-icon">🏛️</div>
        <div class="subsidy-content">
          <h2>Central Government Subsidy for Thrissur Homeowners</h2>
          <p>As a Kerala resident, you're eligible for the PM Surya Ghar Muft Bijli Yojana subsidy — up to <strong>₹78,000</strong> credited directly to your bank account after installation. Rayenna manages the entire online application and co-ordinates with KSEB's Thrissur division for net metering connection, at no extra charge.</p>
          <div class="subsidy-table">
            <div class="subsidy-row"><span>Up to 2 kW</span><strong>₹30,000 – ₹60,000 subsidy</strong></div>
            <div class="subsidy-row"><span>3 kW system</span><strong>₹78,000 subsidy</strong></div>
            <div class="subsidy-row"><span>3–10 kW system</span><strong>₹78,000 + 20% on balance cost</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LOCAL INSTALLATIONS ===== -->
  <section class="area-installs">
    <div class="container">
      <h2 class="section-title text-center">Recent Thrissur & North Kerala Installations</h2>
      <div class="area-installs-grid">
        {[
          { name: 'Joby',   location: 'Chalakudy', cap: '3 kW', img: 'JOBYCHALAKUDY3KW-DEYE-INVERTER-PANELS-ADANI.jpeg' },
          { name: 'Koya',   location: 'Nilambur',  cap: '3 kW', img: 'KOYA-NILAMBUR-3KW-SOLIS-INVERTER-PANELS-RENEW.png' },
          { name: 'Rupesh', location: 'Calicut',   cap: '3 kW', img: 'RUPESHCALICUT3KW-DEYE-INVERTER-PANELS-ADANI-edited.jpeg' },
          { name: 'Jelees', location: 'Mahe',      cap: '5 kW', img: 'JELEESMAHE5KW-FESTON-INVERTER-PANELS-WAAREE.jpeg' },
        ].map(item => (
          <div class="area-install-card">
            <img src={`${base}/media/references/${item.img}`} alt={`${item.cap} solar installation for ${item.name} in ${item.location}`} loading="lazy" />
            <div class="area-install-label">
              <strong>{item.name}</strong>
              <span>{item.location} · {item.cap}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="installs-cta-text"><a href={`${base}/media`}>See all our installations →</a></p>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="area-faq">
    <div class="container area-faq__inner">
      <h2 class="section-title">Questions from Thrissur Homeowners</h2>
      <div class="area-faq__list">
        {[
          {
            q: 'How far does Rayenna travel for installations in Thrissur?',
            a: "Rayenna's installation team covers the entire Thrissur district, including Chalakudy, Irinjalakuda, Kunnamkulam, and surrounding taluks. We schedule dedicated Thrissur visit days to keep travel costs down and response times fast.",
          },
          {
            q: 'What system size is right for a typical Thrissur home?',
            a: 'Most Thrissur households with a monthly KSEB bill of ₹2,000–₹5,000 find a 3–5 kW system to be the right size. Our free site survey includes a load analysis to recommend the optimal system capacity — not just the minimum that qualifies for subsidy.',
          },
          {
            q: 'Can agricultural connections (LT-7) in Thrissur get solar net metering?',
            a: 'Agricultural connections can install solar but net metering eligibility depends on your connection type and KSEB sub-division policy. Our team can advise on the current rules for your specific tariff category during the free survey.',
          },
        ].map(item => (
          <details class="area-faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <p class="area-faq__more">More questions? <a href={`${base}/faqs`}>Browse our full FAQ library →</a></p>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="area-cta">
    <div class="container area-cta__inner">
      <div>
        <h2>Get a Free Solar Survey in Thrissur</h2>
        <p>Our team visits Thrissur regularly. Book a free rooftop assessment and we'll bring a site-specific savings estimate — no obligation, no pressure.</p>
      </div>
      <div class="area-cta__btns">
        <a href={`${base}/contact`} class="btn btn-primary">{pc.ctaContact}</a>
        <a href={`${base}/solar-calculator`} class="btn btn-outline">{pc.ctaCalc}</a>
      </div>
    </div>
  </section>

  <!-- Shared blog reading -->
  <section class="area-blog">
    <div class="container">
      <h2 class="section-title">Useful Reading Before You Decide</h2>
      <div class="area-blog__grid">
        <a href={`${base}/blog/pm-surya-ghar-subsidy-guide`} class="area-blog-card">
          <span class="blog-card-tag">Government Schemes</span>
          <strong>PM Surya Ghar Subsidy: Your Complete Guide</strong>
          <span class="blog-card-arrow">→</span>
        </a>
        <a href={`${base}/blog/kseb-net-metering-rules-2026`} class="area-blog-card">
          <span class="blog-card-tag">Net Metering</span>
          <strong>KSEB Net Metering Rules 2026: What's Changed</strong>
          <span class="blog-card-arrow">→</span>
        </a>
        <a href={`${base}/blog/how-much-does-solar-cost-in-kerala`} class="area-blog-card">
          <span class="blog-card-tag">Pricing</span>
          <strong>How Much Does Solar Cost in Kerala?</strong>
          <span class="blog-card-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* Shared hero + section styles — same pattern as Kochi page */
.area-hero {
  position: relative; min-height: 500px; display: flex;
  align-items: flex-end; overflow: hidden; padding-bottom: 64px;
}
.area-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; z-index: 0; }
.area-hero__overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(10,25,50,0.92) 0%, rgba(10,25,50,0.55) 50%, rgba(10,25,50,0.2) 100%); }
.area-hero__inner { position: relative; z-index: 2; padding-top: 100px; }
.area-hero__eyebrow { font-size: 0.75rem; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(255,255,255,0.65); margin-bottom: 10px; }
.area-hero__title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 500; color: #fff; line-height: 1.2; margin-bottom: 16px; }
.area-hero__sub { font-size: clamp(0.95rem, 2vw, 1.05rem); color: rgba(255,255,255,0.75); max-width: 540px; line-height: 1.75; margin-bottom: 32px; }
.area-hero__ctas { display: flex; flex-wrap: wrap; gap: 14px; }
.btn-outline-light { border: 2px solid rgba(255,255,255,0.7); color: #fff; padding: 13px 28px; border-radius: 50px; font-family: var(--font-heading); font-weight: 500; font-size: 0.95rem; transition: all var(--transition); }
.btn-outline-light:hover { background: rgba(255,255,255,0.15); }
.area-why { padding: var(--section-padding); background: var(--color-light); }
.area-why__inner { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
.area-why__content p { color: var(--color-text-muted); line-height: 1.85; margin-bottom: 16px; }
.area-why__content .section-title { margin: 12px 0 16px; }
.area-facts { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-direction: column; gap: 14px; }
.area-facts li { display: flex; align-items: flex-start; gap: 10px; font-size: 0.93rem; line-height: 1.6; }
.fact-icon { font-size: 1.1rem; flex-shrink: 0; line-height: 1.5; }
.area-why__image img { width: 100%; height: 320px; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
@media (min-width: 900px) { .area-why__inner { grid-template-columns: 1fr 1fr; } }
.area-subsidy { padding: var(--section-padding); background: #fff; }
.area-subsidy__inner { display: flex; gap: 24px; align-items: flex-start; background: #EEF6FF; border-radius: var(--radius-lg); padding: 36px 32px; border-left: 5px solid #2563eb; }
.subsidy-icon { font-size: 2.4rem; flex-shrink: 0; line-height: 1; }
.subsidy-content h2 { font-family: var(--font-heading); font-size: 1.25rem; color: var(--color-navy); margin-bottom: 12px; font-weight: 600; }
.subsidy-content p { color: var(--color-text-muted); line-height: 1.8; margin-bottom: 20px; font-size: 0.95rem; }
.subsidy-table { display: flex; flex-direction: column; gap: 10px; }
.subsidy-row { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 8px; padding: 12px 16px; font-size: 0.9rem; flex-wrap: wrap; gap: 8px; }
.subsidy-row span { color: var(--color-text-muted); }
.subsidy-row strong { color: #15803d; }
.area-installs { padding: var(--section-padding); background: var(--color-light); }
.area-installs-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 32px;
}
.area-install-card { position: relative; border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 4/3; }
.area-install-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
.area-install-card:hover img { transform: scale(1.04); }
.area-install-label {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: linear-gradient(to top, rgba(10,25,50,0.82) 0%, transparent 100%);
  padding: 20px 12px 12px;
}
.area-install-label strong { display: block; color: #fff; font-size: 0.85rem; font-family: var(--font-heading); }
.area-install-label span { color: rgba(255,255,255,0.7); font-size: 0.75rem; }
.installs-cta-text { text-align: center; margin-top: 20px; font-size: 0.9rem; }
.installs-cta-text a { color: var(--color-primary); font-weight: 600; }
@media (min-width: 640px) {
  .area-installs-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; }
}
.area-faq { padding: var(--section-padding); background: #fff; }
.area-faq__inner { max-width: 800px; }
.area-faq__inner .section-title { margin-bottom: 32px; }
.area-faq__list { display: flex; flex-direction: column; gap: 12px; }
.area-faq-item { border: 1.5px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; background: var(--color-light); }
.area-faq-item summary { padding: 18px 20px; font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; color: var(--color-navy); cursor: pointer; list-style: none; position: relative; padding-right: 44px; }
.area-faq-item summary::after { content: '+'; position: absolute; right: 18px; top: 50%; transform: translateY(-50%); font-size: 1.2rem; color: var(--color-primary); font-weight: 700; transition: transform 0.25s; }
.area-faq-item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
.area-faq-item p { padding: 0 20px 18px; color: var(--color-text-muted); font-size: 0.92rem; line-height: 1.8; }
.area-faq__more { margin-top: 20px; font-size: 0.9rem; }
.area-faq__more a { color: var(--color-primary); font-weight: 600; }
.area-cta { background: var(--color-secondary); padding: var(--section-padding); }
.area-cta__inner { display: flex; flex-direction: column; gap: 28px; align-items: flex-start; }
.area-cta h2 { font-family: var(--font-heading); font-size: clamp(1.4rem, 3vw, 2rem); color: #fff; margin-bottom: 10px; font-weight: 500; }
.area-cta p { color: rgba(255,255,255,0.75); line-height: 1.8; font-size: 0.95rem; }
.area-cta__btns { display: flex; flex-wrap: wrap; gap: 14px; }
.area-cta .btn-outline { border: 2px solid rgba(255,255,255,0.6); color: #fff; background: transparent; }
.area-cta .btn-outline:hover { background: rgba(255,255,255,0.1); }
@media (min-width: 768px) { .area-cta__inner { flex-direction: row; align-items: center; justify-content: space-between; } }
/* Blog section */
.area-blog { padding: var(--section-padding); background: #fff; }
.area-blog .section-title { margin-bottom: 28px; }
.area-blog__grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
.area-blog-card {
  display: flex; align-items: center; gap: 16px;
  background: var(--color-light); border-radius: var(--radius-md);
  padding: 18px 20px; border: 1.5px solid var(--color-border);
  transition: border-color var(--transition), box-shadow var(--transition);
  text-decoration: none;
}
.area-blog-card:hover { border-color: var(--color-primary); box-shadow: var(--shadow-sm); }
.blog-card-tag { font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; color: var(--color-primary); background: rgba(168,56,56,0.08); padding: 3px 8px; border-radius: 4px; white-space: nowrap; flex-shrink: 0; }
.area-blog-card strong { flex: 1; font-family: var(--font-heading); font-size: 0.9rem; color: var(--color-navy); line-height: 1.4; }
.blog-card-arrow { color: var(--color-primary); font-weight: 700; flex-shrink: 0; }
@media (min-width: 768px) { .area-blog__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
