---
import Layout from '../layouts/Layout.astro';
import CorporateVideoSection from '../components/CorporateVideoSection.astro';
import { OG } from '../i18n/og-images';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout
  title="Solar Panel Installation in Kerala | Rayenna Energy"
  description="Rayenna Energy — MNRE-approved solar panel installer in Kerala. Domestic & commercial solar systems, PM Surya Ghar subsidy up to ₹78,000, free site survey. Call +91 7907 369 304."
  ogImage={OG.home}
  ogUpdatedTime="2026-06-07T10:00:00+05:30"
>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <img src={`${base}/media/hero (1).webp`} alt="Solar energy — child flying a kite" class="hero__photo" />
    <div class="hero__gradient"></div>
    <div class="hero__content">
      <h1 class="hero__title">Your KSEB Bill<br />Could Be ₹0.</h1>
      <div class="hero__mid">
        <img src={`${base}/media/Artboard-2mnre.webp`} alt="MNRE Approved Channel Partner — Govt of India" class="mnre-badge-img" />
        <div class="hero__mid-copy">
          <p class="hero__subtitle">Kerala's MNRE-approved solar installer. Government subsidy up to ₹78,000. Free site survey. Most homes break even in 3–5 years — then generate free power for 20+ years.</p>
          <div class="hero-trust-strip">
            <span>✓ MNRE Approved</span>
            <span>✓ ₹78,000 Subsidy</span>
            <span>✓ Free Site Survey</span>
            <span>✓ 25-Year Warranty</span>
          </div>
        </div>
      </div>
      <div class="hero-cta-wrapper">
        <a href={`${base}/solar-calculator`} class="btn btn-hero-primary hero-btn-primary">☀️ Calculate My Savings</a>
        <a href={`${base}/contact`} class="btn btn-hero-outline hero-btn-secondary">Get a call back</a>
      </div>
    </div>
  </section>

  <!-- ===== SOLAR POWER INTRO ===== -->
  <section class="solar-intro">
    <div class="container solar-intro__inner">
      <div class="solar-intro__image">
        <img src={`${base}/media/solar-panel-installation.jpg`} alt="Rayenna technician carrying a solar panel for rooftop installation" />
      </div>
      <div class="solar-intro__content">
        <h2 class="section-title">Kerala Gets More Sun Than Almost Anywhere in India. Are You Using It?</h2>
        <p>With 300+ sunny days a year, a rooftop solar system in Kerala generates power for 6–8 hours daily — enough to slash the average household's KSEB bill by 70 to 80%. Most homes pay back their investment in just 3–5 years, then generate essentially free electricity for the next 20+ years.</p>
        <ul class="solar-intro__bullets">
          <li>
            <span class="bullet-icon">☀️</span>
            <span><strong>Up to ₹78,000 government subsidy</strong> — PM Surya Ghar scheme covers 40% of the cost for systems up to 3 kW</span>
          </li>
          <li>
            <span class="bullet-icon">📉</span>
            <span><strong>Reduce KSEB bills by up to 80%</strong> — export surplus units back to the grid with net metering</span>
          </li>
          <li>
            <span class="bullet-icon">🔋</span>
            <span><strong>25-year panel performance warranty</strong> — quality brands including Adani, Waaree, and Solis installed by trained engineers</span>
          </li>
        </ul>
        <a href={`${base}/solar-calculator`} class="btn btn-primary solar-intro__cta">☀️ Calculate My Savings →</a>
      </div>
    </div>
  </section>

  <!-- ===== WHO WE ARE ===== -->
  <section class="who-we-are">
    <div class="container who-we-are__inner">
      <div class="who-we-are__content">
        <h2 class="section-title">Who We Are</h2>
        <p>Rayenna Energy is a leading provider of innovative solar energy solutions dedicated to transforming the way you harness and use energy. The knowledge and experience of our leadership team are not only a benefit to Rayenna Energy but also the cornerstone upon which we establish our standing as a reliable supplier of solar energy solutions. Going solar is about more than simply saving money on electricity bills; it's about making the earth a better place for future generations. With a deep commitment to delivering high-quality solar installations that prioritise sustainability, efficiency, and affordability, we believe in creating a greener future.</p>
        <a href={`${base}/about`} class="read-more">Read more &gt;&gt;</a>
      </div>
      <div class="who-we-are__stats">
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="20">20</span>
            <span class="stat-suffix">+</span>
          </div>
          <p class="stat-label">Brands</p>
        </div>
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="80">80</span>
            <span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">Less bills</p>
        </div>
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="100">100</span>
            <span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">Client satisfaction</p>
        </div>
        <a href={`${base}/solar-calculator`} class="stats-cta">☀️ See how much you could save →</a>
      </div>
    </div>
  </section>

  <CorporateVideoSection lang="en" aboutHref={`${base}/about`} />

  <!-- ===== INVEST IN SOLAR ===== -->
  <section class="invest-section">
    <img src={`${base}/media/glass-BG.jpg`} alt="" class="invest-bg" />
    <div class="invest-overlay"></div>
    <div class="container invest-inner">
      <div class="invest-left">
        <h2 class="invest-title">This is the right time to invest in a solar panel</h2>
      </div>
      <div class="invest-cards">
        <div class="invest-card">
          <h3>More affordable</h3>
          <p>Solar panel prices have dropped by over 80% in the last two decades, making it more affordable than ever.</p>
        </div>
        <div class="invest-card">
          <h3>More efficient</h3>
          <p>Modern solar panels now boast efficiency rates of up to 22%, maximizing energy output.</p>
        </div>
        <div class="invest-card">
          <h3>More available</h3>
          <p>With over 300 sunny days a year in India, solar power generation is at its peak.</p>
        </div>
        <div class="invest-card">
          <h3>Subsidised</h3>
          <p>Government incentives and subsidies further reduce installation costs, making it a smart financial move today.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== INSTALLATIONS PREVIEW ===== -->
  <section class="installs-preview">
    <div class="container">
      <div class="installs-preview__header">
        <div>
          <span class="section-tag">Real Installations</span>
          <h2 class="section-title">Solar — Beautifully Done</h2>
          <p class="installs-preview__sub">Every system in our gallery was designed, installed, and commissioned by the Rayenna team. Hover to see details.</p>
        </div>
        <a href={`${base}/media`} class="btn btn-outline installs-view-all">View All Installations →</a>
      </div>
      <div class="installs-grid">
        {[
          { name: 'Byju George',   location: 'Thevara',    cap: '10 kW', img: 'BYJU-GEORGE10KWTHEVARA-SOLIS-INVERTER-PANELS-WAAREE-1.jpeg' },
          { name: 'Jelees',        location: 'Mahe',       cap: '5 kW',  img: 'JELEESMAHE5KW-FESTON-INVERTER-PANELS-WAAREE-1.jpeg' },
          { name: 'Hyder',         location: 'Edapally',   cap: '5 kW',  img: 'HYDEREDAPALLY5KW-SOLIS-INVERTER-PANELS-WAAREE.jpeg' },
          { name: 'Angelo Thomas', location: 'Edapally',   cap: '10 kW', img: 'ANGELO-THOMAS-EDAPALLY-10KW-SOLIS-INVERTER-PANELS-WAAREE.png' },
        ].map(item => (
          <div class="install-card">
            <img src={`${base}/media/references/${item.img}`} alt={`${item.cap} solar installation for ${item.name} in ${item.location}`} loading="lazy" />
            <div class="install-card__overlay">
              <strong>{item.name}</strong>
              <span>{item.location} · {item.cap} system</span>
            </div>
          </div>
        ))}
      </div>
      <div class="installs-mobile-cta">
        <a href={`${base}/media`} class="btn btn-outline">View All Installations →</a>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="testimonials-section">
    <div class="container">
      <div class="testimonials-header">
        <span class="section-tag">Customer Stories</span>
        <h2 class="section-title">What Kerala Homeowners Say</h2>
        <p class="testimonials-intro">Real results from real installations across Kerala. Every system installed by Rayenna comes with a 25-year performance warranty and end-to-end support.</p>
      </div>
      <div class="testimonials-grid">

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">The technical and implementation teams were very helpful and knowledgeable. I switched my kitchen stoves from LPG to induction, saving significantly — not just on electricity charges but on LPG consumption too.</p>
          <div class="tcard__author">
            <div class="tcard__avatar">AR</div>
            <div>
              <strong>Arun</strong>
              <span>Kollam · 5 kW system</span>
            </div>
          </div>
        </div>

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">The Rayenna team was very helpful and supportive throughout the implementation. They completed the project at a very competitive rate — overall, excellent value for money.</p>
          <div class="tcard__author">
            <div class="tcard__avatar">SU</div>
            <div>
              <strong>Sudheer</strong>
              <span>Ernakulam · 3 kW system</span>
            </div>
          </div>
        </div>

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">I liked the attitude and professionalism of the team. Very helpful, knowledgeable, and extremely competitive on price. Their after-sales support is excellent too. I have already recommended them to many of my contacts.</p>
          <div class="tcard__author">
            <div class="tcard__avatar">BJ</div>
            <div>
              <strong>Baiju</strong>
              <span>Ernakulam · 10 kW system</span>
            </div>
          </div>
        </div>

      </div>
      <div class="testimonials-footer">
        <a href={`${base}/media`} class="btn btn-outline">See Our Installations →</a>
      </div>
    </div>
  </section>

  <!-- ===== CHOOSING THE RAYENNA WAY ===== -->
  <section class="rayenna-way">
    <div class="container rayenna-way__inner">
      <div class="rayenna-way__image">
        <img src={`${base}/media/Hardshell-solar.webp`} alt="Rayenna solar quality" />
      </div>
      <div class="rayenna-way__content">
        <h2 class="section-title">Choosing the Rayenna Way</h2>
        <p>Quality is our priority at Rayenna. We make sure every solar system is constructed for dependability and long-term performance by using only the best materials. From design to installation, we customise our services to match your unique demands, emphasising accuracy and timeliness in every step. We provide real-time updates and prompt maintenance as needed using online monitoring systems, so you can feel supported even after the installation. Solar power is an easy, hassle-free, affordable alternative because of our commitment to excellent standards and smooth service.</p>
      </div>
    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section class="process-section">
    <div class="container">
      <div class="text-center" style="margin-bottom:56px">
        <h2 class="section-title">Our Process for Seamless Solar Integration</h2>
      </div>
      <div class="process-grid">
        {[
          { num: '01', title: 'Consultation', desc: 'Through a customised consultation, we first ascertain your energy needs and goals.' },
          { num: '02', title: 'Site Evaluation', desc: 'To identify the ideal solar solution for your property, our team thoroughly evaluates the site.' },
          { num: '03', title: 'System Design', desc: 'We develop a unique solar system that optimises performance and efficiency based on the evaluation.' },
          { num: '04', title: 'Installation', desc: 'Your solar system is built up to the highest standards by our trained installers, who execute the process with accuracy.' },
          { num: '05', title: 'Ongoing Support', desc: 'We offer ongoing maintenance and support to ensure that your system operates efficiently, enabling you to experience the advantages of solar energy without any concerns.' },
        ].map(step => (
          <div class="process-card">
            <div class="process-card__num">{step.num}</div>
            <h3 class="process-card__title">{step.title}</h3>
            <p class="process-card__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CALCULATOR CTA CARD ===== -->
  <section class="calc-cta-section">
    <div class="container">
      <div class="calc-cta-card">
        <span class="calc-cta-icon">☀️</span>
        <div class="calc-cta-content">
          <h2>Not sure what size solar system you need?</h2>
          <p>Use our free calculator — enter your home details and get a personalised recommendation in under 5 minutes.</p>
        </div>
        <a href={`${base}/solar-calculator`} class="btn btn-primary calc-cta-btn">☀️ Calculate My Savings →</a>
      </div>
    </div>
  </section>

  <!-- ===== LET'S CONNECT ===== -->
  <section class="connect-section">
    <div class="container connect-section__inner">
      <div class="connect-content">
        <h2 class="section-title connect-title">Let's Connect!</h2>
        <p>Ready to take the next step? Contact us today for a consultation and start your journey toward a more sustainable, cost-effective energy solution.</p>
      </div>
      <div class="connect-form-wrap">
        <form class="connect-form" id="connect-form">
          <input type="hidden" name="subject" value="New Callback Request — Rayenna Website" />
          <input type="hidden" name="source" value="Homepage callback form" />
          <input type="text" name="name" placeholder="Your Name" required />
          <input type="tel" name="phone" placeholder="Phone Number" required />
          <input type="text" name="city" placeholder="Your City" />
          <button type="submit" class="btn btn-primary connect-submit">Get a call back</button>
          <p class="connect-form__feedback" id="connect-feedback" style="display:none"></p>
        </form>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ===== HERO ===== */
.hero {
  position: relative;
  width: 100%;
  min-height: 92vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding-top: 72px; /* navbar height */
}

/* Full-bleed photo across the entire hero */
.hero__photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: right center;
  z-index: 0;
}

/* Gradient gives readability across the wider content area */
.hero__gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(255,255,255,0.65) 0%,
    rgba(255,255,255,0.55) 35%,
    rgba(255,255,255,0.2) 55%,
    rgba(255,255,255,0) 70%
  );
  z-index: 1;
}

/* Text content sits on the left over the white area */
.hero__content {
  position: relative;
  z-index: 2;
  max-width: 620px;
  width: 52%;
  padding: 60px 0 60px 6vw;
}

.hero__title {
  font-family: var(--font-heading);
  font-size: clamp(2.2rem, 4.5vw, 4rem);
  font-weight: 400;
  color: #a83838;
  line-height: 1.2;
  margin-bottom: 32px;
}

.hero__mid {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-bottom: 0;
}

.hero__mid-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ===== MNRE BADGE IMAGE ===== */
.mnre-badge-img {
  flex-shrink: 0;
  width: 150px;
  height: 150px;
  object-fit: contain;
}

.hero__subtitle {
  font-size: 1rem;
  color: #a83838;
  line-height: 1.75;
  flex: 1;
  min-width: 0;
}

/* ===== HERO TRUST STRIP ===== */
.hero-trust-strip {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px 16px;
  width: 100%;
}
.hero-trust-strip span {
  font-size: 0.78rem;
  font-weight: 600;
  color: #27324f;
  opacity: 0.75;
  letter-spacing: 0.3px;
  text-align: center;
}

/* ===== HERO CTA WRAPPER — mobile first ===== */
.hero-cta-wrapper {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  margin-top: 32px;
}
.hero-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  min-height: 52px;
  padding: 14px 28px;
  border-radius: 50px;
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all var(--transition);
  text-decoration: none;
  background: #a83838;
  color: #fff;
  border: 2px solid #a83838;
  -webkit-tap-highlight-color: transparent;
}
.hero-btn-primary:hover { background: #8a2c2c; border-color: #8a2c2c; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(168,56,56,0.35); }
.hero-btn-primary:active { opacity: 0.85; transform: none; }
.hero-btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  min-height: 52px;
  padding: 14px 28px;
  border-radius: 50px;
  font-family: var(--font-heading);
  font-weight: 500;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all var(--transition);
  text-decoration: none;
  background: transparent;
  color: #a83838;
  border: 2px solid #a83838;
  -webkit-tap-highlight-color: transparent;
}
.hero-btn-secondary:hover { background: #a83838; color: #fff; transform: translateY(-2px); }
.hero-btn-secondary:active { opacity: 0.85; transform: none; }
@media (min-width: 768px) {
  .hero-cta-wrapper { flex-direction: row; width: auto; }
  .hero-btn-primary, .hero-btn-secondary { width: auto; }
}

/* ===== SOLAR INTRO ===== */
.solar-intro {
  padding: var(--section-padding);
  padding-bottom: 40px;
  background: var(--color-light);
}
.solar-intro__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.solar-intro__image img {
  width: 100%;
  max-width: 528px;
  height: 420px;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  object-fit: cover;
  object-position: center 20%;
  display: block;
}
.solar-intro__content p {
  color: var(--color-text-muted);
  line-height: 1.9;
  font-size: 1rem;
  margin-bottom: 20px;
}
.solar-intro__content .section-title {
  margin-bottom: 20px;
}
.solar-intro__bullets {
  list-style: none;
  padding: 0;
  margin: 0 0 28px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.solar-intro__bullets li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 0.93rem;
  color: var(--color-text);
  line-height: 1.6;
}
.bullet-icon {
  font-size: 1.1rem;
  line-height: 1.5;
  flex-shrink: 0;
}
.solar-intro__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  max-width: 100%;
}

/* ===== WHO WE ARE ===== */
.who-we-are {
  padding: var(--section-padding);
  padding-top: 40px;
  background: var(--color-light);
}
.who-we-are__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.who-we-are__content .section-title {
  margin-bottom: 20px;
}
.who-we-are__content p {
  color: var(--color-text-muted);
  line-height: 1.9;
  margin-bottom: 20px;
}
.read-more {
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--color-primary);
  font-size: 0.95rem;
  transition: color var(--transition);
}
.read-more:hover { color: var(--color-primary-dark); }

.who-we-are__stats {
  display: flex;
  flex-direction: column;
  gap: 40px;
  align-items: center;
}
.stat-item { text-align: center; }
.stat-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2px;
}
.stat-number {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(3rem, 5vw, 5rem);
  font-weight: 600;
  color: #2a2a2a;
  line-height: 1;
}
.stat-suffix {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(1.5rem, 2.5vw, 2.5rem);
  font-weight: 500;
  color: #2a2a2a;
}
.stat-label {
  font-family: var(--font-heading);
  font-size: clamp(0.7rem, 2.5vw, 0.85rem);
  font-weight: 600;
  color: var(--color-text-muted);
  margin-top: 8px;
  text-transform: uppercase;
  letter-spacing: 2px;
}

/* Stats CTA — mobile first */
.stats-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  margin-top: 28px;
  padding: 15px 32px;
  background-color: var(--color-primary);
  color: #fff;
  border-radius: 50px;
  font-size: 0.9rem;
  font-weight: 600;
  font-family: var(--font-heading);
  letter-spacing: 0.3px;
  text-decoration: none;
  min-height: 52px;
  box-shadow: 0 4px 18px rgba(168, 56, 56, 0.28);
  -webkit-tap-highlight-color: transparent;
  transition: background var(--transition), box-shadow var(--transition), transform var(--transition);
}
.stats-cta:hover {
  background-color: var(--color-primary-dark);
  box-shadow: 0 6px 24px rgba(168, 56, 56, 0.4);
  transform: translateY(-1px);
  color: #fff;
}
.stats-cta:active { opacity: 0.85; transform: none; }
@media (min-width: 768px) {
  .stats-cta { width: auto; padding: 13px 36px; }
}

/* ===== INVEST IN SOLAR ===== */
.invest-section {
  position: relative;
  min-height: 520px;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.invest-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 0;
}
.invest-overlay {
  position: absolute;
  inset: 0;
  background: rgba(10, 20, 45, 0.45);
  z-index: 1;
}
.invest-inner {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  padding-top: 72px;
  padding-bottom: 72px;
}
.invest-left {
  padding-right: 24px;
}
.invest-title {
  font-family: var(--font-heading);
  font-size: clamp(1.8rem, 3.5vw, 3rem);
  font-weight: 400;
  color: #ffffff;
  line-height: 1.25;
}
.invest-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.invest-card {
  background: rgba(20, 35, 75, 0.65);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-md);
  padding: 28px 24px;
}
