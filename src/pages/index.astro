---
import Layout from '../layouts/Layout.astro';
import CorporateVideoSection from '../components/CorporateVideoSection.astro';
import { OG } from '../i18n/og-images';
import { useTranslations } from '../i18n/ui';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = useTranslations('en');
---
<Layout
  title="Solar Panel Installation in Kerala | Rayenna Energy"
  description="Rayenna Energy — MNRE-approved solar panel installer in Kerala. Domestic & commercial solar systems, PM Surya Ghar subsidy up to ₹78,000, free site survey. Call +91 7907 369 304."
  ogImage={OG.home}
  ogUpdatedTime="2026-08-12T16:00:00+05:30"
>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <img src={`${base}/media/hero (1).webp`} alt="Solar energy — child flying a kite" class="hero__photo" />
    <div class="hero__gradient"></div>
    <div class="hero__content">
      <h1 class="hero__title">Your KSEB Bill<br />Could Be ₹0.</h1>
      <div class="hero__mid">
        <img src={`${base}/media/Artboard-2mnre.webp`} alt="MNRE Approved Channel Partner — Govt of India" class="mnre-badge-img" />
        <div class="hero__mid-copy">
          <p class="hero__subtitle">{t.homeConvert.heroSubtitle}</p>
          <div class="hero-trust-strip" aria-label="Trust highlights">
            <span>MNRE Approved</span>
            <span>₹78,000 Subsidy</span>
            <span>Free Survey</span>
            <span>25-Year Warranty</span>
          </div>
        </div>
      </div>
      <div class="hero-cta-wrapper">
        <a href={`${base}/contact/`} class="btn btn-hero-primary hero-btn-primary">{t.homeConvert.heroPrimary}</a>
        <a href={`${base}/solar-calculator/`} class="btn btn-hero-outline hero-btn-secondary">{t.homeConvert.heroSecondary}</a>
      </div>
      <p class="hero-cta-micro">{t.homeConvert.heroMicro}</p>
      <p class="hero-phone-cta">
        {t.homeConvert.heroPhone}{' '}
        <a href="tel:+917907369304" data-analytics-location="home_hero">+91 7907 369 304</a>
      </p>
    </div>
  </section>

  <!-- ===== WHY NOW 2026 ===== -->
  <section class="why-now" data-reveal>
    <div class="container">
      <p class="season-note">{t.homeConvert.seasonNote}</p>
      <h2 class="section-title why-now__title">{t.homeConvert.whyNowLabel}</h2>
      <div class="why-now__grid">
        {t.homeConvert.whyNow.map((item) => (
          <div class="why-now__card">
            <span class="why-now__icon">{item.icon}</span>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SOLAR POWER INTRO ===== -->
  <section class="solar-intro" data-reveal>
    <div class="container solar-intro__inner">
      <div class="solar-intro__image">
        <img src={`${base}/media/solar-panel-installation.jpg`} alt="Rayenna technician carrying a solar panel for rooftop installation" />
      </div>
      <div class="solar-intro__content">
        <h2 class="section-title">Kerala Gets More Sun Than Almost Anywhere in India. Are You Using It?</h2>
        <p>With 300+ sunny days a year, a rooftop solar system in Kerala generates power for 6–8 hours daily — enough to slash the average household's KSEB bill by 70 to 80%. Most homes pay back their investment in just 3–5 years, then generate essentially free electricity for the next 25+ years.</p>
        <ul class="solar-intro__bullets">
          <li>
            <span class="bullet-icon">☀️</span>
            <span><strong>Up to ₹78,000 government subsidy</strong> — PM Surya Ghar scheme covers 40% of the cost for systems up to 3 kW</span>
          </li>
          <li>
            <span class="bullet-icon">📉</span>
            <span><strong>Reduce KSEB bills by up to 80%</strong> — export surplus units back to the grid with net metering</span>
          </li>
          <li>
            <span class="bullet-icon">🔋</span>
            <span><strong>25-year panel performance warranty</strong> — quality brands including Adani, Waaree, and Solis installed by trained engineers</span>
          </li>
        </ul>
        <div class="solar-intro__actions">
          <a href={`${base}/contact/`} class="text-cta">{t.homeConvert.midLinkQuote}</a>
          <a href={`${base}/solar-calculator/`} class="text-cta text-cta--muted">{t.homeConvert.midLinkCalc}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHO WE ARE ===== -->
  <section class="who-we-are" data-reveal>
    <div class="container who-we-are__inner">
      <div class="who-we-are__content">
        <h2 class="section-title">{t.homeConvert.whoTitle}</h2>
        <p>{t.homeConvert.whoBody}</p>
        <ul class="who-points">
          {t.homeConvert.whoPoints.map((point) => (
            <li>
              <strong>{point.title}</strong>
              <span>{point.text}</span>
            </li>
          ))}
        </ul>
        <a href={`${base}/about/`} class="text-cta">{t.homeConvert.whoReadMore}</a>
      </div>
      <div class="who-we-are__stats">
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="20">20</span>
            <span class="stat-suffix">+</span>
          </div>
          <p class="stat-label">{t.homeConvert.whoStatBrands}</p>
        </div>
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="80">80</span>
            <span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">{t.homeConvert.whoStatBills}</p>
        </div>
        <div class="stat-item">
          <div class="stat-wrap">
            <span class="stat-number" data-target="100">100</span>
            <span class="stat-suffix">%</span>
          </div>
          <p class="stat-label">{t.homeConvert.whoStatSatisfied}</p>
        </div>
        <a href={`${base}/solar-calculator/`} class="text-cta who-stats-link">{t.homeConvert.whoStatsCta}</a>
      </div>
    </div>
  </section>

  <CorporateVideoSection lang="en" aboutHref={`${base}/about`} />

  <!-- ===== INVEST IN SOLAR ===== -->
  <section class="invest-section" data-reveal>
    <img src={`${base}/media/glass-BG.jpg`} alt="" class="invest-bg" />
    <div class="invest-overlay"></div>
    <div class="container invest-inner">
      <div class="invest-left">
        <h2 class="invest-title">{t.homeConvert.investTitle} <em class="invest-urgency">{t.homeConvert.investUrgency}</em></h2>
      </div>
      <div class="invest-cards">
        {t.homeConvert.investCards.map((card) => (
          <div class="invest-card">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== INSTALLATIONS PREVIEW ===== -->
  <section class="installs-preview" data-reveal>
    <div class="container">
      <div class="installs-preview__header">
        <div>
          <h2 class="section-title">{t.homeConvert.installsTitle}</h2>
          <p class="installs-preview__sub">{t.homeConvert.installsSub}</p>
        </div>
        <a href={`${base}/media/`} class="btn btn-outline installs-view-all">{t.homeConvert.installsViewAll}</a>
      </div>
      <div class="installs-grid" role="list">
        {[
          { name: 'Arun',          location: 'Kollam',        cap: '5 kW', img: 'ARUN-KOLLAM-5KW-SOLIS-INVERTER-PANELS-WAAREE.jpeg' },
          { name: 'Sessy Antony',  location: 'Chottanikkara', cap: '6 kW', img: 'SESSY ANTONY-CHOTTANIKKARA-6KW-DEYE-INVERTER-PANELS-EMMVEE.jpeg' },
          { name: 'Suresh',        location: 'Eroor',         cap: '4 kW', img: 'SURESH-EROOR-4KW-SUNWAYS-INVERTER-PANELS-WAAREE.jpeg' },
          { name: 'Dhanya V.T.',   location: 'Thoppumpady',   cap: '5 kW', img: 'DHANYA V T-THOPPUMPADY-5KW-EASTMAN-INVERTER-PANELS-ADANI.jpeg' },
        ].map(item => (
          <a href={`${base}/media/`} class="install-card" role="listitem">
            <img src={`${base}/media/references/${item.img}`} alt={`${item.cap} solar installation for ${item.name} in ${item.location}`} loading="lazy" />
            <div class="install-card__overlay">
              <strong>{item.name}</strong>
              <span>{item.location} · {item.cap}</span>
            </div>
          </a>
        ))}
      </div>
      <blockquote class="installs-proof">
        <p class="installs-proof__quote">{t.homeConvert.installsQuote}</p>
        <a href={`${base}/media/`} class="text-cta">{t.homeConvert.installsQuoteLink}</a>
      </blockquote>
      <div class="installs-mobile-cta">
        <a href={`${base}/media/`} class="text-cta">{t.homeConvert.installsViewAll}</a>
      </div>
    </div>
  </section>

  <!-- ===== FEATURED BILL STORY ===== -->
  <section class="bill-story" data-reveal>
    <div class="container bill-story__inner">
      <div class="bill-story__media">
        <img
          src={`${base}/media/references/ARUN-KOLLAM-5KW-SOLIS-INVERTER-PANELS-WAAREE.jpeg`}
          alt="5 kW rooftop solar for Arun in Kollam"
          loading="lazy"
        />
      </div>
      <div class="bill-story__content">
        <p class="bill-story__eyebrow">{t.homeConvert.billStoryEyebrow}</p>
        <h2 class="section-title">{t.homeConvert.billStoryTitle}</h2>
        <p class="bill-story__meta">{t.homeConvert.billStoryMeta}</p>
        <div class="bill-story__compare" role="list">
          <div class="bill-story__col bill-story__col--before" role="listitem">
            <span class="bill-story__label">{t.homeConvert.billStoryBeforeLabel}</span>
            <p>{t.homeConvert.billStoryBefore}</p>
          </div>
          <div class="bill-story__col bill-story__col--after" role="listitem">
            <span class="bill-story__label">{t.homeConvert.billStoryAfterLabel}</span>
            <p>{t.homeConvert.billStoryAfter}</p>
          </div>
        </div>
        <blockquote class="bill-story__quote">{t.homeConvert.billStoryQuote}</blockquote>
        <a href={`${base}/media/`} class="text-cta">{t.homeConvert.billStoryCta}</a>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="testimonials-section" data-reveal>
    <div class="container">
      <div class="testimonials-header">
        <h2 class="section-title">{t.homeConvert.testimonialsTitle}</h2>
        <p class="testimonials-intro">{t.homeConvert.testimonialsIntro}</p>
      </div>
      <div class="testimonials-grid">

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">Rayenna's team was exceptionally helpful and knowledgeable. After going solar, I switched my kitchen stoves from LPG to induction — my electricity bill dropped, and so did my LPG costs. Double savings!</p>
          <div class="tcard__author">
            <div class="tcard__avatar">AR</div>
            <div>
              <strong>Arun</strong>
              <span>Kollam · 5 kW system</span>
            </div>
          </div>
        </div>

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">The Rayenna team was helpful and supportive at every stage — from the first call to final installation. They delivered at a very competitive price, and the quality made it exceptional value. Thoroughly satisfied!</p>
          <div class="tcard__author">
            <div class="tcard__avatar">SU</div>
            <div>
              <strong>Sudheer</strong>
              <span>Ernakulam · 3 kW system</span>
            </div>
          </div>
        </div>

        <div class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p class="tcard__quote">Rayenna's team truly impressed me — professional, helpful, and knowledgeable. Their pricing is unbeatable, and their support doesn't stop after installation. I've already recommended them to several of my contacts and will continue to do so!</p>
          <div class="tcard__author">
            <div class="tcard__avatar">BJ</div>
            <div>
              <strong>Baiju</strong>
              <span>Ernakulam · 10 kW system</span>
            </div>
          </div>
        </div>

      </div>
      <div class="testimonials-footer">
        <a href={`${base}/media/`} class="text-cta">{t.homeConvert.testimonialsMore}</a>
      </div>
    </div>
  </section>

  <!-- ===== THE RAYENNA WAY ===== -->
  <section class="rayenna-way" data-reveal>
    <div class="container rayenna-way__inner">
      <div class="rayenna-way__content">
        <h2 class="section-title">{t.homeConvert.wayTitle}</h2>
        <p class="rayenna-way__lead">{t.homeConvert.wayLead}</p>
        <ul class="way-points">
          {t.homeConvert.wayPoints.map((point) => (
            <li>
              <strong>{point.title}</strong>
              <span>{point.text}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rayenna-way__image">
        <img src={`${base}/media/Hardshell-solar.webp`} alt="Rayenna solar quality" />
      </div>
    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section class="process-section" data-reveal>
    <div class="container">
      <header class="process-header">
        <h2 class="section-title">{t.homeConvert.processTitle}</h2>
        <p class="process-sub">{t.homeConvert.processSub}</p>
      </header>
      <ol class="process-timeline">
        {t.homeConvert.processSteps.map((step) => (
          <li class="process-step">
            <span class="process-step__num" aria-hidden="true">{step.num}</span>
            <div class="process-step__body">
              <h3 class="process-step__title">{step.title}</h3>
              <p class="process-step__desc">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===== CALCULATOR CTA CARD ===== -->
  <section class="calc-cta-section" data-reveal>
    <div class="container">
      <div class="calc-cta-card">
        <span class="calc-cta-icon">☀️</span>
        <div class="calc-cta-content">
          <h2>{t.homeConvert.calcCtaTitle}</h2>
          <p>{t.homeConvert.calcCtaSub}</p>
        </div>
        <div class="calc-cta-actions">
          <a href={`${base}/solar-calculator/`} class="btn btn-primary calc-cta-btn">{t.homeConvert.heroSecondary} →</a>
          <a href={`${base}/contact/`} class="text-cta calc-cta-secondary-link">{t.homeConvert.midLinkQuote}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== RESOURCE LINKS ===== -->
  <section class="home-resources" data-reveal>
    <div class="container">
      <h2 class="home-resources__heading">{t.homeConvert.resourceHeading}</h2>
      <div class="home-resources__grid">
        {t.homeConvert.resources.map((link) => (
          <a href={`${base}${link.href}`} class="home-resources__link">{link.label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LET'S CONNECT ===== -->
  <section class="connect-section" data-reveal>
    <div class="container connect-section__inner">
      <div class="connect-content">
        <h2 class="section-title connect-title">{t.homeConvert.connectTitle}</h2>
        <p>{t.homeConvert.connectSub}</p>
      </div>
      <div class="connect-form-wrap">
        <ul class="connect-trust" aria-label="Why contact Rayenna">
          {t.homeConvert.connectTrust.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <form class="connect-form" id="connect-form">
          <input type="hidden" name="subject" value="New Callback Request — Rayenna Website" />
          <input type="hidden" name="source" value="Homepage callback form" />
          <input type="text" name="name" placeholder="Your Name" required />
          <input type="tel" name="phone" placeholder="Phone Number" required />
          <input type="text" name="city" placeholder="Your City" />
          <button type="submit" class="btn btn-primary connect-submit" data-label-default={t.homeConvert.connectSubmit} data-label-sending={t.homeConvert.connectSubmitSending} data-label-done={t.homeConvert.connectSubmitDone}>{t.homeConvert.connectSubmit}</button>
          <p class="connect-form__feedback" id="connect-feedback" style="display:none"></p>
        </form>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ===== HERO ===== */
.hero {
  position: relative;
  z-index: 0;
  width: 100%;
  min-height: 92vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding-top: 72px; /* navbar height */
}

/* Full-bleed photo across the entire hero */
.hero__photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: right center;
  z-index: 0;
  transform: scale(1.04);
  animation: heroKenBurns 22s ease-in-out infinite alternate;
  will-change: transform;
}

@keyframes heroKenBurns {
  from { transform: scale(1.04) translate3d(0, 0, 0); }
  to   { transform: scale(1.12) translate3d(-1.5%, 1%, 0); }
}

@keyframes heroContentIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .hero__photo {
    animation: none;
    transform: none;
  }
  .hero__content {
    animation: none;
  }
}

/* Gradient gives readability across the wider content area */
.hero__gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(255,255,255,0.65) 0%,
    rgba(255,255,255,0.55) 35%,
    rgba(255,255,255,0.2) 55%,
    rgba(255,255,255,0) 70%
  );
  z-index: 1;
}

/* Text content sits on the left over the white area */
.hero__content {
  position: relative;
  z-index: 2;
  max-width: 620px;
  width: 52%;
  padding: 60px 0 60px 6vw;
  animation: heroContentIn 0.85s ease-out both;
}

.hero__title {
  font-family: var(--font-heading);
  font-size: clamp(2.2rem, 4.5vw, 4rem);
  font-weight: 500;
  color: #a83838;
  line-height: 1.2;
  margin-bottom: 32px;
  letter-spacing: -0.02em;
}

.hero__mid {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-bottom: 0;
}

.hero__mid-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ===== MNRE BADGE IMAGE ===== */
.mnre-badge-img {
  flex-shrink: 0;
  width: 150px;
  height: 150px;
  object-fit: contain;
}

.hero__subtitle {
  font-size: 1rem;
  color: #a83838;
  line-height: 1.75;
  flex: 1;
  min-width: 0;
}

/* ===== HERO TRUST STRIP ===== */
.hero-trust-strip {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px 8px;
  width: 100%;
}
.hero-trust-strip span {
  font-size: 0.7rem;
  font-weight: 600;
  color: #27324f;
  opacity: 0.72;
  letter-spacing: 0.2px;
  text-align: center;
  background: rgba(255,255,255,0.55);
  border: 1px solid rgba(39,50,79,0.1);
  border-radius: 99px;
  padding: 5px 10px;
  line-height: 1.2;
}

/* ===== HERO CTA WRAPPER — mobile first ===== */
.hero-cta-wrapper {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  margin-top: 32px;
}
.hero-cta-micro {
  margin: 14px 0 0;
  font-size: 0.82rem;
  font-weight: 600;
  color: #27324f;
  opacity: 0.8;
  text-align: center;
  letter-spacing: 0.2px;
}
.hero-phone-cta {
  margin: 8px 0 0;
  font-size: 0.88rem;
  color: #27324f;
  text-align: center;
}
.hero-phone-cta a {
  color: var(--color-primary);
  font-weight: 700;
  text-decoration: none;
}
.hero-phone-cta a:hover { text-decoration: underline; }
.hero-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  min-height: 52px;
  padding: 14px 28px;
  border-radius: 50px;
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all var(--transition);
  text-decoration: none;
  background: #a83838;
  color: #fff;
  border: 2px solid #a83838;
  -webkit-tap-highlight-color: transparent;
}
.hero-btn-primary:hover { background: #8a2c2c; border-color: #8a2c2c; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(168,56,56,0.35); }
.hero-btn-primary:active { opacity: 0.85; transform: none; }
.hero-btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  min-height: 52px;
  padding: 14px 28px;
  border-radius: 50px;
  font-family: var(--font-heading);
  font-weight: 500;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all var(--transition);
  text-decoration: none;
  background: transparent;
  color: #a83838;
  border: 2px solid #a83838;
  -webkit-tap-highlight-color: transparent;
}
.hero-btn-secondary:hover { background: #a83838; color: #fff; transform: translateY(-2px); }
.hero-btn-secondary:active { opacity: 0.85; transform: none; }
@media (min-width: 768px) {
  .hero-cta-wrapper { flex-direction: row; width: auto; }
  .hero-btn-primary, .hero-btn-secondary { width: auto; }
}

/* ===== WHY NOW ===== */
.why-now {
  position: relative;
  z-index: 2;
  padding: 36px 0 36px;
  background: #fff;
  border-bottom: 1px solid var(--color-border);
}
.season-note {
  position: relative;
  z-index: 1;
  display: block;
  max-width: 720px;
  margin: 0 auto 18px;
  padding: 10px 16px;
  text-align: center;
  font-size: 0.88rem;
  line-height: 1.55;
  color: var(--color-secondary);
  background: linear-gradient(90deg, rgba(168, 56, 56, 0.06), rgba(201, 162, 39, 0.12), rgba(168, 56, 56, 0.06));
  border: 1px solid rgba(201, 162, 39, 0.28);
  border-radius: 10px;
}
.why-now__title {
  text-align: center;
  max-width: 820px;
  margin: 0 auto 20px;
  text-wrap: balance;
  font-weight: 600;
  letter-spacing: -0.015em;
}
.why-now__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}
.why-now__card {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  background: var(--color-light);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 16px 18px;
}
.why-now__icon {
  flex-shrink: 0;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.82rem;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 8px;
  padding: 6px 10px;
  min-width: 44px;
  text-align: center;
}
.why-now__card p {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.65;
  color: var(--color-text);
}
@media (min-width: 640px) {
  .why-now__grid { grid-template-columns: 1fr 1fr; }
}
@media (min-width: 1400px) {
  .why-now__grid { grid-template-columns: repeat(4, 1fr); }
}

/* ===== SOLAR INTRO ===== */
.solar-intro {
  padding: var(--section-padding);
  padding-bottom: 40px;
  background: var(--color-light);
}
.solar-intro__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.solar-intro__image img {
  width: 100%;
  max-width: 528px;
  height: 420px;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  object-fit: cover;
  object-position: center 20%;
  display: block;
}
.solar-intro__content p {
  color: var(--color-text-muted);
  line-height: 1.9;
  font-size: 1rem;
  margin-bottom: 20px;
}
.solar-intro__content .section-title {
  margin-bottom: 20px;
}
.solar-intro__bullets {
  list-style: none;
  padding: 0;
  margin: 0 0 28px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.solar-intro__bullets li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 0.93rem;
  color: var(--color-text);
  line-height: 1.6;
}
.bullet-icon {
  font-size: 1.1rem;
  line-height: 1.5;
  flex-shrink: 0;
}
.solar-intro__actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 8px;
}
.text-cta {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-body);
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--color-primary);
  text-decoration: none;
  min-height: 44px;
  -webkit-tap-highlight-color: transparent;
}
.text-cta:hover { text-decoration: underline; }
.text-cta--muted {
  color: var(--color-navy);
  font-weight: 600;
  opacity: 0.85;
}
@media (min-width: 640px) {
  .solar-intro__actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
}

/* ===== WHO WE ARE ===== */
.who-we-are {
  padding: var(--section-padding);
  padding-top: 40px;
  background: var(--color-light);
}
.who-we-are__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.who-we-are__content .section-title {
  margin-bottom: 20px;
}
.who-we-are__content p {
  color: var(--color-text-muted);
  line-height: 1.9;
  margin-bottom: 20px;
}
.who-points {
  list-style: none;
  margin: 0 0 24px;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.who-points li {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-left: 14px;
  border-left: 3px solid var(--color-primary);
}
.who-points strong {
  font-family: var(--font-heading);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--color-secondary);
}
.who-points span {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  line-height: 1.65;
}
.who-stats-link {
  margin-top: 8px;
  text-align: center;
}

.who-we-are__stats {
  display: flex;
  flex-direction: column;
  gap: 40px;
  align-items: center;
}
.stat-item { text-align: center; }
.stat-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2px;
}
.stat-number {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(3rem, 5vw, 5rem);
  font-weight: 600;
  color: #2a2a2a;
  line-height: 1;
}
.stat-suffix {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(1.5rem, 2.5vw, 2.5rem);
  font-weight: 500;
  color: #2a2a2a;
}
.stat-label {
  font-family: var(--font-heading);
  font-size: clamp(0.7rem, 2.5vw, 0.85rem);
  font-weight: 600;
  color: var(--color-text-muted);
  margin-top: 8px;
  text-transform: uppercase;
  letter-spacing: 2px;
}

/* Stats link uses who-stats-link */

/* ===== INVEST IN SOLAR ===== */
.invest-section {
  position: relative;
  min-height: 520px;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.invest-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 0;
}
.invest-overlay {
  position: absolute;
  inset: 0;
  background: rgba(10, 20, 45, 0.45);
  z-index: 1;
}
.invest-inner {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  padding-top: 72px;
  padding-bottom: 72px;
}
.invest-left {
  padding-right: 24px;
}
.invest-title {
  font-family: var(--font-heading);
  font-size: clamp(1.8rem, 3.5vw, 3rem);
  font-weight: 400;
  color: #ffffff;
  line-height: 1.25;
}
.invest-urgency {
  font-style: normal;
  font-weight: 600;
  white-space: nowrap;
  display: inline-block;
  text-decoration: none;
  line-height: 1.15;
  padding-bottom: 0.06em;
  border-bottom: 0.11em solid #f59e0b;
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
}
.invest-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.invest-card {
  background: rgba(20, 35, 75, 0.65);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-md);
  padding: 28px 24px;
}
.invest-card h3 {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1.05rem;
  color: #ffffff;
  margin-bottom: 10px;
  line-height: 1.3;
}
.invest-card p {
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.7;
}

/* ===== RAYENNA WAY ===== */
.rayenna-way {
  padding: var(--section-padding);
  background: var(--color-white);
}
.rayenna-way__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.rayenna-way__image img {
  width: 100%;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
  object-fit: cover;
}
.rayenna-way__content .section-title { margin-bottom: 16px; }
.rayenna-way__lead {
  color: var(--color-text-muted);
  line-height: 1.85;
  margin-bottom: 28px;
  font-size: 1.02rem;
}
.way-points {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.way-points li {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 16px 18px;
  background: var(--color-light);
  border-radius: var(--radius-md);
  border-top: 3px solid var(--color-primary);
}
.way-points strong {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-secondary);
}
.way-points span {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  line-height: 1.7;
}

/* ===== PROCESS (timeline) ===== */
.process-section {
  padding: var(--section-padding);
  background: var(--color-light);
}
.process-header {
  max-width: 640px;
  margin: 0 auto 40px;
  text-align: left;
}
.process-header .section-title {
  margin-bottom: 10px;
}
.process-sub {
  color: var(--color-text-muted);
  line-height: 1.7;
  font-size: 1rem;
}
.process-timeline {
  list-style: none;
  margin: 0 auto;
  padding: 0;
  max-width: 720px;
  display: flex;
  flex-direction: column;
  gap: 0;
  position: relative;
}
.process-step {
  display: grid;
  grid-template-columns: 52px 1fr;
  gap: 16px;
  align-items: start;
  position: relative;
  padding-bottom: 28px;
}
.process-step:last-child {
  padding-bottom: 0;
}
.process-step:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 25px;
  top: 44px;
  bottom: 0;
  width: 2px;
  background: rgba(168, 56, 56, 0.22);
}
.process-step__num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: 0.85rem;
  letter-spacing: 0.02em;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.process-step__title {
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--color-secondary);
  margin: 6px 0 8px;
  font-size: 1.08rem;
}
.process-step__desc {
  font-size: 0.92rem;
  color: var(--color-text-muted);
  line-height: 1.7;
  margin: 0;
}

/* ===== FEATURED BILL STORY ===== */
.bill-story {
  padding: var(--section-padding);
  background: #fff;
}
.bill-story__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: center;
}
.bill-story__media img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}
.bill-story__eyebrow {
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-primary);
  margin-bottom: 10px;
}
.bill-story__content .section-title {
  margin-bottom: 8px;
  font-weight: 600;
  letter-spacing: -0.015em;
}
.bill-story__meta {
  color: var(--color-text-muted);
  font-size: 0.92rem;
  margin-bottom: 22px;
}
.bill-story__compare {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  margin-bottom: 22px;
}
.bill-story__col {
  padding: 16px 18px;
  border-radius: var(--radius-md);
}
.bill-story__col--before {
  background: var(--color-light);
  border-left: 3px solid var(--color-text-muted);
}
.bill-story__col--after {
  background: var(--color-primary-light);
  border-left: 3px solid var(--color-primary);
}
.bill-story__label {
  display: block;
  font-family: var(--font-heading);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 6px;
  color: var(--color-secondary);
}
.bill-story__col p {
  margin: 0;
  font-size: 0.95rem;
  line-height: 1.65;
  color: var(--color-text);
}
.bill-story__quote {
  margin: 0 0 20px;
  padding: 0;
  border: none;
  font-size: 1.02rem;
  line-height: 1.7;
  color: var(--color-text-muted);
  font-style: italic;
}
@media (min-width: 768px) {
  .bill-story__inner {
    grid-template-columns: 1.05fr 1fr;
    gap: 48px;
  }
  .bill-story__compare {
    grid-template-columns: 1fr 1fr;
  }
}

/* ===== TESTIMONIALS ===== */
.testimonials-section {
  padding: var(--section-padding);
  background: #ffffff;
}
.testimonials-header {
  text-align: center;
  margin-bottom: 48px;
}
.testimonials-intro {
  color: var(--color-text-muted);
  max-width: 580px;
  margin: 12px auto 0;
  line-height: 1.8;
  font-size: 0.95rem;
}
.testimonials-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}
.tcard {
  background: var(--color-light);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  border-left: 4px solid var(--color-primary);
  display: flex;
  flex-direction: column;
  gap: 16px;
  transition: box-shadow var(--transition), transform var(--transition);
}
.tcard:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}
.tcard__stars {
  color: #f59e0b;
  font-size: 1rem;
  letter-spacing: 2px;
}
.tcard__quote {
  color: var(--color-text);
  font-size: 0.93rem;
  line-height: 1.85;
  font-style: italic;
  flex: 1;
}
.tcard__quote::before { content: '\201C'; }
.tcard__quote::after  { content: '\201D'; }
.tcard__author {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid var(--color-border);
}
.tcard__avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--color-secondary);
  color: #fff;
  font-family: var(--font-heading);
  font-size: 0.8rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  letter-spacing: 1px;
}
.tcard__author strong {
  display: block;
  font-family: var(--font-heading);
  font-size: 0.9rem;
  color: var(--color-navy);
  margin-bottom: 2px;
}
.tcard__author span {
  font-size: 0.75rem;
  color: var(--color-text-muted);
}
.testimonials-footer {
  display: flex;
  justify-content: center;
  margin-top: 28px;
}
.connect-trust {
  list-style: none;
  margin: 0 0 20px;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.connect-trust li {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.88);
  padding-left: 1.35rem;
  position: relative;
  line-height: 1.5;
}
.connect-trust li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: #7dd3a8;
  font-weight: 700;
}
@media (min-width: 640px) {
  .testimonials-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
  .testimonials-grid .tcard:last-child { grid-column: 1 / -1; max-width: calc(50% - 12px); margin-inline: auto; }
}
@media (min-width: 960px) {
  .testimonials-grid { grid-template-columns: repeat(3, 1fr); }
  .testimonials-grid .tcard:last-child { grid-column: auto; max-width: none; margin-inline: 0; }
}

/* ===== INSTALLATIONS PREVIEW ===== */
.installs-preview {
  padding: var(--section-padding);
  background: var(--color-light);
}
.installs-preview__header {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 24px;
}
.installs-preview__sub {
  color: var(--color-text-muted);
  font-size: 0.92rem;
  line-height: 1.7;
  margin-top: 8px;
}
.installs-view-all { display: none; }
.installs-grid {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  margin-inline: -24px;
  padding: 4px 24px 12px;
}
.installs-grid::-webkit-scrollbar { display: none; }
.install-card {
  position: relative;
  display: block;
  flex: 0 0 min(78vw, 280px);
  scroll-snap-align: start;
  border-radius: var(--radius-md);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: #e2e8f0;
  text-decoration: none;
}
.install-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
@media (hover: hover) and (pointer: fine) {
  .install-card:hover img { transform: scale(1.04); }
}
.install-card__overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: linear-gradient(to top, rgba(10,25,50,0.88) 0%, rgba(10,25,50,0.25) 70%, transparent 100%);
  padding: 28px 14px 14px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  opacity: 1;
  transform: none;
}
.install-card__overlay strong {
  color: #fff;
  font-family: var(--font-heading);
  font-size: 0.88rem;
  font-weight: 600;
}
.install-card__overlay span {
  color: rgba(255,255,255,0.78);
  font-size: 0.75rem;
}
.installs-proof {
  margin: 20px 0 0;
  padding: 16px 18px;
  background: #fff;
  border-radius: var(--radius-md);
  border-left: 3px solid var(--color-primary);
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.installs-proof__quote {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.65;
  color: var(--color-navy);
  font-style: italic;
}
.installs-mobile-cta {
  text-align: center;
  margin-top: 16px;
}
@media (min-width: 640px) {
  .installs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    overflow: visible;
    margin-inline: 0;
    padding: 0;
    scroll-snap-type: none;
  }
  .install-card {
    flex: none;
    width: auto;
  }
  .installs-mobile-cta { display: none; }
  .installs-view-all { display: inline-flex; align-self: flex-end; }
  .installs-preview__header { flex-direction: row; align-items: flex-end; justify-content: space-between; }
  .installs-proof {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
}

/* ===== CALCULATOR CTA CARD — brand + calc gold bridge ===== */
.calc-cta-section { padding: 48px 0; background: #fff; }
.calc-cta-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 20px;
  background: linear-gradient(135deg, #0a1929 0%, #132743 55%, #1a3358 100%);
  border: 1px solid rgba(201, 162, 39, 0.35);
  border-left: 4px solid #c9a227;
  border-radius: 16px;
  padding: 32px 28px;
  box-shadow: 0 12px 36px rgba(10, 25, 41, 0.18);
}
.calc-cta-icon { font-size: 2.8rem; line-height: 1; filter: drop-shadow(0 0 8px rgba(201, 162, 39, 0.35)); }
.calc-cta-content h2 {
  font-family: var(--font-heading);
  font-size: clamp(1.2rem, 2.5vw, 1.55rem);
  font-weight: 600;
  color: #fff;
  margin-bottom: 8px;
  line-height: 1.3;
}
.calc-cta-content { min-width: 0; }
.calc-cta-content p { font-size: 0.92rem; color: rgba(255, 255, 255, 0.78); line-height: 1.7; margin: 0; }
.calc-cta-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
}
.calc-cta-btn {
  align-self: stretch;
  width: 100%;
  max-width: 100%;
  white-space: normal;
  text-align: center;
  justify-content: center;
  line-height: 1.4;
}
.calc-cta-secondary-link {
  align-self: center;
  color: #e8d48a;
}
.calc-cta-secondary-link:hover {
  color: #fff;
}
@media (min-width: 768px) {
  .calc-cta-card {
    flex-direction: row;
    align-items: center;
    gap: 28px;
  }
  .calc-cta-content { flex: 1; }
  .calc-cta-actions {
    width: auto;
    flex-shrink: 0;
    align-items: stretch;
  }
  .calc-cta-btn {
    width: auto;
    white-space: nowrap;
  }
  .calc-cta-secondary-link {
    align-self: center;
    text-align: center;
  }
}

/* ===== RESOURCE LINKS ===== */

/* ===== HOME RESOURCES ===== */
.home-resources {
  padding: 40px 0 48px;
  background: var(--color-light);
}
.home-resources__heading {
  font-family: var(--font-heading);
  font-size: clamp(1.1rem, 2.5vw, 1.4rem);
  font-weight: 600;
  color: var(--color-navy);
  margin-bottom: 18px;
  text-align: center;
}
.home-resources__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
}
.home-resources__link {
  display: inline-flex;
  align-items: center;
  padding: 10px 18px;
  border-radius: 99px;
  border: 1px solid var(--color-border);
  background: #fff;
  color: var(--color-navy);
  font-family: var(--font-heading);
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
}
.home-resources__link:hover {
  border-color: rgba(168,56,56,0.35);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* ===== LET'S CONNECT ===== */
.connect-section {
  padding: var(--section-padding);
  background: var(--color-secondary);
}
.connect-section__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.connect-title {
  color: var(--color-white) !important;
  margin-bottom: 20px;
}
.connect-content p {
