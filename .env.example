# Google Analytics 4 (optional locally — production uses G-NZFBSQXGEF in CI)
PUBLIC_GA_MEASUREMENT_ID=G-NZFBSQXGEF

# Solar news ticker (optional — Cloudflare Worker URL from worker/news-ticker.js)
# Without this, the blog ticker shows curated fallback headlines.
# PUBLIC_NEWS_TICKER_URL=https://rayenna-news-ticker.YOUR_SUBDOMAIN.workers.dev
